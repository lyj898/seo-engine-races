---
import { urls } from '../lib/urls.js';
import { resolveRegistrationState, REGISTRATION_STATE_LABELS } from '../lib/text.js';
import { matchedCategoryIds } from '../lib/categoryMatch.js';
import DateBadge from './DateBadge.astro';
import ValuePills from './ValuePills.astro';
import Pill from './Pill.astro';

// THE card for an entity in any list -- hub grids, listicle pages,
// RelatedEntities and the home page calendar all render this one
// component. It used to show only name + description + tags while the
// calendar kept its own richer card inline in index.astro, so the same
// race looked like a different kind of thing depending on which page you
// reached it from.
//
// The layout adapts to the DATA, not to the calling page: an entity
// carrying a core_facts.date gets the calendar treatment (date badge,
// location line, value pills), and one without falls back to the
// description-led card. That keeps the component generic -- a vertical
// whose entities aren't date-anchored still gets a sensible card without
// the caller passing any flags.
//
// `categories` is optional and only used to label value pills; `extraAttrs`
// lets a page attach its own filter data-attributes (the calendar's
// data-country / data-month / data-distances) without this component
// knowing what they mean.
const { entity, categories = [], extraAttrs = {} } = Astro.props;

const facts = entity.core_facts ?? {};
const hasDate = typeof facts.date === 'string';
const locationLine = [facts.city, facts.country].filter(Boolean).join(', ');
// Reads the deadline and race date, not just the status string -- a race
// whose entries shut in June must not still show "Open" in August.
const availability = resolveRegistrationState(facts);

// FilterBar filters on this attribute. Deliberately includes every category
// this entity belongs to and its region_id alongside content tags, so a hub
// page can filter by category or region reliably without depending on those
// words happening to also appear in entity.tags.
//
// Every matched category, not just the marquee one: the card already shows a
// 10K pill for a marathon that offers a 10K leg (ValuePills reads the same
// union), so a "10K" chip that then hid that card was filtering by a
// different definition of 10K than the card was displaying.
const filterTags = [...(entity.tags ?? []), ...matchedCategoryIds(entity, categories), entity.region_id]
  .filter(Boolean)
  .join(',');

// SearchBox and the calendar's combined filter script both match on this.
const searchText = `${entity.name} ${locationLine} ${entity.short_description ?? ''}`.toLowerCase();
---

<div
  data-filterable
  data-tags={filterTags}
  data-search={searchText}
  {...extraAttrs}
  class="flex gap-4 rounded-lg border border-brand-border bg-brand-surface p-4 shadow-sm transition-colors duration-200 ease-interactive hover:border-brand-faint dark:border-brand-border-dark dark:bg-brand-surface-dark dark:hover:border-brand-faint-dark"
>
  {hasDate && <DateBadge date={facts.date} />}

  <div class="min-w-0 flex-1">
    <a href={urls.entity(entity.slug)} class="font-semibold hover:underline">{entity.name}</a>

    {locationLine && <p class="mt-0.5 text-sm text-brand-muted dark:text-brand-muted-dark">{locationLine}</p>}

    {!hasDate && entity.short_description && (
      <p class="mt-1 line-clamp-2 text-sm text-brand-muted dark:text-brand-muted-dark">{entity.short_description}</p>
    )}

    {facts.distance_km?.length > 0 ? (
      <ValuePills class="mt-3" values={facts.distance_km} categories={categories} unit="km" matchedOnly />
    ) : (
      entity.tags?.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {entity.tags.slice(0, 3).map((tag) => <Pill>{tag}</Pill>)}
        </div>
      )
    )}

    <div class="mt-3 flex items-center justify-between gap-3">
      {availability && (
        <span class="text-xs font-semibold uppercase tracking-wide text-brand-muted dark:text-brand-muted-dark">
          {REGISTRATION_STATE_LABELS[availability]}
        </span>
      )}
      <a href={urls.entity(entity.slug)} class="ml-auto shrink-0 text-sm font-bold link-accent">Details &rarr;</a>
    </div>
  </div>
</div>
