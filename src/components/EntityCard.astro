---
import { urls } from '../lib/urls.js';
import ReliabilityBadge from './ReliabilityBadge.astro';
import Pill from './Pill.astro';

// entity: a summary shape { slug, name, short_description, reliability_score, tags }
// Used in hub grids, listicle pages, and RelatedEntities -- one card
// component for every vertical, since none of these fields are
// vertical-specific.
const { entity } = Astro.props;

// FilterBar filters on this attribute. Deliberately includes category_id
// and region_id alongside content tags, so a hub page can filter by
// category or region reliably without depending on those words happening
// to also appear in entity.tags.
const filterTags = [...(entity.tags ?? []), entity.category_id, entity.region_id].filter(Boolean).join(',');

// SearchBox.astro filters on this attribute (free-text substring match).
const searchText = `${entity.name} ${entity.short_description}`.toLowerCase();
---

<a
  href={urls.entity(entity.slug)}
  data-filterable
  data-tags={filterTags}
  data-search={searchText}
  class="block rounded-lg border border-brand-border bg-brand-surface p-5 shadow-sm transition-all duration-200 ease-interactive hover:-translate-y-1 hover:border-brand-faint hover:shadow-md dark:border-brand-border-dark dark:bg-brand-surface-dark dark:hover:border-brand-faint-dark"
>
  <div class="mb-2 flex items-start justify-between gap-3">
    <h3 class="font-semibold">{entity.name}</h3>
    <ReliabilityBadge score={entity.reliability_score} />
  </div>
  <p class="line-clamp-2 text-sm text-brand-muted dark:text-brand-muted-dark">{entity.short_description}</p>
  {entity.tags?.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {entity.tags.slice(0, 3).map((tag) => <Pill>{tag}</Pill>)}
    </div>
  )}
</a>
