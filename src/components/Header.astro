---
import siteConfig from '../lib/config.js';
import { urls } from '../lib/urls.js';
import Logo from './Logo.astro';
import ContactButton from './ContactButton.astro';
import ThemeToggle from './ThemeToggle.astro';

// One nav definition, rendered twice (desktop inline row, mobile scroll
// row) so the two can never drift apart.
const navLinks = [
  { href: urls.categoriesIndex(), label: siteConfig.categoryLabelPlural ?? `${siteConfig.categoryLabel}s` },
  { href: urls.regionsIndex(), label: siteConfig.regionLabelPlural ?? `${siteConfig.regionLabel}s` },
  ...(siteConfig.enabledFeatures?.listicles ? [{ href: urls.listiclesIndex(), label: 'Best Of' }] : []),
  { href: urls.about(), label: 'About' },
];
---

<header
  class="sticky top-0 z-40 border-b border-brand-divider bg-brand-bg/90 backdrop-blur-md dark:border-brand-divider-dark dark:bg-brand-bg-dark/90"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-3.5">
    <a
      href={urls.home()}
      class="flex shrink-0 items-center gap-2.5 font-serif text-[1.15rem] font-extrabold leading-none tracking-tight"
    >
      <Logo size={30} class="shrink-0" />
      {siteConfig.siteName}
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium md:flex" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:underline underline-offset-4">{link.label}</a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <ContactButton />
      <ThemeToggle />
    </div>
  </div>

  <!--
    Mobile nav. The desktop row is `hidden md:flex`, which previously left
    phones with no way to reach Categories / Regions / Best Of / About at
    all. This second row carries the same links below the md breakpoint as a
    horizontally scrollable strip -- no hamburger, no JS, and the links stay
    in the markup for crawlers on every page.
  -->
  <nav
    class="-mt-px flex gap-1 overflow-x-auto border-t border-brand-divider px-4 py-2 text-sm font-semibold [scrollbar-width:none] [&::-webkit-scrollbar]:hidden dark:border-brand-divider-dark md:hidden"
    aria-label="Primary (mobile)"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="shrink-0 whitespace-nowrap rounded-full px-3 py-1.5 text-brand-muted transition-colors hover:bg-brand-surface-offset hover:text-brand-text dark:text-brand-muted-dark dark:hover:bg-brand-surface-offset-dark dark:hover:text-brand-text-dark"
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>
