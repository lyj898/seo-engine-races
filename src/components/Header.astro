---
import siteConfig from '../lib/config.js';
import { urls } from '../lib/urls.js';
import { headerLinks } from '../lib/nav.js';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

// One nav definition, rendered twice here (desktop inline row, mobile scroll
// row) so the two can never drift apart -- and shared with the footer via
// src/lib/nav.js so THOSE two can't drift either, which is how "Reviews"
// ended up in the top nav and nowhere else.
const navLinks = headerLinks();
---

<header
  class="sticky top-0 z-40 border-b border-brand-divider bg-brand-bg/90 backdrop-blur-md dark:border-brand-divider-dark dark:bg-brand-bg-dark/90"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-3.5">
    <a
      href={urls.home()}
      class="flex shrink-0 items-center gap-2.5 font-serif text-[1.15rem] font-extrabold leading-none tracking-tight"
    >
      <Logo size={30} class="shrink-0" />
      {siteConfig.siteName}
    </a>

    <nav class="hidden min-w-0 items-center gap-5 text-sm font-medium lg:flex" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:underline underline-offset-4">{link.label}</a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      {/* Instagram in the top right (Alex, Nov 2026), where the contact (mail)
          button used to be; Contact stays in the footer and at /contact/. */}
      {siteConfig.instagramUrl && (
        <a
          href={siteConfig.instagramUrl}
          target="_blank"
          rel="me noopener"
          aria-label="Run SEA on Instagram"
          title="@runsea.run on Instagram"
          class="flex h-[38px] w-[38px] items-center justify-center rounded-full border border-brand-border transition-colors duration-200 ease-interactive hover:bg-brand-surface-offset dark:border-brand-border-dark dark:hover:bg-brand-surface-offset-dark"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
          </svg>
        </a>
      )}
      <ThemeToggle />
    </div>
  </div>

  <!--
    Mobile/tablet nav. The desktop row is `hidden lg:flex`, which previously
    left phones with no way to reach Categories / Regions / Recommends /
    About at all. This second row carries the same links below the lg
    breakpoint as a horizontally scrollable strip -- no hamburger, no JS, and
    the links stay in the markup for crawlers on every page.

    lg, not md: at exactly 768px the inline row (logo + eight links + the
    contact and theme buttons) was 22px wider than the viewport, so every
    page on the site scrolled sideways at that one width. The scrollable
    strip is already the right answer for a row that can't fit -- it just
    needed to take over before the row ran out of room rather than after.

    The links overflow the viewport by design (5-6 labels never fit on a
    phone), so a right-edge fade signals "there's more -- scroll" instead of
    the row just looking cut off. `pr-8` keeps the last link from sitting
    under the fade at full scroll.
  -->
  <div class="relative lg:hidden">
    <nav
      class="-mt-px flex gap-1 overflow-x-auto border-t border-brand-divider py-2 pl-4 pr-8 text-sm font-semibold [scrollbar-width:none] [&::-webkit-scrollbar]:hidden dark:border-brand-divider-dark"
      aria-label="Primary (mobile)"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="shrink-0 whitespace-nowrap rounded-full px-3 py-1.5 text-brand-muted transition-colors hover:bg-brand-surface-offset hover:text-brand-text dark:text-brand-muted-dark dark:hover:bg-brand-surface-offset-dark dark:hover:text-brand-text-dark"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-brand-bg to-transparent dark:from-brand-bg-dark"
      aria-hidden="true"
    >
    </div>
  </div>
</header>
