// In route order; label offsets keep names off the route and each other.
const cities = [
  { name: 'Yangon', x: 74, y: 91, lx: 20, ly: 72 },
  { name: 'Bangkok', x: 151, y: 144, lx: 164, ly: 150 },
  { name: 'Vientiane', x: 188, y: 70, lx: 200, ly: 66 },
  { name: 'Hanoi', x: 246, y: 17, lx: 260, ly: 24 },
  { name: 'Phnom Penh', x: 230, y: 183, lx: 138, ly: 200 },
  { name: 'Ho Chi Minh City', x: 260, y: 196, lx: 274, ly: 214 },
  { name: 'Kuala Lumpur', x: 172, y: 330, lx: 52, ly: 326 },
  { name: 'Singapore', x: 210, y: 361, lx: 224, ly: 380 },
  { name: 'Jakarta', x: 264, y: 494, lx: 278, ly: 482 },
  { name: 'Bandar Seri Begawan', x: 408, y: 299, lx: 350, ly: 284 },
  { name: 'Manila', x: 515, y: 130, lx: 530, ly: 128 },
];
const route = cities.map((c) => `${c.x},${c.y}`).join(' ');
---

<figure class="m-0 rounded-[22px] border border-brand-border bg-brand-surface p-2.5 dark:border-brand-border-dark dark:bg-brand-surface-dark">
  <svg
    viewBox="0 0 640 560"
    role="img"
    aria-label="Map of Southeast Asia with a running route linking Yangon, Bangkok, Vientiane, Hanoi, Phnom Penh, Ho Chi Minh City, Kuala Lumpur, Singapore, Jakarta, Bandar Seri Begawan and Manila"
    class="block h-auto w-full rounded-[14px] bg-brand-surface-offset dark:bg-brand-surface-offset-dark"
  >
    <g class="fill-brand-surface stroke-brand-border dark:fill-brand-surface-dark dark:stroke-brand-border-dark" stroke-width="1.2" stroke-linejoin="round">
      {land.map((d) => <path d={d} />)}
    </g>
    <polyline
      points={route}
      fill="none"
      class="stroke-brand-text dark:stroke-brand-text-dark"
      stroke-width="3"
      stroke-dasharray="2 9"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <g class="fill-brand-primary" stroke="#15170f" stroke-width="2.5">
      {cities.map((c) => <circle cx={c.x} cy={c.y} r="8" />)}
    </g>
    <g
      class="fill-brand-text stroke-brand-surface-offset dark:fill-brand-text-dark dark:stroke-brand-surface-offset-dark"
      font-size="16"
      font-weight="800"
      stroke-width="5"
      paint-order="stroke"
      stroke-linejoin="round"
      style="font-family: inherit"
    >
      {cities.map((c) => <text x={c.lx} y={c.ly}>{c.name}</text>)}
    </g>
  </svg>
</figure>
