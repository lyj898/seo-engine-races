---
// Generic card for anything that's just "a link to a hub/section with a
// label + description + optional count" -- categories, regions, and
// listicles on the home page and on each other's index pages. Keeps
// CategoryCard/RegionCard/ListicleCard from being three near-duplicate
// components.
const { href, label, description, count } = Astro.props;
---

<a
  href={href}
  class="block rounded-lg border border-brand-border bg-brand-surface p-5 shadow-sm transition-all duration-200 ease-interactive hover:-translate-y-1 hover:border-brand-faint hover:shadow-md dark:border-brand-border-dark dark:bg-brand-surface-dark dark:hover:border-brand-faint-dark"
>
  <div class="flex items-center justify-between gap-3">
    <h3 class="font-semibold">{label}</h3>
    {typeof count === 'number' && <span class="text-xs text-brand-muted dark:text-brand-muted-dark">{count}</span>}
  </div>
  {description && <p class="mt-1 line-clamp-2 text-sm text-brand-muted dark:text-brand-muted-dark">{description}</p>}
</a>
