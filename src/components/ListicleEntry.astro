---
import siteConfig from '../lib/config.js';
import { urls } from '../lib/urls.js';
import { withoutRegistrationClaims } from '../lib/text.js';
import DateBadge from './DateBadge.astro';
import ValuePills from './ValuePills.astro';

// A rich entry for "Recommends" guide pages -- the editorial counterpart to the
// bare EntityCard. Where EntityCard answers "what is this", this answers
// "why is it on the list": it leads with a concrete reason drawn from the
// entity's own research (a standout pro, or the summary), shows the runner
// sentiment score when we have one, and links straight to the full review
// when one exists. Everything is pulled from data already on the entity, so a
// guide's entries stay current with the directory and never need hand-editing.
//
// Props:
//   entity       - the entity to render
//   categories   - for ValuePills labelling (optional)
//   hasReview    - true if a published review exists at /reviews/<slug>
//   reviewRating - that review's own rating.overall, when hasReview is true
//   rank         - 1-based position, shown as an index (not a quality ranking)
//   showScore    - whether the score badge may be rendered at all. The guide
//                  page decides this via src/lib/ratings.js: a score
//                  captioned "from reviews we found" needs a review to have
//                  been found. Ranking still uses the score either way.
const { entity: rawEntity, categories = [], hasReview = false, reviewRating, rank, showScore = false } = Astro.props;

// Same scrub as EntityCard, for the same reason: this component picks its
// "why it's here" line straight out of the entity's pros and summary, which
// is where the registration-status claims live. See
// withoutRegistrationClaims in src/lib/text.js.
const entity = withoutRegistrationClaims(rawEntity);

const merged = siteConfig.enabledFeatures?.mergedReviews;

const facts = entity.core_facts ?? {};
const hasDate = typeof facts.date === 'string';
const locationLine = [facts.city, facts.country].filter(Boolean).join(', ');
// The badge is titled "from reviews we found" -- so when an in-depth review
// exists, its own verdict is the score shown, not the separate research-time
// estimate on the entity (the two are gathered independently and can drift).
const rawOverall = typeof reviewRating === 'number' ? reviewRating : entity.sentiment_scores?.overall;
const overall = showScore ? rawOverall : undefined;

// The one-line "why it's here". Prefer a pro that actually says something
// distinctive -- skip the boilerplate the summaries stage repeats across most
// races ("multiple distance options", "registration is open") which would
// otherwise make every entry read identically. Fall back to the summary's
// first sentence, then the short description.
// Skip both interchangeable boilerplate AND machinery-exposing pros: a blurb
// like "highest confidence score verified in this directory" breaks the
// reader illusion the rest of the site is careful to keep.
const FILLER = /multiple distance options|registration is (currently )?open|time to prepare|accommodate|suit different|various distance|confidence score|verified|reliabilit|this directory/i;
const firstSentence = (s) => (typeof s === 'string' && s.trim() ? s.match(/^[^.]*\.?/)[0].trim() : '');
const pros = Array.isArray(entity.pros) ? entity.pros : [];
const why = pros.find((p) => !FILLER.test(p)) || firstSentence(entity.ai_summary) || entity.short_description || pros[0] || '';
---

<div class="rounded-xl border border-brand-border bg-brand-surface p-5 shadow-sm transition-colors duration-200 ease-interactive hover:border-brand-faint dark:border-brand-border-dark dark:bg-brand-surface-dark dark:hover:border-brand-faint-dark">
  <div class="flex gap-4">
    {hasDate && <DateBadge date={facts.date} />}

    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          {typeof rank === 'number' && (
            <span class="mr-1.5 text-sm font-bold text-brand-faint dark:text-brand-faint-dark">{rank}.</span>
          )}
          <a href={urls.entity(entity.slug)} class="font-serif text-lg font-semibold leading-tight hover:underline">
            {entity.name}
          </a>
          {locationLine && <p class="mt-0.5 text-sm text-brand-muted dark:text-brand-muted-dark">{locationLine}</p>}
        </div>
        {typeof overall === 'number' && (
          <span
            class="flex shrink-0 items-baseline gap-1 rounded-full bg-brand-primary px-2.5 py-1 text-brand-primary-ink dark:text-brand-primary-ink-dark"
            title="Runner sentiment score, from reviews we found"
          >
            <span class="text-sm font-extrabold tabular-nums">{overall}</span>
            <span class="text-[0.65rem] font-semibold uppercase tracking-wide opacity-80">score</span>
          </span>
        )}
      </div>

      {why && <p class="mt-2.5 text-sm leading-relaxed">{why}</p>}

      {facts.distance_km?.length > 0 && (
        <ValuePills class="mt-3" values={facts.distance_km} categories={categories} unit="km" matchedOnly />
      )}

      {/* Price only: registration status is no longer published anywhere on
          the site -- see withoutRegistrationClaims in src/lib/text.js. The
          row is conditional so an entry without a price doesn't render an
          empty strip of margin. */}
      {facts.price_range && (
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-brand-muted dark:text-brand-muted-dark">
          <span>{facts.price_range}</span>
        </div>
      )}

      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {/* Merged builds put the review and the facts on one URL, so the two
            links below would point at the same place -- collapse them into
            one rather than showing the reader a duplicate. */}
        {hasReview && !merged && (
          <a href={urls.review(entity.slug)} class="font-bold link-accent">Read the full review →</a>
        )}
        <a href={urls.entity(entity.slug)} class={hasReview && merged ? 'font-bold link-accent' : 'link-accent'}>
          {hasReview && merged ? 'Read the full review →' : 'Details & registration →'}
        </a>
      </div>
    </div>
  </div>
</div>
