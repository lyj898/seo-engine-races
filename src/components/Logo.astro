---
// Inline brand mark: a ring in the current text color + a lime "pulse
// line" always in the brand primary color, exactly matching the reference
// design system (Races/design.html / logo-mark-*.svg). Scales to any size
// via the `size` prop; inherits `currentColor` for the ring so it adapts
// to light/dark automatically without a separate light/dark asset.
const { size = 30, class: className = '' } = Astro.props;
---

<svg viewBox="0 0 32 32" width={size} height={size} fill="none" aria-hidden="true" class={className}>
  <circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="2" />
  <path
    d="M9 21 L14 13 L18 17 L23 9"
    class="stroke-brand-primary"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  />
</svg>
