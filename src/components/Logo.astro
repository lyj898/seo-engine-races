---
// Brand mark, matching the Instagram profile logo (Alex, Nov 2026: "ig one
// should be the standard"): a lime disc carrying a near-black pulse line.
// Fixed colours, not currentColor, so the mark looks the same in light and
// dark mode (the old inverted mark turned into a light disc at night). The
// lime disc already contrasts with both the light and the dark page
// background, so no separate night artwork is needed.
const { size = 30, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
  class={className}
>
  <circle cx="16" cy="16" r="16" fill="#c8ff33" />
  <path
    d="M8.4 20.9 L13.4 12.6 L18 17.2 L23.7 8.7"
    stroke="#15170f"
    stroke-width="3.3"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  />
</svg>
