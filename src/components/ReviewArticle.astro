---
// Renders a review article's body: prose sections whose inline [n] markers
// are turned into links to a numbered references list at the end, and whose
// first mention of a race with its own review page is turned into a link to
// that review.
//
// SAFETY: stored paragraph text is treated as plain text. We HTML-escape it
// first, then the ONLY markup we add is our own <sup><a> citation links, the
// reference anchors, and (see raceLinks below) plain <a> race-name links --
// all built from data this component controls, never from raw paragraph
// text. Data can never inject arbitrary HTML this way, which is the same
// guard ExcerptQuotes relies on -- no raw scraped markup renders.
//
// Props:
//   sections:   [{ heading, paragraphs: [string with optional [n] markers] }]
//   sources:    [{ n, label, publisher?, url, type? }]
//   raceLinks:  [{ name, reviewSlug, entitySlug, entityHasPage }] -- from src/lib/data.js's
//               buildRaceLinkTargets(). Each distinct name is linked at most
//               once across the whole article (its first mention only) so a
//               race repeated through the piece doesn't turn into a wall of
//               identical links.
//   urls:       the site's urls helper (passed in rather than imported, so
//               this component doesn't need to know the review path shape).
//   linkToEntity: point race mentions at the entity page rather than the
//               standalone review. True when enabledFeatures.mergedReviews
//               has folded review bodies into entity pages, so autolinks
//               resolve to the real page instead of a redirect stub.
//   currentReviewSlug: when this article IS a review, its own slug -- pass
//               this so a review never links its own race name back to
//               itself.
const {
  sections = [],
  sources = [],
  raceLinks = [],
  urls,
  linkToEntity = false,
  currentReviewSlug = null,
} = Astro.props;

const escapeHtml = (s) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');

const byNumber = new Map(sources.map((s) => [s.n, s]));

// Longest name first, so a more specific mention (e.g. the full race name)
// is matched before a shorter alias that might also be a substring of it --
// e.g. "Amazing Thailand Marathon Bangkok (ATMB)" before "ATMB" alone.
// Deduped by name -- the same race can legitimately appear more than once
// in raceLinks (a name plus its bracketed short code, say), and we only
// want one linkable target per distinct string.
const sortedRaceLinks = [...new Map(
  raceLinks
    .filter((r) => r.reviewSlug !== currentReviewSlug)
    .map((r) => [
      r.name,
      {
        name: r.name,
        // entityHasPage guards the archived case: those races have a review
        // page but no entity page, so a merged build still links their
        // mentions to the review URL rather than to a 404.
        url: linkToEntity && r.entityHasPage ? urls.entity(r.entitySlug) : urls.review(r.reviewSlug),
      },
    ])
).values()].sort((a, b) => b.name.length - a.name.length);

// Which review URLs have already been linked once across this whole
// article render. Tracked by URL, not by name: buildRaceLinkTargets()
// deliberately gives one race several aliases (its full name, a bracketed
// short code, the name with that bracket stripped), and those aliases are
// often substrings of each other. Tracking "already linked" per-name let a
// longer alias get wrapped in a link and then a shorter alias matching text
// *inside that already-inserted anchor* get wrapped again -- a real bug
// (nested <a> tags) caught after shipping. Tracking per-URL instead means
// once any one alias for a race has been linked, every other alias for that
// same race is skipped for the rest of the article, however it's spelled.
const alreadyLinkedUrls = new Set();

// Defensively strip artifacts a web-search-backed model can leak: <cite>
// wrapper tags and compound/hyphenated citation refs like [16-8] or
// [11-3,11-4] that point at internal retrieval chunks rather than our
// sources[]. validate-data rejects these at build time, but stripping them
// here too means a bad record can never render raw markup to a reader.
function cleanArtifacts(text) {
  return text
    .replace(/<\/?cite[^>]*>/gi, '')
    .replace(/\[\d+-[^\]]*\]/g, ''); // drop hyphenated chunk refs like [16-8]; keep [n] and [n,m]
}

// Wraps the first unlinked occurrence of each race name in an <a> to that
// race's review. Runs on already-escaped text, and only ever inserts a link
// built from raceLinks (never from the paragraph itself), so this can't
// become an HTML-injection path the way rendering raw paragraph markup
// would be.
function autolinkRaceNames(escapedText) {
  let result = escapedText;
  for (const { name, url } of sortedRaceLinks) {
    if (alreadyLinkedUrls.has(url)) continue;
    const escapedName = escapeHtml(name);
    const idx = result.indexOf(escapedName);
    if (idx === -1) continue;
    result =
      result.slice(0, idx) +
      `<a href="${url}" class="link-accent">${escapedName}</a>` +
      result.slice(idx + escapedName.length);
    alreadyLinkedUrls.add(url);
  }
  return result;
}

// Escape, autolink race names, then turn a citation marker into superscript
// link(s). Citations run last since [n] never appears inside a race name or
// the anchor tags autolinking just inserted, so the two passes can't
// collide. Citations support a single [n] and a comma list [n,m] (both
// sources back the claim); a number with no matching source is left as
// literal text (validate-data fails the build on that, so it never reaches
// production).
function renderParagraph(text) {
  const linked = autolinkRaceNames(escapeHtml(cleanArtifacts(text)));
  return linked.replace(/\[(\d+(?:\s*,\s*\d+)*)\]/g, (whole, group) => {
    const nums = group.split(',').map((x) => Number(x.trim())).filter((n) => byNumber.has(n));
    if (nums.length === 0) return whole;
    return nums
      .map(
        (n) =>
          `<sup class="citation"><a href="#ref-${n}" class="link-accent" aria-label="Reference ${n}">[${n}]</a></sup>`
      )
      .join('');
  });
}
---

<article class="prose-content">
  {sections.map((section) => (
    <section class="mt-8">
      <h2 class="mb-3 text-xl font-semibold">{section.heading}</h2>
      {section.paragraphs.map((p) => (
        <p set:html={renderParagraph(p)} />
      ))}
    </section>
  ))}
</article>

{sources.length > 0 && (
  <section class="mt-12 border-t border-brand-border pt-6 dark:border-brand-border-dark" aria-labelledby="references-heading">
    <h2 id="references-heading" class="mb-4 text-lg font-semibold">References &amp; sources</h2>
    <ol class="space-y-2 text-sm">
      {sources
        .slice()
        .sort((a, b) => a.n - b.n)
        .map((s) => (
          <li id={`ref-${s.n}`} class="flex gap-2 scroll-mt-24">
            <span class="shrink-0 tabular-nums text-brand-muted dark:text-brand-muted-dark">{s.n}.</span>
            <span>
              <a href={s.url} rel="nofollow noopener" target="_blank" class="link-accent">
                {s.label}
              </a>
              {s.publisher && (
                <span class="text-brand-muted dark:text-brand-muted-dark"> — {s.publisher}</span>
              )}
            </span>
          </li>
        ))}
    </ol>
    <p class="mt-4 text-xs text-brand-muted dark:text-brand-muted-dark">
      Quotes are short excerpts reproduced under fair use and attributed to their original authors; follow the
      links above for the full context. This article is an independent summary and is not affiliated with the event.
    </p>
  </section>
)}
