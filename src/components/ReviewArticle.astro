---
import { escapeHtml, cleanArtifacts, prepareRaceLinks, autolinkText } from '../lib/autolink.js';

// Renders a review article's body: prose sections whose inline [n] markers
// are turned into links to a numbered references list at the end, and whose
// first mention of a race with its own review page is turned into a link to
// that review.
//
// SAFETY: stored paragraph text is treated as plain text. We HTML-escape it
// first, then the ONLY markup we add is our own <sup><a> citation links, the
// reference anchors, and (see raceLinks below) plain <a> race-name links --
// all built from data this component controls, never from raw paragraph
// text. Data can never inject arbitrary HTML this way, which is the same
// guard ExcerptQuotes relies on -- no raw scraped markup renders.
//
// Props:
//   sections:   [{ heading, paragraphs: [string with optional [n] markers] }]
//   sources:    [{ n, label, publisher?, url, type? }]
//   raceLinks:  [{ name, reviewSlug }] -- from src/lib/data.js's
//               buildRaceLinkTargets(). Each distinct name is linked at most
//               once across the whole page (its first mention only, see
//               alreadyLinkedUrls below) so a race repeated through the
//               piece doesn't turn into a wall of identical links.
//   urls:       the site's urls helper (passed in rather than imported, so
//               this component doesn't need to know the review path shape).
//   currentReviewSlug: when this article IS a review, its own slug -- pass
//               this so a review never links its own race name back to
//               itself.
//   alreadyLinkedUrls: optional Set, shared with other autolinked content on
//               the same page (e.g. FAQSection's raceLinks prop) so a race
//               already linked in one block -- body prose or FAQ answer,
//               whichever comes first -- isn't linked again in the other.
//               Defaults to a fresh Set for callers that don't share one.
const {
  sections = [],
  sources = [],
  raceLinks = [],
  urls,
  currentReviewSlug = null,
  alreadyLinkedUrls = new Set(),
} = Astro.props;

const byNumber = new Map(sources.map((s) => [s.n, s]));

// Longest name first, so a more specific mention (e.g. the full race name)
// is matched before a shorter alias that might also be a substring of it --
// e.g. "Amazing Thailand Marathon Bangkok (ATMB)" before "ATMB" alone.
const sortedRaceLinks = prepareRaceLinks(raceLinks, urls, currentReviewSlug);

// Escape, autolink race names, then turn a citation marker into superscript
// link(s). Citations run last since [n] never appears inside a race name or
// the anchor tags autolinking just inserted, so the two passes can't
// collide. Citations support a single [n] and a comma list [n,m] (both
// sources back the claim); a number with no matching source is left as
// literal text (validate-data fails the build on that, so it never reaches
// production).
function renderParagraph(text) {
  const linked = autolinkText(escapeHtml(cleanArtifacts(text)), sortedRaceLinks, alreadyLinkedUrls);
  return linked.replace(/\[(\d+(?:\s*,\s*\d+)*)\]/g, (whole, group) => {
    const nums = group.split(',').map((x) => Number(x.trim())).filter((n) => byNumber.has(n));
    if (nums.length === 0) return whole;
    return nums
      .map(
        (n) =>
          `<sup class="citation"><a href="#ref-${n}" class="link-accent" aria-label="Reference ${n}">[${n}]</a></sup>`
      )
      .join('');
  });
}
---

<article class="prose-content">
  {sections.map((section) => (
    <section class="mt-8">
      <h2 class="mb-3 text-xl font-semibold">{section.heading}</h2>
      {section.paragraphs.map((p) => (
        <p set:html={renderParagraph(p)} />
      ))}
    </section>
  ))}
</article>

{sources.length > 0 && (
  <section class="mt-12 border-t border-brand-border pt-6 dark:border-brand-border-dark" aria-labelledby="references-heading">
    <h2 id="references-heading" class="mb-4 text-lg font-semibold">References &amp; sources</h2>
    <ol class="space-y-2 text-sm">
      {sources
        .slice()
        .sort((a, b) => a.n - b.n)
        .map((s) => (
          <li id={`ref-${s.n}`} class="flex gap-2 scroll-mt-24">
            <span class="shrink-0 tabular-nums text-brand-muted dark:text-brand-muted-dark">{s.n}.</span>
            <span>
              <a href={s.url} rel="nofollow noopener" target="_blank" class="link-accent">
                {s.label}
              </a>
              {s.publisher && (
                <span class="text-brand-muted dark:text-brand-muted-dark"> — {s.publisher}</span>
              )}
            </span>
          </li>
        ))}
    </ol>
    <p class="mt-4 text-xs text-brand-muted dark:text-brand-muted-dark">
      Quotes are short excerpts reproduced under fair use and attributed to their original authors; follow the
      links above for the full context. This article is an independent summary and is not affiliated with the event.
    </p>
  </section>
)}
