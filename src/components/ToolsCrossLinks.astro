---
// Internal-linking block every tool page under src/pages/tools/ carries at
// the bottom -- each calculator links to the other four (plus the hub), so
// crawlers reach every tool page from every other tool page, not only from
// the hub.
import { urls } from '../lib/urls.js';
import { TOOLS } from '../lib/tools.js';

const { currentSlug } = Astro.props;
const others = TOOLS.filter((tool) => tool.slug !== currentSlug);
---

<nav
  aria-label="More Pace Lab tools"
  class="mt-10 rounded-xl border border-brand-border bg-brand-surface-offset p-5 dark:border-brand-border-dark dark:bg-brand-surface-offset-dark"
>
  <p class="mb-3 text-sm font-semibold">More free calculators</p>
  <ul class="grid gap-x-4 gap-y-2 sm:grid-cols-2">
    {others.map((tool) => (
      <li><a href={urls.tool(tool.slug)} class="link-accent text-sm">{tool.navLabel}</a></li>
    ))}
  </ul>
  <p class="mt-3 text-xs text-brand-muted dark:text-brand-muted-dark">
    <a href={urls.toolsIndex()} class="link-muted">See all Pace Lab tools</a>
  </p>
</nav>
