---
import { urls } from '../../lib/urls.js';
import { DISTANCE_LABEL } from '../../lib/finishTimes.js';
import { numFieldClass, selectClass, labelClass, subLabelClass, cardClass, calculateButtonClass } from '../../lib/tool-styles.js';

// "How would you have placed last year?" on an upcoming race's page: a time
// against the previous edition's field (lastEditionField in finishTimes.js).
// Only per-group sizes and percentile tables reach the page, never a time.
const { field, raceName, raceSlug, country } = Astro.props;
// Indonesian races also carry a Bahasa Indonesia version (Alex, Nov 2026: the
// Borobudur box reel is in Bahasa but the box was English). The page renders
// English (what Google indexes); the script below switches the text when the
// visitor's browser is Indonesian, the URL has ?lang=id, or the visit came
// from Instagram (utm_source=instagram) on an Indonesian race.
const bahasa = country === 'Indonesia';
// Rounded to the nearest minute, so a 1:25:54 median reads 1:26.
const fmt = (s) => {
  const mins = Math.round(s / 60);
  const h = Math.floor(mins / 60);
  return h ? `${h}:${String(mins % 60).padStart(2, '0')}` : `${mins} min`;
};
const summary = (d) =>
  [`${d.groups.all.n.toLocaleString('en')} finishers, median ${fmt(d.median)}, fastest 10% under ${fmt(d.top10)}`, d.shares.map((s) => `${pct(s.share)} under ${fmt(s.t)}`).join(', ')]
    .filter(Boolean)
    .join('; ') + '.';
const pct = (x) => `${Math.round(x * 100)}%`;
const payload = { order: field.order, distances: field.distances, labels: DISTANCE_LABEL, year: field.year, race: raceSlug ?? '', raceName, bahasa, source: field.source ?? '', resultsUrl: field.resultsUrl ?? '', labUrl: `${urls.toolsIndex()}#calculator` };
const first = field.order[0];
---

<section id="last-year" aria-labelledby="last-year-heading" class={`mt-8 scroll-mt-32 ${cardClass}`}>
  <h2 id="last-year-heading" data-ly="heading" class="text-xl font-semibold">How would you have placed in {field.year}?</h2>
  <p data-ly="intro" class="mt-2 text-sm text-brand-muted dark:text-brand-muted-dark">
    Put in a finish time, or your target, to see where it would have landed among last year's finishers at {raceName}.
  </p>

  <ul id="ly-summary" class="mt-4 space-y-1.5 text-sm">
    {field.order.map((k) => {
      return (
        <li>
          <span class="font-semibold">{DISTANCE_LABEL[k]}:</span> {summary(field.distances[k])}
        </li>
      );
    })}
  </ul>

  <form id="ly-form" class="mt-5 space-y-5" novalidate>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {field.order.length > 1 ? (
        <div>
          <label for="ly-distance" data-ly="distance" class={labelClass}>Distance</label>
          <select id="ly-distance" class={`${selectClass} min-h-11 w-full`}>
            {field.order.map((k) => <option value={k} data-k={k} selected={k === first}>{DISTANCE_LABEL[k]}</option>)}
          </select>
        </div>
      ) : (
        <input type="hidden" id="ly-distance" value={first} />
      )}
      <div>
        <label for="ly-gender" data-ly="compare" class={labelClass}>Compare with</label>
        <select id="ly-gender" class={`${selectClass} min-h-11 w-full`}>
          <option value="all" data-ly="all">All finishers</option>
          <option value="M" data-ly="men">Men</option>
          <option value="F" data-ly="women">Women</option>
        </select>
      </div>
      <div class="sm:col-span-2">
        <span data-ly="time" class={labelClass}>Finish time or target</span>
        <div class="grid grid-cols-3 gap-2 sm:max-w-sm">
          <div><input id="ly-h" type="number" inputmode="numeric" min="0" max="11" placeholder="h" aria-label="Hours" class={`${numFieldClass} min-h-11`} /><p data-ly="hours" class={subLabelClass}>hours</p></div>
          <div><input id="ly-m" type="number" inputmode="numeric" min="0" max="59" placeholder="mm" aria-label="Minutes" class={`${numFieldClass} min-h-11`} /><p data-ly="minutes" class={subLabelClass}>minutes</p></div>
          <div><input id="ly-s" type="number" inputmode="numeric" min="0" max="59" placeholder="ss" aria-label="Seconds" class={`${numFieldClass} min-h-11`} /><p data-ly="seconds" class={subLabelClass}>seconds</p></div>
        </div>
      </div>
    </div>
    <p id="ly-error" class="text-sm text-brand-error dark:text-brand-error-dark" role="alert"></p>
    <button type="submit" data-ly="button" class={calculateButtonClass}>See where I'd have placed</button>
  </form>

  <p id="ly-result" class="mt-5 hidden rounded-lg bg-brand-primary-highlight px-4 py-3 text-base font-semibold dark:bg-brand-primary-highlight-dark" aria-live="polite"></p>

  <p id="ly-footer" class="mt-5 text-xs text-brand-muted dark:text-brand-muted-dark">
    From the official {field.year} results{field.source ? ` (${field.source})` : ''}{field.resultsUrl && <>: <a href={field.resultsUrl} rel="noopener" target="_blank" class="link-accent">see them ↗</a></>}. Positions are estimates, from finish times only. Course, weather and field change from year to year.
    {' '}<a href={`${urls.toolsIndex()}#calculator`} class="link-accent">Compare your time across more races in the Lab</a>.
  </p>
</section>

<script define:vars={{ payload }}>
  const $ = (id) => document.getElementById(id);
  // Language: Bahasa Indonesia on Indonesian races when the browser is set to
  // Indonesian, the URL asks for it (?lang=id), or the visit came from Instagram.
  const qs = new URLSearchParams(location.search);
  const browserId = (navigator.languages || [navigator.language || '']).some((l) => /^(id|in)(-|$)/i.test(l));
  const lang = payload.bahasa && (qs.get('lang') === 'id' || (qs.get('lang') !== 'en' && (browserId || qs.get('utm_source') === 'instagram'))) ? 'id' : 'en';
  const ID = {
    heading: `Di posisi berapa kamu finis di ${payload.year}?`,
    intro: `Masukkan waktu finis atau target waktumu untuk melihat posisinya di antara finisher ${payload.raceName} tahun lalu.`,
    distance: 'Jarak', compare: 'Bandingkan dengan', all: 'Semua finisher', men: 'Pria', women: 'Wanita',
    time: 'Waktu finis atau target', hours: 'jam', minutes: 'menit', seconds: 'detik', button: 'Lihat posisiku',
    labels: { Full: 'Maraton', Half: 'Half marathon', '10K': '10K' },
  };
  const nf = (n) => n.toLocaleString(lang === 'id' ? 'id-ID' : 'en');
  const hm = (s) => { const m = Math.round(s / 60); const h = Math.floor(m / 60); return h ? `${h}:${String(m % 60).padStart(2, '0')}` : `${m} min`; };
  if (lang === 'id') {
    document.querySelectorAll('#last-year [data-ly]').forEach((el) => { const v = ID[el.dataset.ly]; if (v) el.textContent = v; });
    document.querySelectorAll('#ly-distance option[data-k]').forEach((o) => { o.textContent = ID.labels[o.dataset.k] ?? o.textContent; });
    const ul = $('ly-summary');
    ul.innerHTML = '';
    payload.order.forEach((k) => {
      const d = payload.distances[k];
      const li = document.createElement('li');
      const b = document.createElement('span');
      b.className = 'font-semibold';
      b.textContent = `${ID.labels[k] ?? k}: `;
      const shares = d.shares.map((x) => `${Math.round(x.share * 100)}% di bawah ${hm(x.t)}`).join(', ');
      li.append(b, `${nf(d.groups.all.n)} finisher, median ${hm(d.median)}, 10% tercepat di bawah ${hm(d.top10)}${shares ? `; ${shares}` : ''}.`);
      ul.append(li);
    });
    const ft = $('ly-footer');
    ft.textContent = `Dari hasil resmi ${payload.year}${payload.source ? ` (${payload.source})` : ''}`;
    if (payload.resultsUrl) {
      const a = document.createElement('a');
      a.href = payload.resultsUrl; a.rel = 'noopener'; a.target = '_blank'; a.className = 'link-accent'; a.textContent = 'lihat ↗';
      ft.append(': ', a);
    }
    ft.append('. Posisi adalah perkiraan, hanya dari waktu finis. Rute, cuaca dan peserta berubah tiap tahun. ');
    const lab = document.createElement('a');
    lab.href = payload.labUrl; lab.className = 'link-accent'; lab.textContent = 'Bandingkan waktumu di lebih banyak lomba di Lab';
    ft.append(lab, '.');
    document.getElementById('last-year')?.setAttribute('lang', 'id');
  }
  // Reel links end in #last-year, but in-app browsers often open at the top of
  // the page (the box sits just below the fold on a phone), so jump to it.
  if (location.hash === '#last-year') {
    // 'instant': the site sets scroll-behavior: smooth, which in-app browsers can stall.
    const go = () => document.getElementById('last-year')?.scrollIntoView({ block: 'start', behavior: 'instant' });
    requestAnimationFrame(go);
    window.addEventListener('load', go, { once: true });
  }
  const fmtFull = (s) => {
    const h = Math.floor(s / 3600);
    const m = String(Math.floor(s / 60) % 60).padStart(2, '0');
    const sec = String(Math.round(s % 60)).padStart(2, '0');
    return h ? `${h}:${m}:${sec}` : `${Math.floor(s / 60)}:${sec}`;
  };
  // Share of the group faster than t, interpolated between the 101 quantiles.
  const fasterShare = (q, t) => {
    if (t <= q[0]) return 0;
    if (t >= q[100]) return 1;
    let i = 0;
    while (q[i + 1] < t) i++;
    const span = q[i + 1] - q[i];
    return (i + (span ? (t - q[i]) / span : 0)) / 100;
  };
  $('ly-form').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const t = (Number($('ly-h').value) || 0) * 3600 + (Number($('ly-m').value) || 0) * 60 + (Number($('ly-s').value) || 0);
    const d = payload.distances[$('ly-distance').value];
    const g = $('ly-gender').value;
    const grp = d.groups[g] ?? d.groups.all;
    if (!t) {
      $('ly-error').textContent = lang === 'id' ? 'Masukkan waktu dulu.' : 'Put in a finish time first.';
      return;
    }
    $('ly-error').textContent = '';
    const f = fasterShare(grp.q, t);
    const place = Math.max(1, Math.round(f * grp.n) + 1);
    const who = lang === 'id'
      ? (g === 'M' && d.groups.M ? 'pria' : g === 'F' && d.groups.F ? 'wanita' : 'finisher')
      : (g === 'M' && d.groups.M ? 'men' : g === 'F' && d.groups.F ? 'women' : 'finishers');
    const ahead = Math.round((1 - f) * 100);
    const out = $('ly-result');
    const dk = $('ly-distance').value;
    const dl = (lang === 'id' ? ID.labels[dk] : payload.labels[dk]).toLowerCase();
    out.textContent = lang === 'id'
      ? (f >= 1
        ? `${fmtFull(t)} lebih lambat dari semua finisher ${dl} di ${payload.year}.`
        : f <= 0
          ? `${fmtFull(t)} lebih cepat dari semua finisher ${dl} di ${payload.year}.`
          : `${fmtFull(t)} akan berada di posisi sekitar ${nf(place)} dari ${nf(grp.n)} ${who} di ${payload.year}: lebih cepat dari sekitar ${ahead}% dari mereka.`)
      : f >= 1
        ? `${fmtFull(t)} would have been slower than every ${dl} finisher in ${payload.year}.`
        : f <= 0
          ? `${fmtFull(t)} would have been faster than every ${dl} finisher in ${payload.year}.`
          : `${fmtFull(t)} would have placed about ${place.toLocaleString('en')} of ${grp.n.toLocaleString('en')} ${who} in ${payload.year}: faster than about ${ahead}% of them.`;
    out.classList.remove('hidden');
    // GA4 (gtag is set up in BaseLayout): how often the box is used, on which
    // race, distance and comparison group. The time itself is never sent.
    window.gtag?.('event', 'last_year_place', {
      race: payload.race,
      distance: $('ly-distance').value,
      compare: g,
      edition_year: payload.year,
      lang,
    });
  });
</script>
