---
import { urls } from '../../lib/urls.js';
import { loadFinishTimes, DISTANCES, DISTANCE_LABEL } from '../../lib/finishTimes.js';
import { numFieldClass, selectClass, labelClass, subLabelClass, cardClass, calculateButtonClass } from '../../lib/tool-styles.js';

// The "how do you stack up?" calculator: a time against every finish we hold
// (region, country, gender, age group), tiered against the runner's own
// peer group. Only percentile tables reach the page, never individual times.
const ft = loadFinishTimes();
const payload = { tables: ft.tables, counts: ft.counts, races: ft.raceQuantiles, labels: DISTANCE_LABEL };
// The country picker appears only once every country we hold results for has
// at least 3 races (Alex, Oct 2026); until then everyone is compared region-wide.
const showCountry = ft.allCountries.length > 0 && ft.allCountries.every((c) => ft.countryList.includes(c));
---

    <section id="calculator" class={cardClass}>
      <h2 class="text-xl font-semibold">Where does your time rank?</h2>
      <form id="ft-form" class="mt-5 space-y-5" novalidate>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="ft-distance" class={labelClass}>Distance</label>
            <select id="ft-distance" class={`${selectClass} w-full`}>
              {DISTANCES.filter((k) => ft.tables[k]).map((k) => <option value={k}>{DISTANCE_LABEL[k]}</option>)}
            </select>
          </div>
          <div>
            <span class={labelClass}>Finish time</span>
            <div class="grid grid-cols-3 gap-2">
              <div><input id="ft-h" type="number" inputmode="numeric" min="0" max="11" placeholder="h" aria-label="Hours" class={numFieldClass} /><p class={subLabelClass}>hours</p></div>
              <div><input id="ft-m" type="number" inputmode="numeric" min="0" max="59" placeholder="mm" aria-label="Minutes" class={numFieldClass} /><p class={subLabelClass}>minutes</p></div>
              <div><input id="ft-s" type="number" inputmode="numeric" min="0" max="59" placeholder="ss" aria-label="Seconds" class={numFieldClass} /><p class={subLabelClass}>seconds</p></div>
            </div>
          </div>
          <div>
            <label for="ft-gender" class={labelClass}>Gender <span class="font-normal text-brand-muted dark:text-brand-muted-dark">(optional)</span></label>
            <select id="ft-gender" class={`${selectClass} w-full`}>
              <option value="">Prefer not to say</option>
              <option value="F">Woman</option>
              <option value="M" selected>Man</option>
            </select>
          </div>
          <div>
            <label for="ft-age" class={labelClass}>Age <span class="font-normal text-brand-muted dark:text-brand-muted-dark">(optional)</span></label>
            <input id="ft-age" type="number" inputmode="numeric" min="10" max="99" value="46" placeholder="e.g. 46" class={numFieldClass} />
          </div>
          {showCountry && (
            <div class="sm:col-span-2">
              <label for="ft-country" class={labelClass}>Country <span class="font-normal text-brand-muted dark:text-brand-muted-dark">(optional)</span></label>
              <select id="ft-country" class={`${selectClass} w-full`}>
                <option value="">Southeast Asia only</option>
                {ft.countryList.map((c) => <option value={c}>{c}</option>)}
              </select>
            </div>
          )}
        </div>
        <p id="ft-error" class="text-sm text-brand-error dark:text-brand-error-dark" role="alert"></p>
        <button type="submit" class={calculateButtonClass}>See where I rank</button>
      </form>

      <div id="ft-result" class="mt-6 hidden" aria-live="polite">
        <div class="rounded-lg bg-brand-primary-highlight p-5 dark:bg-brand-primary-highlight-dark">
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-muted dark:text-brand-muted-dark" id="ft-tier-label">Your tier</p>
          <p class="mt-1 font-serif text-3xl font-black" id="ft-tier"></p>
          <p class="mt-1 text-sm" id="ft-headline"></p>
        </div>
        <ul id="ft-rows" class="mt-4 divide-y divide-brand-divider rounded-lg border border-brand-border dark:divide-brand-divider-dark dark:border-brand-border-dark"></ul>
        <p id="ft-agegrade" class="mt-3 hidden text-sm"></p>
        <div class="mt-5 flex flex-wrap gap-2">
          <button type="button" id="ft-share" class="inline-flex min-h-[44px] items-center rounded-md border border-brand-border px-4 text-sm font-semibold hover:bg-brand-surface-offset dark:border-brand-border-dark dark:hover:bg-brand-surface-offset-dark">Share my result</button>
          <button type="button" id="ft-card" class="inline-flex min-h-[44px] items-center rounded-md border border-brand-border px-4 text-sm font-semibold hover:bg-brand-surface-offset dark:border-brand-border-dark dark:hover:bg-brand-surface-offset-dark">Download share card</button>
          <span id="ft-copied" class="self-center text-sm text-brand-muted dark:text-brand-muted-dark"></span>
        </div>
        <h3 class="mt-8 text-base font-semibold">Where you'd have ranked at the biggest races</h3>
        <p class="mt-1 text-sm text-brand-muted dark:text-brand-muted-dark">The same time against each race's own field.</p>
        <ul id="ft-races" class="mt-3 space-y-1 text-sm"></ul>
        <details id="ft-races-more" class="mt-2 text-sm">
          <summary class="inline-flex min-h-[44px] cursor-pointer items-center font-semibold text-brand-muted dark:text-brand-muted-dark">See all races</summary>
          <ul id="ft-races-all" class="mt-1 space-y-1"></ul>
        </details>
      </div>
    </section>

  <script id="ft-data" type="application/json" set:html={JSON.stringify(payload)} />
  <script>
    type Q = number[];
    const data = JSON.parse(document.getElementById('ft-data')!.textContent || '{}');
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const form = document.getElementById('ft-form') as HTMLFormElement;
    const err = document.getElementById('ft-error')!;
    const result = document.getElementById('ft-result')!;
    const fmt = (s: number) => `${Math.floor(s / 3600)}:${String(Math.floor(s / 60) % 60).padStart(2, '0')}:${String(Math.round(s % 60)).padStart(2, '0')}`;
    const short = (s: number) => (s >= 3600 ? `${Math.floor(s / 3600)}:${String(Math.floor(s / 60) % 60).padStart(2, '0')}:${String(Math.round(s % 60)).padStart(2, '0')}` : `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`);
    const band = (age: number) => (age < 20 ? 'U20' : age >= 60 ? '60+' : `${Math.floor(age / 10) * 10}-${Math.floor(age / 10) * 10 + 9}`);
    const genderWord: Record<string, string> = { M: 'men', F: 'women' };
    const place = (c: string) => (c === 'Philippines' ? 'the Philippines' : c);

    // Share of finishers slower than t, from a 101-point quantile table.
    function beats(q: Q, t: number) {
      if (t <= q[0]) return 100;
      if (t >= q[100]) return 0;
      for (let i = 0; i < 100; i++) {
        if (t < q[i + 1]) return 100 - (i + (t - q[i]) / Math.max(1, q[i + 1] - q[i]));
      }
      return 0;
    }
    const pct = (x: number) => (x >= 99.5 ? '>99' : x < 0.5 ? '<1' : String(Math.round(x)));
    function tier(b: number) {
      if (b >= 99) return 'Elite';
      if (b >= 95) return 'Podium';
      if (b >= 90) return 'Front pack';
      if (b >= 75) return 'Strong';
      if (b >= 50) return 'Steady';
      return 'Finisher';
    }
    // Approximate age grade -- same model as /tools/age-graded-calculator/.
    const BEST: Record<string, Record<string, number>> = { M: { '10K': 1571, Half: 3451, Full: 7235 }, F: { '10K': 1741, Half: 3772, Full: 7796 } };
    function ageFactor(age: number) {
      if (age >= 25 && age <= 35) return 1;
      if (age > 35) {
        let f = 1;
        for (const [lo, hi, rate] of [[35, 50, 0.006], [50, 60, 0.009], [60, 70, 0.013], [70, 80, 0.018], [80, 120, 0.023]]) if (age > lo) f -= (Math.min(age, hi) - lo) * rate;
        return Math.max(f, 0.15);
      }
      let g = 1 - Math.min(25 - age, 7) * 0.003;
      if (age < 18) g -= (18 - age) * 0.01;
      return Math.max(g, 0.1);
    }

    let lastShare = '';
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const d = $('ft-distance').value;
      const t = (Number($('ft-h').value) || 0) * 3600 + (Number($('ft-m').value) || 0) * 60 + (Number($('ft-s').value) || 0);
      const g = $('ft-gender').value;
      const ageRaw = $('ft-age').value;
      const age = ageRaw ? Number(ageRaw) : null;
      const c = ($('ft-country') as HTMLSelectElement | null)?.value || '';
      if (!t || t < 600) { err.textContent = 'Enter your finish time (hours, minutes and seconds).'; result.classList.add('hidden'); return; }
      if (age != null && (age < 10 || age > 99)) { err.textContent = 'Enter an age between 10 and 99, or leave it blank.'; result.classList.add('hidden'); return; }
      err.textContent = '';
      const T = data.tables[d] || {};
      const C = data.counts[d] || {};
      const rows: { label: string; b: number; n: number; med: number; key: string }[] = [];
      const cap = (w: string) => w[0].toUpperCase() + w.slice(1);
      const add = (label: string, scope: string, gg: string, aa: string, key: string) => {
        const q = T[scope]?.[gg]?.[aa];
        if (q) rows.push({ label, b: beats(q, t), n: C[scope][gg][aa], med: q[50], key });
        return !!q;
      };
      const notes: string[] = [];
      add('All finishers in Southeast Asia', 'all', 'all', 'all', 'all');
      if (c && !add(`All finishers in ${place(c)}`, c, 'all', 'all', 'country')) notes.push(`We don't yet hold ${data.labels[d].toLowerCase()} results from at least 3 races in ${place(c)}, so it isn't compared separately yet.`);
      if (g) add(`All ${genderWord[g]}`, 'all', g, 'all', 'gender');
      if (g && age != null && !add(`${cap(genderWord[g])} aged ${band(age)}`, 'all', g, band(age), 'genderAge')) notes.push(`Not enough ${genderWord[g]} aged ${band(age)} in our data yet to compare you with them.`);
      if (!g && age != null) add(`Runners aged ${band(age)}`, 'all', 'all', band(age), 'age');
      if (c && g) add(`${cap(genderWord[g])} in ${place(c)}`, c, g, 'all', 'countryGender');

      // Tier: against the most specific group we hold -- the runners you'd
      // actually line up with (gender and age, else gender, else everyone).
      const order = ['genderAge', 'gender', 'age', 'all'];
      const peer = order.map((k) => rows.find((r) => r.key === k)).find(Boolean) || rows[0];
      const overall = rows[0]?.b ?? 0;
      const who = (label: string) => label.replace(/^All /, '').replace(/^(Men|Women|Runners)/, (w) => w.toLowerCase());
      document.getElementById('ft-tier-label')!.textContent = `Your tier among ${who(peer.label)}`;
      document.getElementById('ft-tier')!.textContent = tier(peer.b);
      const gap = Math.round((peer.med - t) / 60);
      const gapText = gap > 0 ? `${gap} min faster than their typical time of ${short(peer.med)}` : gap < 0 ? `${-gap} min slower than their typical time of ${short(peer.med)}` : `right on their typical time of ${short(peer.med)}`;
      document.getElementById('ft-headline')!.textContent = `A ${short(t)} ${data.labels[d].toLowerCase()} is faster than ${pct(peer.b)}% of ${who(peer.label)} (top ${pct(100 - peer.b)}%), ${gapText}.`;
      document.getElementById('ft-rows')!.innerHTML = rows.map((r) =>
        `<li class="flex items-baseline justify-between gap-3 px-4 py-3 text-sm"><span>${r.label} <span class="text-brand-muted dark:text-brand-muted-dark">(${r.n.toLocaleString('en-US')} finishes, typical ${short(r.med)})</span></span><span class="shrink-0 font-semibold tabular-nums">Faster than ${pct(r.b)}%</span></li>`).join('')
        + notes.map((x) => `<li class="px-4 py-3 text-sm text-brand-muted dark:text-brand-muted-dark">${x}</li>`).join('');
      const best = peer;

      const agEl = document.getElementById('ft-agegrade')!;
      if (g && age != null && BEST[g]?.[d]) {
        const score = (BEST[g][d] / (t * ageFactor(age))) * 100;
        agEl.textContent = `Age-graded score (approximate): ${score.toFixed(1)}%.`;
        agEl.classList.remove('hidden');
      } else agEl.classList.add('hidden');

      // The five biggest fields up front (the races most readers ran or know);
      // every other race behind "See all races".
      const raceList = (data.races as { slug: string; name: string; distance: string; n: number; q: Q }[])
        .filter((r) => r.distance === d)
        .map((r) => ({ ...r, b: beats(r.q, t) }));
      const li = (r: { slug: string; name: string; n: number; b: number }) =>
        `<li class="flex items-baseline justify-between gap-3 border-b border-brand-divider py-1.5 last:border-0 dark:border-brand-divider-dark"><span><a class="link-accent" href="/race/${r.slug}/">${r.name}</a> <span class="text-xs text-brand-muted dark:text-brand-muted-dark">${r.n.toLocaleString('en-US')} finishers</span></span><span class="shrink-0 tabular-nums">Top ${pct(100 - r.b)}%</span></li>`;
      const biggest = [...raceList].sort((a, b) => b.n - a.n).slice(0, 5);
      document.getElementById('ft-races')!.innerHTML = biggest.map(li).join('');
      const rest = raceList.filter((r) => !biggest.includes(r)).sort((a, b) => a.name.localeCompare(b.name));
      document.getElementById('ft-races-all')!.innerHTML = rest.map(li).join('');
      document.getElementById('ft-races-more')!.classList.toggle('hidden', rest.length === 0);
      document.querySelector('#ft-races-more summary')!.textContent = `See the other ${rest.length} races`;
      (document.getElementById('ft-races-more') as HTMLDetailsElement).open = false;

      lastShare = `My ${short(t)} ${data.labels[d].toLowerCase()} is faster than ${pct(best.b)}% of ${who(best.label)}: ${tier(best.b)} tier. How do you stack up?`;
      (window as any).__ftCard = { tier: tier(best.b), time: short(t), dist: data.labels[d], line: `Faster than ${pct(best.b)}% of ${who(best.label)}`, overall: `Top ${pct(100 - overall)}% of all finishers in Southeast Asia` };
      result.classList.remove('hidden');
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    const pageUrl = location.origin + location.pathname;
    document.getElementById('ft-share')!.addEventListener('click', async () => {
      const note = document.getElementById('ft-copied')!;
      try {
        if (navigator.share) await navigator.share({ text: lastShare, url: pageUrl });
        else { await navigator.clipboard.writeText(`${lastShare} ${pageUrl}`); note.textContent = 'Copied to clipboard'; }
      } catch { /* user cancelled */ }
    });

    // Share card: a 1080x1080 image drawn on a canvas, saved by the browser.
    document.getElementById('ft-card')!.addEventListener('click', () => {
      const c = (window as any).__ftCard;
      if (!c) return;
      const cv = document.createElement('canvas');
      cv.width = 1080; cv.height = 1080;
      const x = cv.getContext('2d')!;
      x.fillStyle = '#0f3d3e'; x.fillRect(0, 0, 1080, 1080);
      x.fillStyle = '#f5c542'; x.fillRect(80, 80, 12, 920);
      x.fillStyle = '#ffffff';
      x.font = '600 44px system-ui, sans-serif'; x.fillText(c.dist.toUpperCase(), 140, 190);
      x.font = '900 180px system-ui, sans-serif'; x.fillText(c.time, 140, 400);
      x.fillStyle = '#f5c542'; x.font = '800 96px system-ui, sans-serif'; x.fillText(c.tier, 140, 560);
      x.fillStyle = '#ffffff'; x.font = '500 46px system-ui, sans-serif';
      const words = c.line.split(' '); let line = ''; let y = 660;
      for (const w of words) { if (x.measureText(line + w).width > 820) { x.fillText(line, 140, y); line = ''; y += 60; } line += w + ' '; }
      x.fillText(line, 140, y);
      x.font = '500 40px system-ui, sans-serif'; x.fillStyle = '#cfe3e0'; x.fillText(c.overall, 140, y + 80);
      x.font = '700 44px system-ui, sans-serif'; x.fillStyle = '#ffffff'; x.fillText('runsea.run/finish-times', 140, 980);
      const a = document.createElement('a');
      a.download = 'runsea-finish-time.png';
      a.href = cv.toDataURL('image/png');
      a.click();
    });
  </script>
