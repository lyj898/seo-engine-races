---
import { urls } from '../../lib/urls.js';
import siteConfig from '../../lib/config.js';
import { loadFinishTimes, DISTANCES, DISTANCE_LABEL } from '../../lib/finishTimes.js';
import { TIERS, DISTANCE_SLUG } from '../../lib/labTiers.js';
import { numFieldClass, selectClass, labelClass, subLabelClass, cardClass, calculateButtonClass } from '../../lib/tool-styles.js';

// The "how do you stack up?" calculator: a time against every finish we hold
// (region, country, gender, age group), tiered against the runner's own
// peer group. Only percentile tables reach the page, never individual times.
const ft = loadFinishTimes();
const { defaultDistance = 'Half' } = Astro.props;
const payload = { tables: ft.tables, counts: ft.counts, races: ft.raceQuantiles, labels: DISTANCE_LABEL, tiers: TIERS, dslug: DISTANCE_SLUG, rankBase: urls.labRank('D', 'T').replace('D/T/', '') };
// The country picker appears only once every country we hold results for has
// at least 3 races (Alex, Oct 2026); until then everyone is compared region-wide.
const showCountry = ft.allCountries.length > 0 && ft.allCountries.every((c) => ft.countryList.includes(c));
---

    <section id="calculator" class={cardClass}>
      <h2 class="text-xl font-semibold">Where does your time rank?</h2>
      <form id="ft-form" class="mt-5 space-y-5" novalidate>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="ft-distance" class={labelClass}>Distance</label>
            <select id="ft-distance" class={`${selectClass} w-full`}>
              {DISTANCES.filter((k) => ft.tables[k]).map((k) => <option value={k} selected={k === defaultDistance}>{DISTANCE_LABEL[k]}</option>)}
            </select>
          </div>
          <div>
            <span class={labelClass}>Finish time</span>
            <div class="grid grid-cols-3 gap-2">
              <div><input id="ft-h" type="number" inputmode="numeric" min="0" max="11" placeholder="h" aria-label="Hours" class={numFieldClass} /><p class={subLabelClass}>hours</p></div>
              <div><input id="ft-m" type="number" inputmode="numeric" min="0" max="59" placeholder="mm" aria-label="Minutes" class={numFieldClass} /><p class={subLabelClass}>minutes</p></div>
              <div><input id="ft-s" type="number" inputmode="numeric" min="0" max="59" placeholder="ss" aria-label="Seconds" class={numFieldClass} /><p class={subLabelClass}>seconds</p></div>
            </div>
          </div>
          <div>
            <label for="ft-gender" class={labelClass}>Gender <span class="font-normal text-brand-muted dark:text-brand-muted-dark">(optional)</span></label>
            <select id="ft-gender" class={`${selectClass} w-full`}>
              <option value="">Prefer not to say</option>
              <option value="F">Woman</option>
              <option value="M" selected>Man</option>
            </select>
          </div>
          <div>
            <label for="ft-age" class={labelClass}>Age <span class="font-normal text-brand-muted dark:text-brand-muted-dark">(optional)</span></label>
            <input id="ft-age" type="number" inputmode="numeric" min="10" max="99" value="46" placeholder="e.g. 46" class={numFieldClass} />
          </div>
          {showCountry && (
            <div class="sm:col-span-2">
              <label for="ft-country" class={labelClass}>Country <span class="font-normal text-brand-muted dark:text-brand-muted-dark">(optional)</span></label>
              <select id="ft-country" class={`${selectClass} w-full`}>
                <option value="">Southeast Asia only</option>
                {ft.countryList.map((c) => <option value={c}>{c}</option>)}
              </select>
            </div>
          )}
        </div>
        <p id="ft-error" class="text-sm text-brand-error dark:text-brand-error-dark" role="alert"></p>
        <button type="submit" class={calculateButtonClass}>See where I rank</button>
      </form>

      <div id="ft-result" class="mt-6 hidden scroll-mt-24" aria-live="polite">
        <p id="ft-shared" class="mb-3 hidden rounded-lg bg-brand-primary-highlight px-4 py-3 text-sm font-semibold dark:bg-brand-primary-highlight-dark">Someone shared their result with you. Put in your own time above to see where you rank.</p>
        <!-- The result card: made to be screenshotted and shared, so it keeps
             the same dark ink-and-lime look in light and dark mode. -->
        <figure id="ft-card" class="overflow-hidden rounded-2xl bg-[#15170f] p-5 text-[#eceee2] shadow-lg sm:p-8">
          <div class="flex items-center justify-between gap-3 text-[11px] font-bold uppercase tracking-[0.16em]">
            <span>Run SEA Lab</span><span id="fc-dist" class="text-[#c8ff33]"></span>
          </div>
          <div class="mt-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
            <div class="min-w-0">
              <p id="fc-time" class="font-serif text-6xl font-black leading-none tabular-nums sm:text-7xl"></p>
              <p id="fc-who" class="mt-2 text-sm text-[#a2a493]"></p>
            </div>
            <div class="sm:text-right">
              <p class="text-[11px] font-bold uppercase tracking-wide text-[#a2a493]">Faster than</p>
              <p id="fc-pct" class="font-serif text-5xl font-black leading-none text-[#c8ff33] tabular-nums"></p>
            </div>
          </div>
          <svg id="fc-chart" viewBox="0 0 400 100" preserveAspectRatio="none" class="mt-6 block h-24 w-full sm:h-28" role="img"></svg>
          <div class="mt-1 flex justify-between text-[11px] text-[#a2a493]"><span>&larr; faster</span><span>slower &rarr;</span></div>
          <ol id="fc-ladder" class="mt-6 grid grid-cols-3 gap-1.5 text-center text-[10px] font-bold uppercase tracking-wide sm:grid-cols-6 sm:text-[11px]"></ol>
          <p id="fc-next" class="mt-3 text-sm"></p>
          <dl id="fc-stats" class="mt-6 grid gap-2 sm:grid-cols-3"></dl>
          <figcaption class="mt-6 flex flex-wrap justify-between gap-2 border-t border-white/15 pt-4 text-[11px] text-[#a2a493]">
            <span id="fc-basis"></span><span class="font-bold text-[#eceee2]">runsea.run/tools</span>
          </figcaption>
        </figure>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <button type="button" id="ft-share" class="hidden min-h-[44px] items-center rounded-md bg-brand-text px-4 text-sm font-bold text-brand-bg dark:bg-brand-text-dark dark:text-brand-bg-dark">Share</button>
          <a id="ft-wa" target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-brand-border px-4 text-sm font-semibold hover:bg-brand-surface-offset dark:border-brand-border-dark dark:hover:bg-brand-surface-offset-dark">WhatsApp</a>
          <a id="ft-x" target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-brand-border px-4 text-sm font-semibold hover:bg-brand-surface-offset dark:border-brand-border-dark dark:hover:bg-brand-surface-offset-dark">X</a>
          <a id="ft-fb" target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-brand-border px-4 text-sm font-semibold hover:bg-brand-surface-offset dark:border-brand-border-dark dark:hover:bg-brand-surface-offset-dark">Facebook</a>
          <button type="button" id="ft-copy" class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-brand-border px-4 text-sm font-semibold hover:bg-brand-surface-offset dark:border-brand-border-dark dark:hover:bg-brand-surface-offset-dark">Copy link</button>
          <span id="ft-copied" class="text-sm text-brand-muted dark:text-brand-muted-dark"></span>
        </div>
        {siteConfig.instagramUrl && (
          <p class="mt-3 text-sm text-brand-muted dark:text-brand-muted-dark">A new stat from these results every day on Instagram: <a href={siteConfig.instagramUrl} target="_blank" rel="noopener" class="link-accent font-semibold">@runsea.run</a></p>
        )}
        <h3 class="mt-8 text-base font-semibold">How you compare</h3>
        <ul id="ft-rows" class="mt-3 divide-y divide-brand-divider rounded-lg border border-brand-border dark:divide-brand-divider-dark dark:border-brand-border-dark"></ul>
        <h3 class="mt-8 text-base font-semibold">The races where you'd have ranked best</h3>
        <p class="mt-1 text-sm text-brand-muted dark:text-brand-muted-dark">The same time against each race's own field, best ranking first.</p>
        <ul id="ft-races" class="mt-3 space-y-1 text-sm"></ul>
        <details id="ft-races-more" class="mt-2 text-sm">
          <summary class="inline-flex min-h-[44px] cursor-pointer items-center font-semibold text-brand-muted dark:text-brand-muted-dark">See all races</summary>
          <ul id="ft-races-all" class="mt-1 space-y-1"></ul>
        </details>
      </div>
    </section>

  <script id="ft-data" type="application/json" set:html={JSON.stringify(payload)} />
  <script>
    type Q = number[];
    // GA4 events (gtag is set up in BaseLayout): how many people rank a time,
    // and how they share it. Only the distance, tier and peer-group type are
    // sent -- never the time, age or gender themselves.
    const track = (name: string, params: Record<string, string>) => (window as any).gtag?.('event', name, params);
    let shareItem = '';
    const trackShare = (method: string) => track('share', { method, content_type: 'lab_result', item_id: shareItem });
    const data = JSON.parse(document.getElementById('ft-data')!.textContent || '{}');
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const form = document.getElementById('ft-form') as HTMLFormElement;
    const err = document.getElementById('ft-error')!;
    const result = document.getElementById('ft-result')!;
    const fmt = (s: number) => `${Math.floor(s / 3600)}:${String(Math.floor(s / 60) % 60).padStart(2, '0')}:${String(Math.round(s % 60)).padStart(2, '0')}`;
    const short = (s: number) => (s >= 3600 ? `${Math.floor(s / 3600)}:${String(Math.floor(s / 60) % 60).padStart(2, '0')}:${String(Math.round(s % 60)).padStart(2, '0')}` : `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`);
    const band = (age: number) => (age < 20 ? 'U20' : age >= 60 ? '60+' : `${Math.floor(age / 10) * 10}-${Math.floor(age / 10) * 10 + 9}`);
    const genderWord: Record<string, string> = { M: 'men', F: 'women' };
    const place = (c: string) => (c === 'Philippines' ? 'the Philippines' : c);

    // Share of finishers slower than t, from a 101-point quantile table.
    function beats(q: Q, t: number) {
      if (t <= q[0]) return 100;
      if (t >= q[100]) return 0;
      for (let i = 0; i < 100; i++) {
        if (t < q[i + 1]) return 100 - (i + (t - q[i]) / Math.max(1, q[i + 1] - q[i]));
      }
      return 0;
    }
    const pct = (x: number) => (x >= 99.5 ? '>99' : x < 0.5 ? '<1' : String(Math.round(x)));
    // Tiers come from src/lib/labTiers.js (shared with the share pages and cards).
    const TIERS = data.tiers as { name: string; slug: string; p: number }[];
    const tierIndex = (b: number) => TIERS.filter((x) => b >= x.p).length - 1;
    const tier = (b: number) => TIERS[tierIndex(b)].name;
    // Approximate age grade -- same model as /tools/age-graded-calculator/.
    const BEST: Record<string, Record<string, number>> = { M: { '10K': 1571, Half: 3451, Full: 7235 }, F: { '10K': 1741, Half: 3772, Full: 7796 } };
    function ageFactor(age: number) {
      if (age >= 25 && age <= 35) return 1;
      if (age > 35) {
        let f = 1;
        for (const [lo, hi, rate] of [[35, 50, 0.006], [50, 60, 0.009], [60, 70, 0.013], [70, 80, 0.018], [80, 120, 0.023]]) if (age > lo) f -= (Math.min(age, hi) - lo) * rate;
        return Math.max(f, 0.15);
      }
      let g = 1 - Math.min(25 - age, 7) * 0.003;
      if (age < 18) g -= (18 - age) * 0.01;
      return Math.max(g, 0.1);
    }

    let lastShare = '';
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const d = $('ft-distance').value;
      const t = (Number($('ft-h').value) || 0) * 3600 + (Number($('ft-m').value) || 0) * 60 + (Number($('ft-s').value) || 0);
      const g = $('ft-gender').value;
      const ageRaw = $('ft-age').value;
      const age = ageRaw ? Number(ageRaw) : null;
      const c = ($('ft-country') as HTMLSelectElement | null)?.value || '';
      if (!t || t < 600) { err.textContent = 'Enter your finish time (hours, minutes and seconds).'; result.classList.add('hidden'); return; }
      if (age != null && (age < 10 || age > 99)) { err.textContent = 'Enter an age between 10 and 99, or leave it blank.'; result.classList.add('hidden'); return; }
      err.textContent = '';
      const T = data.tables[d] || {};
      const C = data.counts[d] || {};
      const rows: Row[] = [];
      const cap = (w: string) => w[0].toUpperCase() + w.slice(1);
      const add = (label: string, scope: string, gg: string, aa: string, key: string) => {
        const q = T[scope]?.[gg]?.[aa];
        if (q) rows.push({ label, b: beats(q, t), n: C[scope][gg][aa], med: q[50], key, q });
        return !!q;
      };
      const notes: string[] = [];
      add('All finishers in Southeast Asia', 'all', 'all', 'all', 'all');
      if (c && !add(`All finishers in ${place(c)}`, c, 'all', 'all', 'country')) notes.push(`We don't yet hold ${data.labels[d].toLowerCase()} results from at least 3 races in ${place(c)}, so it isn't compared separately yet.`);
      if (g) add(`All ${genderWord[g]}`, 'all', g, 'all', 'gender');
      if (g && age != null && !add(`${cap(genderWord[g])} aged ${band(age)}`, 'all', g, band(age), 'genderAge')) notes.push(`Not enough ${genderWord[g]} aged ${band(age)} in our data yet to compare you with them.`);
      if (!g && age != null) add(`Runners aged ${band(age)}`, 'all', 'all', band(age), 'age');
      if (c && g) add(`${cap(genderWord[g])} in ${place(c)}`, c, g, 'all', 'countryGender');

      // Tier: against the most specific group we hold -- the runners you'd
      // actually line up with (gender and age, else gender, else everyone).
      const order = ['genderAge', 'gender', 'age', 'all'];
      const peer = order.map((k) => rows.find((r) => r.key === k)).find(Boolean) || rows[0];
      const overall = rows[0]?.b ?? 0;
      const who = (label: string) => label.replace(/^All /, '').replace(/^(Men|Women|Runners)/, (w) => w.toLowerCase());
      document.getElementById('ft-rows')!.innerHTML = rows.map((r) =>
        `<li class="flex items-baseline justify-between gap-3 px-4 py-3 text-sm"><span>${r.label} <span class="text-brand-muted dark:text-brand-muted-dark">(${r.n.toLocaleString('en-US')} finishes, typical ${short(r.med)})</span></span><span class="shrink-0 font-semibold tabular-nums">Faster than ${pct(r.b)}%</span></li>`).join('')
        + notes.map((x) => `<li class="px-4 py-3 text-sm text-brand-muted dark:text-brand-muted-dark">${x}</li>`).join('');
      const score = g && age != null && BEST[g]?.[d] ? (BEST[g][d] / (t * ageFactor(age))) * 100 : null;

      // Every race at this distance, best ranking first: the top five up front,
      // the rest (same order) behind "See the other N races".
      const raceList = (data.races as { slug: string; name: string; distance: string; n: number; q: Q }[])
        .filter((r) => r.distance === d)
        .map((r) => ({ ...r, b: beats(r.q, t) }))
        .sort((a, b) => b.b - a.b || b.n - a.n);
      const li = (r: { slug: string; name: string; n: number; b: number }) =>
        `<li class="flex items-baseline justify-between gap-3 border-b border-brand-divider py-1 last:border-0 dark:border-brand-divider-dark"><span><a class="link-accent inline-block py-1.5" href="/race/${r.slug}/">${r.name}</a> <span class="text-xs text-brand-muted dark:text-brand-muted-dark">${r.n.toLocaleString('en-US')} finishers</span></span><span class="shrink-0 tabular-nums">Top ${pct(100 - r.b)}%</span></li>`;
      const best5 = raceList.slice(0, 5);
      document.getElementById('ft-races')!.innerHTML = best5.map(li).join('');
      const rest = raceList.slice(5);
      document.getElementById('ft-races-all')!.innerHTML = rest.map(li).join('');
      document.getElementById('ft-races-more')!.classList.toggle('hidden', rest.length === 0);
      document.querySelector('#ft-races-more summary')!.textContent = `See the other ${rest.length} races`;
      (document.getElementById('ft-races-more') as HTMLDetailsElement).open = false;

      // Best race ranking (the top of the list above): the brag line.
      const bigRace = raceList[0];
      const raceName = (n: string) => n.replace(/\s*\(.*?\)/g, '').replace(/\s+presented by.*$/i, '').replace(/\s+20\d\d\b/g, '').trim();
      renderCard({ d, t, peer, overall, score, bigRace: bigRace && { name: raceName(bigRace.name), b: bigRace.b } });
      shareItem = `${data.dslug[d]}-${TIERS[tierIndex(peer.b)].slug}`;
      track('lab_rank', {
        distance: data.dslug[d],
        tier: TIERS[tierIndex(peer.b)].slug,
        peer_group: peer.key,
        source: fromLink ? 'shared_link' : 'form',
        page_type: location.pathname.includes('/rank/') ? 'tier_page' : 'lab',
      });
      // Shared links open the page for this distance and tier, so WhatsApp and
      // friends show that tier's preview card, with the full result on it.
      shareUrl = `${location.origin}${data.rankBase}${data.dslug[d]}/${TIERS[tierIndex(peer.b)].slug}/?${new URLSearchParams({ d, t: String(t), ...(g ? { g } : {}), ...(age != null ? { a: String(age) } : {}) })}`;
      const peerText = peer.key === 'all' ? 'all finishers in Southeast Asia' : `${who(peer.label)} in Southeast Asia`;
      lastShare = `My ${short(t)} ${data.labels[d].toLowerCase()} is faster than ${pct(peer.b)}% of ${peerText}: ${tier(peer.b)} tier.`
        + (bigRace ? ` I'd have been top ${pct(100 - bigRace.b)}% at ${raceName(bigRace.name)}.` : '') + ' How do you stack up?';
      const enc = encodeURIComponent;
      (document.getElementById('ft-wa') as HTMLAnchorElement).href = `https://wa.me/?text=${enc(`${lastShare} ${shareUrl}`)}`;
      (document.getElementById('ft-x') as HTMLAnchorElement).href = `https://x.com/intent/post?text=${enc(lastShare)}&url=${enc(shareUrl)}`;
      (document.getElementById('ft-fb') as HTMLAnchorElement).href = `https://www.facebook.com/sharer/sharer.php?u=${enc(shareUrl)}`;
      document.getElementById('ft-copied')!.textContent = '';
      result.classList.remove('hidden');
      result.scrollIntoView({ behavior: fromLink ? 'auto' : 'smooth', block: 'start' });
    });

    type Row = { label: string; b: number; n: number; med: number; key: string; q: Q };
    function renderCard({ d, t, peer, overall, score, bigRace }: { d: string; t: number; peer: Row; overall: number; score: number | null; bigRace?: { name: string; b: number } }) {
      const q = peer.q;
      const set = (id: string, v: string) => { document.getElementById(id)!.textContent = v; };
      const group = peer.key === 'all' ? 'All finishers' : peer.label.replace(/^All /, '').replace(/^\w/, (w) => w.toUpperCase());
      const groupLower = peer.key === 'all' ? 'all finishers' : group.replace(/^\w/, (w) => w.toLowerCase());
      set('fc-dist', data.labels[d]);
      set('fc-time', short(t));
      set('fc-who', `${group} · Southeast Asia`);
      set('fc-pct', `${pct(peer.b)}%`);

      // The peer group's spread of finish times, drawn from its quantiles:
      // each bar is the share of runners in that time slice, lime where they
      // finished behind you.
      const lo = q[1], hi = q[97], N = 44, w = 400 / N;
      const slices = Array.from({ length: N }, (_, i) => {
        const a = lo + ((hi - lo) * i) / N, b = lo + ((hi - lo) * (i + 1)) / N;
        return { a, v: beats(q, a) - beats(q, b) };
      });
      const top = Math.max(...slices.map((x) => x.v));
      const xYou = Math.min(398, Math.max(2, ((t - lo) / (hi - lo)) * 400));
      const svg = document.getElementById('fc-chart')!;
      svg.setAttribute('aria-label', `Finish times of ${groupLower}, with your time marked: faster than ${pct(peer.b)}% of them.`);
      svg.innerHTML = slices.map((x, i) => {
        const h = Math.max(1.5, (x.v / top) * 84);
        return `<rect x="${(i * w + 0.8).toFixed(1)}" y="${(100 - h).toFixed(1)}" width="${(w - 1.6).toFixed(1)}" height="${h.toFixed(1)}" rx="1.5" fill="${x.a >= t ? '#c8ff33' : '#3a3c2c'}"/>`;
      }).join('') + `<line x1="${xYou}" x2="${xYou}" y1="4" y2="100" stroke="#eceee2" stroke-width="2" vector-effect="non-scaling-stroke"/>`;

      // Tier ladder, and how far it is to the next rung.
      const cur = tierIndex(peer.b);
      document.getElementById('fc-ladder')!.innerHTML = TIERS.map(({ name, p }, i) => {
        const cls = i === cur ? 'bg-[#c8ff33] text-[#15170f]' : i < cur ? 'border border-[#c8ff33]/50 text-[#c8ff33]' : 'border border-white/10 text-[#6d6f5f]';
        return `<li class="rounded-md px-1 py-2 ${cls}">${name}<span class="block text-[9px] font-semibold normal-case tracking-normal opacity-80">${p ? `top ${100 - p}%` : 'everyone'}</span></li>`;
      }).join('');
      const next = TIERS[cur + 1];
      if (next) {
        const need = Math.max(1, Math.round(t - q[100 - next.p]));
        set('fc-next', `${short(need)} faster and you're ${next.name}: the top ${100 - next.p}% of ${groupLower}.`);
      } else set('fc-next', `The top 1% of ${groupLower} in Southeast Asia.`);

      const tile = (big: string, small: string) => `<div class="flex flex-col rounded-lg bg-white/5 px-4 py-3"><dt class="text-xs leading-snug text-[#a2a493]">${small}</dt><dd class="order-first font-serif text-2xl font-black text-[#eceee2]">${big}</dd></div>`;
      const tiles = [tile(`Top ${pct(100 - overall)}%`, 'of every finisher in Southeast Asia')];
      if (bigRace) tiles.push(tile(`Top ${pct(100 - bigRace.b)}%`, `at ${bigRace.name}, your best race ranking`));
      tiles.push(score != null ? tile(`${score.toFixed(1)}%`, 'age-graded score (approximate)') : tile(short(peer.med), `typical time for ${groupLower}`));
      document.getElementById('fc-stats')!.innerHTML = tiles.join('');
      set('fc-basis', `Based on ${(data.counts[d]?.all?.all?.all ?? 0).toLocaleString('en-US')} ${data.labels[d].toLowerCase()} finishes, latest edition of each race`);
    }

    let shareUrl = location.origin + location.pathname;
    const shareBtn = document.getElementById('ft-share')!;
    if ('share' in navigator) { shareBtn.classList.remove('hidden'); shareBtn.classList.add('inline-flex'); }
    shareBtn.addEventListener('click', async () => {
      try { await navigator.share({ text: lastShare, url: shareUrl }); trackShare('native'); } catch { /* cancelled */ }
    });
    document.getElementById('ft-copy')!.addEventListener('click', async () => {
      const note = document.getElementById('ft-copied')!;
      try { await navigator.clipboard.writeText(`${lastShare} ${shareUrl}`); note.textContent = 'Copied'; } catch { note.textContent = shareUrl; }
      trackShare('copy');
    });

    // A shared link (?d=Half&t=7500&g=M&a=46) opens with that result showing.
    for (const [id, method] of [['ft-wa', 'whatsapp'], ['ft-x', 'x'], ['ft-fb', 'facebook']]) {
      document.getElementById(id)!.addEventListener('click', () => trackShare(method));
    }

    let fromLink = false;
    const params = new URLSearchParams(location.search);
    const st = Number(params.get('t'));
    const sd = params.get('d') || '';
    if (data.tables[sd] && st >= 600 && st < 43200) {
      $('ft-distance').value = sd;
      $('ft-h').value = String(Math.floor(st / 3600));
      $('ft-m').value = String(Math.floor(st / 60) % 60).padStart(2, '0');
      $('ft-s').value = String(st % 60).padStart(2, '0');
      $('ft-gender').value = ['M', 'F'].includes(params.get('g') || '') ? params.get('g')! : '';
      $('ft-age').value = /^\d{2}$/.test(params.get('a') || '') ? params.get('a')! : '';
      fromLink = true;
      form.requestSubmit();
      fromLink = false;
      document.getElementById('ft-shared')!.classList.remove('hidden');
      // After load, or the browser's own scroll restoration undoes it.
      const toCard = () => setTimeout(() => result.scrollIntoView({ block: 'start' }), 50);
      if (document.readyState === 'complete') toCard(); else window.addEventListener('load', toCard);
    }
  </script>
