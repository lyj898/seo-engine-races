---
// This route's own folder name, "[entityType]", is a dynamic Astro route
// param, not a literal word -- getStaticPaths below is the ONLY place that
// decides its actual value, and it always uses
// site.config.json.entityLabelPlural (e.g. "races", "hotels"). This is how
// entity URLs like /races/some-slug/ exist without this file (or any other
// shared file) ever containing the literal word "race".
import siteConfig from '../../lib/config.js';
import { urls, entityUrlSegment } from '../../lib/urls.js';
import { loadEntities, loadCategories, loadRegions, loadListicles, loadReviews, stripMeta, isPublished, buildRaceLinkTargets } from '../../lib/data.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FactsTable from '../../components/FactsTable.astro';
import ProsCons from '../../components/ProsCons.astro';
import SentimentBreakdown from '../../components/SentimentBreakdown.astro';
import ExcerptQuotes from '../../components/ExcerptQuotes.astro';
import ReviewArticle from '../../components/ReviewArticle.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTABlock from '../../components/CTABlock.astro';
import RelatedEntities from '../../components/RelatedEntities.astro';
import RelatedListicles from '../../components/RelatedListicles.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import Pill from '../../components/Pill.astro';
import { narrowFactsToCategories } from '../../lib/categoryMatch.js';
import { withResolvedRegistration } from '../../lib/text.js';
import { pickRelatedEntities } from '../../lib/related.js';
import { buildEntitySchema, buildFaqPageSchema, buildBreadcrumbListSchema, buildReviewSchema } from '../../lib/schema-jsonld.js';

export function getStaticPaths() {
  // Same publish rule as every hub and the sitemap: a detail page exists
  // for exactly the records that are linked to, so nothing is orphaned and
  // a retired record doesn't leave a stale page behind.
  const entities = loadEntities().map(stripMeta).filter(isPublished);
  return entities.map((entity) => ({
    params: { entityType: entityUrlSegment, slug: entity.slug },
    props: { entity },
  }));
}

const { entity } = Astro.props;
const categories = loadCategories().map(stripMeta);
const regions = loadRegions().map(stripMeta);
const allEntities = loadEntities().map(stripMeta).filter(isPublished);
const listicles = loadListicles().map(stripMeta).filter(isPublished);

const category = categories.find((c) => c.category_id === entity.category_id);
const region = regions.find((r) => r.region_id === entity.region_id);

// If a published review article exists for this entity, surface it near the
// top -- the long-form review is the more engaging read; the listing is the
// facts sheet it links back to.
const review = siteConfig.enabledFeatures?.reviews
  ? loadReviews().map(stripMeta).filter(isPublished).find((r) => r.entity_id === entity.entity_id)
  : undefined;

// With mergedReviews on, the review body renders HERE rather than at its own
// URL (see site.config.json's _mergedReviews_note). `merged` gates every
// review block below; with the flag off the page falls back to the previous
// behaviour of linking out to /reviews/<slug>/.
const merged = Boolean(review) && siteConfig.enabledFeatures?.mergedReviews;

// One rating, not two. entity.sentiment_scores is a research-time estimate
// present on only ~21 entities; review.rating is the review's own verdict and
// exists on every review. When both exist the review wins -- showing two
// differently-scored breakdowns of the same race on one page reads as a bug.
const ratingToShow = merged && review.rating ? review.rating : entity.sentiment_scores;
const ratingIsFromReview = Boolean(merged && review.rating);

// Merged FAQ set, deduped by question. 18 of the 215 entity/review pairs ask
// at least one identical question, and two FAQPage blocks on one URL (or the
// same question twice in the accordion) is exactly the redundancy this merge
// exists to remove.
const mergedFaqs = merged
  ? [...(entity.faqs ?? []), ...(review.faqs ?? [])].filter((faq, i, all) =>
      all.findIndex((f) => f.question.trim().toLowerCase() === faq.question.trim().toLowerCase()) === i
    )
  : (entity.faqs ?? []);

// Once the review body is on this page, the review's own seo_title describes
// it better than the bare entity name does: it leads with the searchable race
// name (dropping sponsor prefixes readers don't type), says "Review", and
// carries the city/country people actually search alongside a race. GSC's
// query log for this site is all bare event names -- "kulai half marathon
// 2026", "johor night run 2026" -- which these titles still match, plus the
// review intent the old titles missed entirely.
//
// The <h1> deliberately stays entity.name: that is the race's name, and the
// title tag is a search-surface string, not a page heading. Entity schema
// keeps entity.name too, so structured data still carries the clean name.
const pageTitle = merged && review.seo_title?.trim() ? review.seo_title.trim() : entity.name;

// Internal-linking mesh (shared helper in src/lib/related.js so every page
// type -- and anything the pipeline adds later -- follows the same rule):
// editorially-pinned related_entity_ids first, then same-region/same-category
// siblings, so every entity page links to its neighbours instead of being
// reachable only from its two hubs.
const relatedEntities = pickRelatedEntities(entity, allEntities);

// A listicle is "related" if it's explicitly pinned to this entity, or its
// filter targets this entity's category -- covers both editorial pins and
// filter-driven matches without hand-maintaining a link list per entity.
const relatedListicles = siteConfig.enabledFeatures?.listicles
  ? listicles.filter(
      (l) => l.manual_entity_ids?.includes(entity.entity_id) || l.filters?.category_id === entity.category_id
    )
  : [];

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  ...(region ? [{ label: region.label, href: urls.region(region.slug) }] : []),
  { label: entity.name, href: urls.entity(entity.slug) },
];

const canonicalUrl = new URL(urls.entity(entity.slug), Astro.site).toString();

// Built from the exact same `entity` / `breadcrumbItems` data already on
// this page -- nothing gets defined twice for display vs. schema. Each
// piece is gated by its own enabledFeatures flag so a vertical instance
// can turn schema types on/off without touching this file.
const jsonLd = [
  buildEntitySchema(entity, siteConfig, canonicalUrl),
  // When the review body lives on this page, its Review schema belongs here
  // too -- pointing at this URL, since /reviews/<slug>/ is now a redirect.
  ...(merged
    ? [
        buildReviewSchema({
          review,
          entity,
          siteConfig,
          url: canonicalUrl,
          entityUrl: canonicalUrl,
          site: Astro.site,
        }),
      ]
    : []),
  ...(siteConfig.enabledFeatures?.faqSchema ? [buildFaqPageSchema(mergedFaqs)] : []),
  buildBreadcrumbListSchema(breadcrumbItems, Astro.site),
].filter(Boolean);
---

<BaseLayout
  title={pageTitle}
  description={entity.short_description}
  canonicalPath={urls.entity(entity.slug)}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />

    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">{entity.name}</h1>
    <p class="mt-3 text-lg text-brand-muted dark:text-brand-muted-dark">{entity.short_description}</p>
    <div class="mt-2">
      <LastUpdated date={entity.last_updated} />
    </div>

    <div class="prose-content mt-8">
      <p>{entity.ai_summary}</p>
    </div>

    {/* Unmerged fallback: link out to the standalone review page. */}
    {review && !merged && (
      <a
        href={urls.review(review.slug)}
        class="mt-6 flex items-center justify-between gap-4 rounded-xl border border-brand-primary/40 bg-brand-surface-offset p-4 transition-colors hover:border-brand-primary dark:bg-brand-surface-offset-dark"
      >
        <span>
          <span class="text-xs font-semibold uppercase tracking-wide text-brand-muted dark:text-brand-muted-dark">In-depth review</span>
          <span class="mt-0.5 block text-sm font-medium">{review.title}</span>
        </span>
        <span aria-hidden="true" class="shrink-0 text-brand-text dark:text-brand-text-dark">→</span>
      </a>
    )}

    {/* The bottom line, up top: readers deciding whether to enter want the
        verdict before the detail, not after it. */}
    {merged && (
      <div class="mt-8 rounded-xl border border-brand-border bg-brand-surface-offset p-5 dark:border-brand-border-dark dark:bg-brand-surface-offset-dark">
        <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-brand-muted dark:text-brand-muted-dark">
          The bottom line
        </h2>
        <p class="text-base leading-relaxed">{review.verdict}</p>
      </div>
    )}

    <div class="mt-8">
      <FactsTable facts={withResolvedRegistration(narrowFactsToCategories(entity.core_facts, categories))} />
    </div>

    {/* The review body -- the reason this page exists as a merged page at
        all. Sits above pros/cons so the long-form read comes before the
        at-a-glance summaries of it. */}
    {merged && (
      <div class="mt-4">
        <ReviewArticle
          sections={review.sections}
          sources={review.sources}
          raceLinks={buildRaceLinkTargets()}
          urls={urls}
          linkToEntity={true}
          currentReviewSlug={review.slug}
        />
      </div>
    )}

    <div class="mt-8">
      <ProsCons pros={entity.pros} cons={entity.cons} />
    </div>

    {ratingToShow && (
      <section class="mt-8">
        <h2 class="mb-4 text-xl font-semibold">{ratingIsFromReview ? 'How runners rate it' : 'Sentiment breakdown'}</h2>
        <SentimentBreakdown sentiment={ratingToShow} />
        {ratingIsFromReview && (
          <p class="mt-3 text-xs text-brand-muted dark:text-brand-muted-dark">
            Scores summarise sentiment from the participant reviews cited above, not an official rating.
          </p>
        )}
      </section>
    )}

    {merged && review.pull_quotes?.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-4 text-xl font-semibold">In their words</h2>
        <ExcerptQuotes quotes={review.pull_quotes} />
      </section>
    )}

    {/* Entity-level quotes are the same kind of material as the review's
        pull quotes, so only show them when the review didn't bring its own --
        two near-identical quote blocks on one page is the redundancy this
        merge exists to remove. */}
    {entity.excerpt_quotes?.length > 0 && !(merged && review.pull_quotes?.length > 0) && (
      <section class="mt-8">
        {/* "What people say", not "What sources say": these are now
            first-hand participant quotes gathered by the research stage, and
            framing them as sourcing evidence undersells them as well as
            reminding the reader they're reading a compiled page. */}
        <h2 class="mb-4 text-xl font-semibold">What people say</h2>
        <ExcerptQuotes quotes={entity.excerpt_quotes} />
      </section>
    )}

    {entity.tags?.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-1.5">
        {entity.tags.map((tag) => <Pill>{tag}</Pill>)}
      </div>
    )}

    <div class="mt-8">
      <CTABlock
        ctaLinks={entity.cta_links}
        affiliateLinks={entity.affiliate_links}
        heading={`Find out more about ${entity.name}`}
      />
    </div>

    <div class="mt-10">
      <FAQSection faqs={mergedFaqs} />
    </div>

    <div class="mt-10">
      <RelatedEntities entities={relatedEntities} categories={categories} heading={`Related ${siteConfig.entityLabelPlural}`} />
    </div>

    <div class="mt-10">
      <RelatedListicles listicles={relatedListicles} />
    </div>

    <div class="mt-10 flex flex-wrap gap-4 text-sm">
      {category && (
        <a href={urls.category(category.slug)} class="link-accent">
          More {category.label} {siteConfig.entityLabelPlural} →
        </a>
      )}
      {region && (
        <a href={urls.region(region.slug)} class="link-accent">
          More {siteConfig.entityLabelPlural} in {region.label} →
        </a>
      )}
    </div>
  </div>
</BaseLayout>
