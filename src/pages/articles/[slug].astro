---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadArticles, stripMeta, isPublished, buildRaceLinkTargets } from '../../lib/data.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import ReviewArticle from '../../components/ReviewArticle.astro';
import FAQSection from '../../components/FAQSection.astro';
import { buildFaqPageSchema, buildBreadcrumbListSchema, buildArticleSchema } from '../../lib/schema-jsonld.js';

export function getStaticPaths() {
  const articles = loadArticles().map(stripMeta).filter(isPublished);
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

// Same-topic articles first, then everything else, capped to a reasonable
// footer length -- with a growing library of articles, listing every other
// article (as this used to for Gear) stops being a useful "more like this"
// list and just becomes a wall of links.
const RELATED_ARTICLES_LIMIT = 6;
const otherArticles = loadArticles()
  .map(stripMeta)
  .filter(isPublished)
  .filter((a) => a.slug !== article.slug)
  .sort((a, b) => (a.topic === article.topic ? -1 : 0) - (b.topic === article.topic ? -1 : 0))
  .slice(0, RELATED_ARTICLES_LIMIT);

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Articles', href: urls.articlesIndex() },
  { label: article.title, href: urls.article(article.slug) },
];

// Shared across the article body and its FAQ answers so the same race is
// linked at most once on this page, wherever its first mention actually
// falls -- see ReviewArticle.astro and FAQSection.astro's autolink props.
const linkedRaceUrls = new Set();
const raceLinks = buildRaceLinkTargets();

const canonicalUrl = new URL(urls.article(article.slug), Astro.site).toString();

const pageTitle = article.seo_title || article.title;
const metaDescription = article.meta_description || article.dek;

const jsonLd = [
  buildArticleSchema({ article, siteConfig, url: canonicalUrl, site: Astro.site }),
  ...(siteConfig.enabledFeatures?.faqSchema && article.faqs?.length ? [buildFaqPageSchema(article.faqs)] : []),
  buildBreadcrumbListSchema(breadcrumbItems, Astro.site),
].filter(Boolean);
---

<BaseLayout title={pageTitle} description={metaDescription} canonicalPath={urls.article(article.slug)} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />

    <p class="mt-4 inline-block rounded-full bg-brand-primary px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-brand-primary-ink dark:text-brand-primary-ink-dark">Article</p>
    <h1 class="mt-2 font-serif text-3xl font-semibold sm:text-4xl">{article.title}</h1>
    <p class="mt-3 text-lg text-brand-muted dark:text-brand-muted-dark">{article.dek}</p>

    <div class="mt-3">
      <LastUpdated date={article.last_updated} />
    </div>

    <ReviewArticle
      sections={article.sections}
      sources={article.sources}
      raceLinks={raceLinks}
      urls={urls}
      alreadyLinkedUrls={linkedRaceUrls}
    />

    {article.faqs?.length > 0 && (
      <div class="mt-12">
        <FAQSection faqs={article.faqs} raceLinks={raceLinks} urls={urls} alreadyLinkedUrls={linkedRaceUrls} />
      </div>
    )}

    {otherArticles.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-4 text-xl font-semibold">More articles</h2>
        <ul class="space-y-2">
          {otherArticles.map((a) => (
            <li>
              <a href={urls.article(a.slug)} class="link-accent">{a.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-10">
      <a href={urls.articlesIndex()} class="link-accent">← All articles</a>
    </div>
  </div>
</BaseLayout>
