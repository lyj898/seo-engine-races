---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadArticles, loadListicles, loadRegions, loadGear, stripMeta, isPublished } from '../../lib/data.js';
import { articleShelf } from '../../lib/articleTopics.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { buildBreadcrumbListSchema, buildItemListSchema } from '../../lib/schema-jsonld.js';

// "Articles" in the main menu (was "Guides", renamed Nov 2026). Three parts:
//  1. Our articles: race guides by country, best-of lists, choosing a race,
//     racing abroad, the running scene, training, heat and health, and gear.
//  2. Written by us: pieces we wrote for other publications.
//  3. Featured in: other sites' articles that cite Run SEA.
// Parts 2 and 3 are kept by hand below; add a row when a new piece runs.
const allArticles = loadArticles()
  .map(stripMeta)
  .filter(isPublished)
  .sort((a, b) => (b.published_at ?? b.last_updated).localeCompare(a.published_at ?? a.last_updated));
const lists = siteConfig.enabledFeatures?.listicles ? loadListicles().map(stripMeta).filter(isPublished) : [];
const countries = loadRegions().map(stripMeta).filter(isPublished).filter((r) => !r.parent_region_id);

// One card per country: its "worth the trip" guide plus its race calendars.
const countryKey = (label) => label.toLowerCase().replace(/[^a-z]+/g, '-');
const isCountryGuide = (a) => /^best-marathons-half-marathons-|^singapore-small-mighty-race-calendar$/.test(a.slug);
const DISTANCES = [
  { re: /half/, label: 'Half marathons' },
  { re: /full/, label: 'Marathons' },
  { re: /10k/, label: '10K' },
  { re: /5k/, label: '5K' },
];
const distanceOf = (slug) => DISTANCES.findIndex((d) => d.re.test(slug));
const countryCards = countries
  .map((c) => {
    const key = countryKey(c.label);
    const guide = allArticles.find((a) => isCountryGuide(a) && a.slug.includes(key));
    const calendars = lists
      .filter((l) => l.slug.includes(key))
      .sort((a, b) => distanceOf(a.slug) - distanceOf(b.slug))
      .map((l) => ({ href: urls.listicle(l.slug), label: DISTANCES[distanceOf(l.slug)]?.label ?? l.title }));
    return { label: c.label, href: urls.region(c.slug), guide, calendars };
  })
  .filter((c) => c.guide || c.calendars.length);
// Region-wide lists (no country in the slug), half first.
const regionLists = lists
  .filter((l) => !countries.some((c) => l.slug.includes(countryKey(c.label))))
  .sort((a, b) => distanceOf(a.slug) - distanceOf(b.slug));

const shelf = (name) => allArticles.filter((a) => !isCountryGuide(a) && articleShelf(a) === name);
// Beginner-friendly picks lead; the rest stay newest first.
const LEAD = ['beginners-guide-southeast-asia-race-calendar', 'best-races-first-marathon-half-marathon-southeast-asia', 'southeast-asia-biggest-flagship-marathons-ranked'];
const lead = (a) => (LEAD.includes(a.slug) ? LEAD.indexOf(a.slug) : LEAD.length);
const choosing = shelf('choosing').sort((a, b) => lead(a) - lead(b));
const travel = shelf('travel');
const scene = shelf('scene');
const trainingShelf = shelf('training');
const healthShelf = shelf('health');
const gear = siteConfig.enabledFeatures?.gear
  ? loadGear().map(stripMeta).filter(isPublished).sort((a, b) => (b.published_at ?? b.last_updated ?? '').localeCompare(a.published_at ?? a.last_updated ?? ''))
  : [];

// Part 2: articles we wrote for other publications. Part 3: other sites'
// articles that cite us.
const writtenByUs = [
  { outlet: 'Athletics Illustrated', title: 'The haze season that called off Southeast Asia’s races', date: 'October 2026', href: 'https://athleticsillustrated.com/the-haze-season-that-called-off-southeast-asias-races/' },
  { outlet: 'Great Runs', title: 'Asia road races worth traveling to', date: 'October 2026', href: 'https://greatruns.com/story/asia-road-races-worth-traveling-to/' },
  { outlet: 'The Southeast Asia Desk', title: 'Running on haze: the monthly Southeast Asia race dispatch, with RunSea', date: 'November 2026', href: 'https://www.thesoutheastasiadesk.com/p/southeast-asia-marathon-season-haze-climate-disruptions' },
];
const featuredIn = [
  { outlet: 'The Wellness Insider', what: 'cites our Singapore club directory in its beginner’s guide to running in Singapore', href: 'https://thewellnessinsider.asia/2026/10/running-in-singapore-beginners-clubs-races/' },
  { outlet: 'Great Runs', what: 'links our club pages from its route guides for nine cities', href: 'https://greatruns.com/location/singapore/' },
  { outlet: 'Best of Phnom Penh', what: 'links our Cambodia race calendar from its guide to running in Phnom Penh', href: 'https://www.bestofpp.com/en/post-14/The-ultimate-guide-to-the-best-clubs-and-places-to-run-in-Phnom-Penh' },
];

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Articles' },
];
const jsonLd = [
  buildBreadcrumbListSchema(breadcrumbItems, Astro.site),
  buildItemListSchema(allArticles, Astro.site, (a) => urls.article(a.slug), (a) => a.title),
].filter(Boolean);

const card = 'flex flex-col gap-1 rounded-2xl border border-brand-border bg-brand-surface p-5 transition-colors hover:border-brand-primary dark:border-brand-border-dark dark:bg-brand-surface-dark';
const muted = 'text-sm text-brand-muted dark:text-brand-muted-dark';
const grid = 'mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3';
const sections = [
  { id: 'choosing', title: 'Choosing a race', intro: 'Shortlists by what you want from a race: a first marathon, a view, a night start, a series to chase.', items: choosing },
  { id: 'travel', title: 'Racing abroad', intro: 'Planning the trip: visas, costs, the expo, travel agencies, and bringing the family.', items: travel },
  { id: 'scene', title: 'Running in Southeast Asia', intro: 'Why races here start before dawn, why the medals matter, and running through the haze, the monsoon and Ramadan.', items: scene },
  { id: 'training', title: 'Training', intro: 'How to train for a race in the tropics.', items: trainingShelf },
  { id: 'health', title: 'Heat, health and recovery', intro: 'Running safely in heat and humidity, and recovering well.', items: healthShelf },
].filter((s) => s.items.length);
---

<BaseLayout
  title="Articles -- Races, Training and Gear for Running in Southeast Asia"
  description={`Articles from ${siteConfig.siteName}: race guides by country, best-of lists, training and heat advice and gear, plus the pieces we have written for other publications and the sites that cite us.`}
  canonicalPath={urls.articlesIndex()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-4xl font-black leading-[1.05] sm:text-5xl">Articles</h1>
    <p class="mt-3 max-w-3xl text-lg">
      Our own articles on choosing, training for and travelling to races in Southeast Asia, the pieces we have written for
      other publications, and the sites that cite our data.
    </p>
    <nav aria-label="On this page" class="mt-5 flex flex-wrap gap-2">
      {[{ id: 'ours', title: 'Our articles' }, { id: 'written-by-us', title: 'Written by us' }, { id: 'featured-in', title: 'Featured in' }].map((s) => (
        <a href={`#${s.id}`} class="inline-flex min-h-[40px] items-center rounded-full border border-brand-border px-4 text-sm font-semibold transition-colors hover:border-brand-primary dark:border-brand-border-dark">{s.title}</a>
      ))}
    </nav>

    <h2 id="ours" class="mt-12 scroll-mt-20 font-serif text-3xl font-black">Our articles</h2>
    <section id="countries" class="mt-6 scroll-mt-20">
      <h3 class="font-serif text-2xl font-extrabold">By country</h3>
      <p class={`mt-1 ${muted}`}>The races worth travelling for in each country, and its full calendar by distance.</p>
      <div class={grid}>
        {countryCards.map((c) => (
          <div class={card}>
            <a href={c.href} class="inline-block self-start py-1.5 font-serif text-xl font-extrabold hover:underline">{c.label}</a>
            {c.guide && <a href={urls.article(c.guide.slug)} class="link-accent inline-block py-1 font-semibold" title={c.guide.title}>The races worth the trip →</a>}
            {c.calendars.length > 0 && (
              <div class="mt-1 flex flex-wrap gap-1.5">
                {c.calendars.map((l) => (
                  <a href={l.href} class="inline-flex min-h-[36px] items-center rounded-full bg-brand-primary-highlight px-3 text-xs font-bold text-brand-text hover:opacity-80 dark:bg-brand-primary-highlight-dark dark:text-brand-text-dark">{l.label}</a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    {regionLists.length > 0 && (
      <section id="best" class="mt-12 scroll-mt-20">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="font-serif text-2xl font-extrabold">Best of the region</h3>
          <a href={urls.listiclesIndex()} class="link-accent text-sm font-semibold">All {lists.length} race lists →</a>
        </div>
        <p class={`mt-1 ${muted}`}>Our pick of the races across Southeast Asia at each distance.</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {regionLists.map((l) => (
            <a href={urls.listicle(l.slug)} class={card}>
              <span class="text-xs font-bold uppercase tracking-wide text-brand-muted dark:text-brand-muted-dark">{DISTANCES[distanceOf(l.slug)]?.label ?? 'Races'}</span>
              <span class="font-bold">{l.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {sections.map((s) => (
      <section id={s.id} class="mt-12 scroll-mt-20">
        <h3 class="font-serif text-2xl font-extrabold">{s.title}</h3>
        <p class={`mt-1 ${muted}`}>{s.intro}</p>
        <div class={grid}>
          {s.items.map((a) => (
            <a href={urls.article(a.slug)} class={card}>
              <span class="font-bold">{a.title}</span>
              {a.dek && <span class={`line-clamp-2 ${muted}`}>{a.dek}</span>}
            </a>
          ))}
        </div>
      </section>
    ))}

    {gear.length > 0 && (
      <section id="gear" class="mt-12 scroll-mt-20">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="font-serif text-2xl font-extrabold">Gear for the heat</h3>
          <a href={urls.gearIndex()} class="link-accent text-sm font-semibold">All {gear.length} gear guides &rarr;</a>
        </div>
        <p class={`mt-1 ${muted}`}>Shoes, hydration and kit for humid long runs and race mornings.</p>
        <div class={grid}>
          {gear.slice(0, 6).map((g) => (
            <a href={urls.gear(g.slug)} class={card}>
              <span class="font-bold">{g.title}</span>
              {g.dek && <span class={`line-clamp-2 ${muted}`}>{g.dek}</span>}
            </a>
          ))}
        </div>
      </section>
    )}

    <section id="written-by-us" class="mt-16 scroll-mt-20">
      <h2 class="font-serif text-3xl font-black">Written by us</h2>
      <p class={`mt-1 ${muted}`}>Articles we have written for other publications, built on our race data.</p>
      <div class={grid}>
        {writtenByUs.map((w) => (
          <a href={w.href} rel="noopener" target="_blank" class={card}>
            <span class="text-xs font-bold uppercase tracking-wide text-brand-muted dark:text-brand-muted-dark">{w.outlet} &middot; {w.date}</span>
            <span class="font-bold">{w.title} &#8599;</span>
          </a>
        ))}
      </div>
    </section>

    <section id="featured-in" class="mt-16 scroll-mt-20">
      <h2 class="font-serif text-3xl font-black">Featured in</h2>
      <p class={`mt-1 ${muted}`}>Other sites that cite our race data and directories.</p>
      <div class={grid}>
        {featuredIn.map((f) => (
          <a href={f.href} rel="noopener" target="_blank" class={card}>
            <span class="font-bold">{f.outlet} &#8599;</span>
            <span class={muted}>{f.what}.</span>
          </a>
        ))}
      </div>
    </section>

    {siteConfig.enabledFeatures?.cancellations && (
      <p class={`mt-12 border-t border-brand-divider pt-6 dark:border-brand-divider-dark ${muted}`}>
        Also: <a href={urls.cancellations()} class="link-accent font-semibold">races cancelled or postponed this year</a>.
      </p>
    )}
  </div>
</BaseLayout>
