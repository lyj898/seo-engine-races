---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadClubCities, loadEntities, loadCategories, stripMeta, isPublished } from '../../lib/data.js';
import { byUpcomingDate } from '../../lib/sort.js';
import { isLapsed } from '../../lib/succession.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EntityCard from '../../components/EntityCard.astro';
import Pill from '../../components/Pill.astro';
import { buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

// One page per city: its running clubs, its coaches, and the races run
// there. Built only when the clubs feature is on, like every other section.
export function getStaticPaths() {
  if (!siteConfig.enabledFeatures?.clubs) return [];
  return loadClubCities()
    .map(stripMeta)
    .filter(isPublished)
    .map((city) => ({ params: { slug: city.slug }, props: { city } }));
}

const { city } = Astro.props;

const KIND_LABEL = { club: 'Club', crew: 'Run crew', hash: 'Hash', brand_club: 'Store or brand club', university: 'University club', coach: 'Coach', coaching_business: 'Coaching' };
const FOCUS_LABEL = { road: 'Road', trail: 'Trail', track: 'Track', mixed: 'Road and trail', social: 'Social runs' };
const LINK_LABEL = { website: 'Website', instagram: 'Instagram', facebook: 'Facebook', strava: 'Strava club', meetup: 'Meetup', other: 'Page' };

const byName = (a, b) => a.name.localeCompare(b.name);
const clubs = [...city.clubs].sort(byName);
const coaches = [...(city.coaches ?? [])].sort(byName);

// The city's upcoming races, matched on core_facts.city. Lapse-filtered for
// the same reason the region pages are: this answers "what can I still enter".
const needles = (city.race_cities?.length ? city.race_cities : [city.city]).map((c) => c.toLowerCase());
const races = loadEntities()
  .map(stripMeta)
  .filter(isPublished)
  .filter((e) => !isLapsed(e))
  .filter((e) => needles.some((n) => String(e.core_facts?.city ?? '').toLowerCase().includes(n)))
  .sort(byUpcomingDate);
const categories = loadCategories().map(stripMeta);

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Clubs', href: urls.clubsIndex() },
  { label: city.city },
];
const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)].filter(Boolean);

const title = `Running Clubs and Coaches in ${city.city}`;
const description = `${clubs.length} running clubs and crews${coaches.length ? ` and ${coaches.length} coaches` : ''} in ${city.city}: where and when they run, what they cost, and the races coming up in the city.`;
---

<BaseLayout title={title} description={description} canonicalPath={urls.clubCity(city.slug)} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">{title}</h1>
    {city.area_note && <p class="mt-2 text-sm text-brand-muted dark:text-brand-muted-dark">Covers {city.area_note}.</p>}
    <p class="mt-4 max-w-2xl">{city.intro}</p>

    <nav aria-label="On this page" class="mt-6 flex flex-wrap gap-2">
      <a href="#clubs" class="rounded-full border border-brand-border px-3 py-1.5 text-sm text-brand-muted hover:border-brand-primary hover:text-brand-text dark:border-brand-border-dark dark:text-brand-muted-dark dark:hover:text-brand-text-dark">Clubs ({clubs.length})</a>
      {coaches.length > 0 && <a href="#coaches" class="rounded-full border border-brand-border px-3 py-1.5 text-sm text-brand-muted hover:border-brand-primary hover:text-brand-text dark:border-brand-border-dark dark:text-brand-muted-dark dark:hover:text-brand-text-dark">Coaches ({coaches.length})</a>}
      {races.length > 0 && <a href="#races" class="rounded-full border border-brand-border px-3 py-1.5 text-sm text-brand-muted hover:border-brand-primary hover:text-brand-text dark:border-brand-border-dark dark:text-brand-muted-dark dark:hover:text-brand-text-dark">Races ({races.length})</a>}
    </nav>

    <section id="clubs" class="mt-10 scroll-mt-20">
      <h2 class="text-xl font-semibold">Running clubs and crews</h2>
      <div class="mt-4 space-y-4">
        {clubs.map((club) => (
          <article class="rounded-lg border border-brand-border bg-brand-surface p-5 shadow-sm dark:border-brand-border-dark dark:bg-brand-surface-dark">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-semibold">{club.name}</h3>
              <a href={club.url} rel="noopener" target="_blank" class="link-accent inline-block py-1 text-sm">{LINK_LABEL[club.url_kind]} ↗</a>
            </div>
            <div class="mt-2 flex flex-wrap gap-1.5">
              <Pill>{KIND_LABEL[club.kind]}</Pill>
              <Pill>{FOCUS_LABEL[club.focus]}</Pill>
            </div>
            <p class="mt-3 text-sm">{club.description}</p>
            {club.meets.length > 0 && (
              <ul class="mt-3 space-y-1 text-sm">
                {club.meets.map((m) => (
                  <li><span class="font-medium">{m.when}</span>{m.where && <span class="text-brand-muted dark:text-brand-muted-dark"> at {m.where}</span>}</li>
                ))}
              </ul>
            )}
            {club.cost && <p class="mt-2 text-sm"><span class="font-medium">Cost:</span> {club.cost}</p>}
            {club.who && <p class="mt-2 text-sm text-brand-muted dark:text-brand-muted-dark">Who it suits: {club.who}</p>}
          </article>
        ))}
      </div>
    </section>

    {coaches.length > 0 && (
      <section id="coaches" class="mt-12 scroll-mt-20">
        <h2 class="text-xl font-semibold">Running coaches</h2>
        <div class="mt-4 space-y-4">
          {coaches.map((coach) => (
            <article class="rounded-lg border border-brand-border bg-brand-surface p-5 shadow-sm dark:border-brand-border-dark dark:bg-brand-surface-dark">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-semibold">{coach.name}</h3>
                <a href={coach.url} rel="noopener" target="_blank" class="link-accent inline-block py-1 text-sm">{LINK_LABEL[coach.url_kind]} ↗</a>
              </div>
              <p class="mt-3 text-sm">{coach.description}</p>
              <p class="mt-2 text-sm"><span class="font-medium">Offers:</span> {coach.offers}</p>
              {coach.where && <p class="mt-1 text-sm text-brand-muted dark:text-brand-muted-dark">Where: {coach.where}</p>}
              {coach.credentials && <p class="mt-1 text-sm text-brand-muted dark:text-brand-muted-dark">Credentials: {coach.credentials}</p>}
            </article>
          ))}
        </div>
      </section>
    )}

    {races.length > 0 && (
      <section id="races" class="mt-12 scroll-mt-20">
        <h2 class="text-xl font-semibold">Races coming up in {city.city}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {races.map((entity) => <EntityCard entity={entity} categories={categories} />)}
        </div>
      </section>
    )}

    <p class="mt-12 rounded-lg border border-brand-border bg-brand-surface-offset p-4 text-sm text-brand-muted dark:border-brand-border-dark dark:bg-brand-surface-offset-dark dark:text-brand-muted-dark">
      Schedules change, so check a club's own page before you turn up. Run a club or coach in {city.city} and want
      to be listed, or spotted something out of date? <a href={urls.contact()} class="link-accent">Get in touch</a>.
      Listings were last checked on {city.last_updated}.
    </p>

    <p class="mt-6 text-sm"><a href={urls.clubsIndex()} class="link-accent">← Clubs in other cities</a></p>
  </div>
</BaseLayout>
