---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadClubCities, stripMeta, isPublished } from '../../lib/data.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import { buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

// "Clubs" in the main menu (was "Training" until 6 Nov 2026): running clubs and coaches by city. The
// training, health and gear articles moved to Articles (Alex, Nov 2026), and
// the "Referenced by" list moved there too, with the pieces that cite us.
const cities = siteConfig.enabledFeatures?.clubs
  ? loadClubCities().map(stripMeta).filter(isPublished).sort((a, b) => b.clubs.length - a.clubs.length || a.city.localeCompare(b.city))
  : [];
const totalClubs = cities.reduce((n, c) => n + c.clubs.length, 0);
// Grouped by country (Alex, Nov 2026: "org into countries then cities"), the
// countries with the most clubs first, cities within each as before.
const countryKey = (c) => c.toLowerCase().replace(/[^a-z]+/g, '-');
const byCountry = [...cities.reduce((m, c) => m.set(c.country, [...(m.get(c.country) ?? []), c]), new Map())]
  .map(([country, list]) => ({ country, id: `country-${countryKey(country)}`, cities: list, clubs: list.reduce((n, c) => n + c.clubs.length, 0) }))
  .sort((a, b) => b.clubs - a.clubs || a.country.localeCompare(b.country));
const totalCoaches = cities.reduce((n, c) => n + (c.coaches?.length ?? 0), 0);

const updated = cities.map((c) => c.last_updated).filter((d) => /^\d{4}-\d{2}-\d{2}$/.test(String(d ?? ''))).sort().at(-1);
const breadcrumbItems = [{ label: siteConfig.siteName, href: urls.home() }, { label: 'Clubs' }];
const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)].filter(Boolean);
---

<BaseLayout
  title="Running clubs and coaches in Southeast Asia"
  description={`${totalClubs} running clubs and ${totalCoaches} coaches across ${cities.length} Southeast Asian cities, with where and when each one runs and what it costs.`}
  canonicalPath={urls.clubsIndex()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-4xl font-black leading-[1.05] sm:text-5xl">Clubs and coaches</h1>
    <p class="mt-3 max-w-3xl text-lg">
      Find people to run with and someone to coach you: running clubs and coaches in {cities.length} cities, with
      where and when each one meets.
    </p>
    <div class="mt-2"><LastUpdated date={updated} label="Updated" /></div>

    <section class="mt-10">
      <h2 class="font-serif text-2xl font-extrabold">Find a running club</h2>
      <p class="mt-1 text-sm text-brand-muted dark:text-brand-muted-dark">
        {totalClubs} clubs, run crews and hash groups and {totalCoaches} coaches, with when and where each meets and what it costs. Many are free.
      </p>
      <nav aria-label="Countries" class="mt-4 flex flex-wrap gap-2">
        {byCountry.map((g) => (
          <a href={`#${g.id}`} class="inline-flex min-h-[40px] items-center rounded-full border border-brand-border px-4 text-sm font-semibold transition-colors hover:border-brand-primary dark:border-brand-border-dark">{g.country}</a>
        ))}
      </nav>
      {byCountry.map((g) => (
        <div id={g.id} class="mt-8 scroll-mt-20">
          <h3 class="font-serif text-xl font-extrabold">{g.country} <span class="text-sm font-normal text-brand-muted dark:text-brand-muted-dark">{g.clubs} clubs in {g.cities.length} {g.cities.length === 1 ? 'city' : 'cities'}</span></h3>
          <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {g.cities.map((c) => (
              <a href={urls.clubCity(c.slug)} class="flex flex-col gap-1 rounded-2xl border border-brand-border bg-brand-surface p-5 transition-colors hover:border-brand-primary dark:border-brand-border-dark dark:bg-brand-surface-dark">
                <span class="font-serif text-xl font-extrabold">{c.city}</span>
                <span class="text-sm">{c.clubs.length} clubs{c.coaches?.length ? ` · ${c.coaches.length} ${c.coaches.length === 1 ? 'coach' : 'coaches'}` : ''}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="mt-10">
      <div class="rounded-2xl bg-brand-primary-highlight p-5 sm:p-6 dark:bg-brand-primary-highlight-dark">
        <h2 class="font-serif text-xl font-extrabold">Run a club or coach?</h2>
        <p class="mt-1 text-sm">Get listed for free, or tell us if something is out of date.</p>
        <a href={urls.contact()} class="mt-3 inline-flex min-h-[44px] items-center rounded-lg bg-brand-text px-4 text-sm font-bold text-brand-bg dark:bg-brand-text-dark dark:text-brand-bg-dark">Get in touch</a>
      </div>
    </section>

    {cities.length === 0 && <p class="mt-8 text-brand-muted dark:text-brand-muted-dark">No cities listed yet.</p>}
  </div>
</BaseLayout>
