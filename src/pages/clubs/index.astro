---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadClubCities, loadArticles, loadGear, stripMeta, isPublished } from '../../lib/data.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';
import { TRAINING_TOPICS } from '../../lib/articleTopics.js';

// "Training" in the main menu: running clubs and coaches by city (the
// directory this page has always been), plus the training and health
// articles and the gear guides -- people to run with, then how to train and
// what to wear for the heat.
const cities = siteConfig.enabledFeatures?.clubs
  ? loadClubCities().map(stripMeta).filter(isPublished).sort((a, b) => b.clubs.length - a.clubs.length || a.city.localeCompare(b.city))
  : [];
const totalClubs = cities.reduce((n, c) => n + c.clubs.length, 0);
const totalCoaches = cities.reduce((n, c) => n + (c.coaches?.length ?? 0), 0);

const newest = (a, b) => (b.published_at ?? b.last_updated ?? '').localeCompare(a.published_at ?? a.last_updated ?? '');
const training = siteConfig.enabledFeatures?.articles
  ? loadArticles().map(stripMeta).filter(isPublished).filter((a) => TRAINING_TOPICS.includes(a.topic)).sort(newest)
  : [];
const gear = siteConfig.enabledFeatures?.gear ? loadGear().map(stripMeta).filter(isPublished).sort(newest) : [];

// Sites that reference our club pages (both link to them). Kept here by hand:
// add a row when a new site cites the directory.
const referencedBy = [
  { name: 'Great Runs', what: 'links our club pages from its route guides for nine cities', href: 'https://greatruns.com/location/singapore/' },
  { name: 'The Wellness Insider', what: 'cites our Singapore club directory in its beginner’s guide to running in Singapore', href: 'https://thewellnessinsider.asia/2026/10/running-in-singapore-beginners-clubs-races/' },
];

const breadcrumbItems = [{ label: siteConfig.siteName, href: urls.home() }, { label: 'Training' }];
const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)].filter(Boolean);
const box = 'rounded-2xl border border-brand-border bg-brand-surface p-5 sm:p-6 dark:border-brand-border-dark dark:bg-brand-surface-dark';
---

<BaseLayout
  title="Running clubs, coaches and training for Southeast Asia"
  description={`${totalClubs} running clubs and ${totalCoaches} coaches across ${cities.length} Southeast Asian cities, with where and when each one runs, plus training guides and gear for running in the heat.`}
  canonicalPath={urls.clubsIndex()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-4xl font-black leading-[1.05] sm:text-5xl">Training</h1>
    <p class="mt-3 max-w-3xl text-lg">
      Find people to run with, then train smarter for the heat: running clubs and coaches in {cities.length} cities,
      training guides, and gear for humid long runs.
    </p>

    <section class="mt-10">
      <h2 class="font-serif text-2xl font-extrabold">Find a running club</h2>
      <p class="mt-1 text-sm text-brand-muted dark:text-brand-muted-dark">
        {totalClubs} clubs, run crews and hash groups and {totalCoaches} coaches, with when and where each meets and what it costs. Many are free.
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {cities.map((c) => (
          <a href={urls.clubCity(c.slug)} class="flex flex-col gap-1 rounded-2xl border border-brand-border bg-brand-surface p-5 transition-colors hover:border-brand-primary dark:border-brand-border-dark dark:bg-brand-surface-dark">
            <span class="font-serif text-xl font-extrabold">{c.city}</span>
            <span class="text-sm">{c.clubs.length} clubs{c.coaches?.length ? ` · ${c.coaches.length} ${c.coaches.length === 1 ? 'coach' : 'coaches'}` : ''}</span>
            <span class="text-xs text-brand-muted dark:text-brand-muted-dark">{c.country}</span>
          </a>
        ))}
      </div>
    </section>

    {(training.length > 0 || gear.length > 0) && (
      <section class="mt-12 grid gap-4 lg:grid-cols-2">
        {training.length > 0 && (
          <div class={box}>
            <h2 class="font-serif text-xl font-extrabold">Training guides</h2>
            <ul class="mt-3 space-y-1">
              {training.map((a) => <li><a href={urls.article(a.slug)} class="inline-block py-1 font-semibold hover:underline">{a.title}</a></li>)}
            </ul>
          </div>
        )}
        {gear.length > 0 && (
          <div class={box}>
            <h2 class="font-serif text-xl font-extrabold">Gear for the heat</h2>
            <ul class="mt-3 space-y-1">
              {gear.slice(0, 10).map((g) => <li><a href={urls.gear(g.slug)} class="inline-block py-1 font-semibold hover:underline">{g.title}</a></li>)}
            </ul>
            <a href={urls.gearIndex()} class="link-accent mt-3 inline-block py-1 text-sm font-semibold">All {gear.length} gear guides →</a>
          </div>
        )}
      </section>
    )}

    <section class="mt-4 grid gap-4 lg:grid-cols-2">
      <div class={box}>
        <h2 class="font-serif text-xl font-extrabold">Referenced by</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {referencedBy.map((r) => (
            <li><a href={r.href} rel="noopener" target="_blank" class="font-bold hover:underline">{r.name} ↗</a> <span class="text-brand-muted dark:text-brand-muted-dark">{r.what}.</span></li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl bg-brand-primary-highlight p-5 sm:p-6 dark:bg-brand-primary-highlight-dark">
        <h2 class="font-serif text-xl font-extrabold">Run a club or coach?</h2>
        <p class="mt-1 text-sm">Get listed for free, or tell us if something is out of date.</p>
        <a href={urls.contact()} class="mt-3 inline-flex min-h-[44px] items-center rounded-lg bg-brand-text px-4 text-sm font-bold text-brand-bg dark:bg-brand-text-dark dark:text-brand-bg-dark">Get in touch</a>
      </div>
    </section>

    {cities.length === 0 && <p class="mt-8 text-brand-muted dark:text-brand-muted-dark">No cities listed yet.</p>}
  </div>
</BaseLayout>
