---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadGear, stripMeta, isPublished } from '../../lib/data.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubCard from '../../components/HubCard.astro';
import { buildBreadcrumbListSchema, buildItemListSchema } from '../../lib/schema-jsonld.js';

const articles = loadGear()
  .map(stripMeta)
  .filter(isPublished)
  .sort((a, b) => (b.published_at ?? b.last_updated).localeCompare(a.published_at ?? a.last_updated));

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Gear' },
];

const jsonLd = [
  buildBreadcrumbListSchema(breadcrumbItems, Astro.site),
  buildItemListSchema(articles, Astro.site, (a) => urls.gear(a.slug), (a) => a.title),
].filter(Boolean);
---

<BaseLayout
  title="Gear -- Running Gear Guides for Southeast Asia"
  description={`Gear picks and buying guides from ${siteConfig.siteName}, tuned for Southeast Asia's heat, humidity and pre-dawn race starts.`}
  canonicalPath={urls.gearIndex()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Gear</h1>
    <p class="mt-3 max-w-2xl text-brand-muted dark:text-brand-muted-dark">
      Buying guides and gear picks tuned for running in Southeast Asia -- humid long-distance conditions,
      pre-dawn starts, and everything in between.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {articles.map((article) => (
        <HubCard href={urls.gear(article.slug)} label={article.title} description={article.dek} />
      ))}
    </div>

    {articles.length === 0 && (
      <p class="mt-8 text-brand-muted dark:text-brand-muted-dark">No gear guides published yet -- check back soon.</p>
    )}
  </div>
</BaseLayout>
