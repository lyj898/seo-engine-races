---
import siteConfig from '../lib/config.js';
import { urls } from '../lib/urls.js';
import { splitAccentWord, formatMonthLabel, monthKey, humanizeStatus, isLikelyRegistrationOpen } from '../lib/text.js';
import { loadEntities, loadCategories, loadRegions, loadListicles, stripMeta } from '../lib/data.js';
import { matchCategoryByValue } from '../lib/categoryMatch.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import HubCard from '../components/HubCard.astro';
import EntityCard from '../components/EntityCard.astro';
import StatsSummary from '../components/StatsSummary.astro';
import HeroStats from '../components/HeroStats.astro';
import SearchBox from '../components/SearchBox.astro';
import FAQSection from '../components/FAQSection.astro';
import DateBadge from '../components/DateBadge.astro';
import ValuePills from '../components/ValuePills.astro';
import { buildWebsiteSchema, buildFaqPageSchema } from '../lib/schema-jsonld.js';

const entities = loadEntities().map(stripMeta).filter((e) => e.status === 'active');
const categories = loadCategories().map(stripMeta).filter((c) => c.status === 'active');
const regions = loadRegions().map(stripMeta).filter((r) => r.status === 'active');
const listicles = loadListicles().map(stripMeta).filter((l) => l.status === 'active');

// Only top-level regions on the homepage (e.g. "Thailand", not "Nong Khai")
// -- child regions are reached by drilling down from their parent's hub.
const topLevelRegions = regions.filter((r) => !r.parent_region_id);
const regionsById = new Map(regions.map((r) => [r.region_id, r]));

// Resolves any region (including a child region like "Nong Khai") up to its
// top-level country ancestor, so a race tagged with a city-level region
// still filters correctly under its country in the country dropdown below.
function topLevelCountryId(regionId) {
  let current = regionsById.get(regionId);
  let guard = 0;
  while (current?.parent_region_id && guard < 10) {
    current = regionsById.get(current.parent_region_id);
    guard++;
  }
  return current?.region_id ?? regionId;
}

const stats = [
  { label: `Verified ${siteConfig.entityLabelPlural}`, value: entities.length },
  { label: siteConfig.categoryLabelPlural ?? siteConfig.categoryLabel + 's', value: categories.length },
  { label: siteConfig.regionLabelPlural ?? siteConfig.regionLabel + 's', value: topLevelRegions.length },
];

// A vertical is "date-driven" when every active entity carries a
// core_facts.date -- generic check, not races-specific, so any other
// date-anchored vertical (events, courses with a start date) gets the same
// calendar-style homepage automatically, while verticals without dates
// (hotels, local services) fall back to the reliability-sorted grid below.
const isDateDriven = entities.length > 0 && entities.every((e) => typeof e.core_facts?.date === 'string');

const sortedByDate = isDateDriven
  ? [...entities].sort((a, b) => (a.core_facts.date < b.core_facts.date ? -1 : a.core_facts.date > b.core_facts.date ? 1 : 0))
  : [];

const monthGroups = [];
for (const entity of sortedByDate) {
  const key = monthKey(entity.core_facts.date);
  let group = monthGroups.find((g) => g.key === key);
  if (!group) {
    group = { key, label: formatMonthLabel(entity.core_facts.date), entities: [] };
    monthGroups.push(group);
  }
  group.entities.push(entity);
}

// Distinct months present, in chronological order, for the month filter.
const monthOptions = monthGroups.map((g) => ({ value: g.key, label: g.label }));

// Country filter options, alphabetical for a predictable dropdown.
const countryOptions = [...topLevelRegions].sort((a, b) => a.label.localeCompare(b.label));

// Quick-toggle distance chips: only categories a vertical has flagged as
// "marquee" via badgeVariant (schema/base.js) get a dedicated chip -- for
// races that's Half/Full Marathon -- everything else is still reachable via
// the calendar itself. Falls back to showing nothing if no category is
// flagged, which just leaves the "All" toggle.
const quickDistanceCategories = categories.filter((c) => c.badgeVariant && c.badgeVariant !== 'neutral');

const featured = [...entities].sort((a, b) => b.reliability_score - a.reliability_score).slice(0, 6);

// Hero headline: site.config.json.heroHeadline marks one word with
// *asterisks*; that word renders with the outlined "stroke" treatment from
// the reference design, everything else renders plain. Falls back to
// siteName if heroHeadline isn't set.
const { before: headlineBefore, accent: headlineAccent, after: headlineAfter } = splitAccentWord(
  siteConfig.heroHeadline ?? siteConfig.siteName
);

const heroStats = [
  { value: entities.length, label: `${siteConfig.entityLabelPlural} tracked` },
  { value: topLevelRegions.length, label: siteConfig.regionLabelPlural ?? `${siteConfig.regionLabel}s` },
  { value: monthOptions.length || categories.length, label: isDateDriven ? 'months ahead' : `${siteConfig.categoryLabel}s` },
];

const faqs = [
  {
    question: `How do you verify each ${siteConfig.entityLabelSingular}?`,
    answer: `Every ${siteConfig.entityLabelSingular} listed here is cross-checked against multiple independent sources -- official websites, aggregators, and other public records -- on a best-effort basis before it's published, and each entry shows the date it was last checked.`,
  },
  {
    question: 'How often is this data refreshed?',
    answer: `Listings are re-checked on a regular schedule (roughly every ${siteConfig.sourceConfig?.refreshIntervalDays ?? 7} days) against their original sources, and updated automatically when something changes. If a fact can no longer be verified, the listing is flagged for review rather than silently keeping stale information.`,
  },
];

const jsonLd = [
  buildWebsiteSchema(siteConfig, Astro.site),
  ...(siteConfig.enabledFeatures?.faqSchema ? [buildFaqPageSchema(faqs)] : []),
].filter(Boolean);
---

<BaseLayout description={siteConfig.siteTagline} canonicalPath={urls.home()} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <section class="mx-auto max-w-3xl border-b border-brand-divider pb-10 dark:border-brand-divider-dark sm:pb-14">
      <h1 class="text-[clamp(2.1rem,1rem+4.5vw,4.2rem)] font-black leading-[1.05]">
        {headlineBefore}
        {headlineAccent && (
          <em class="not-italic text-transparent [-webkit-text-stroke:2px_theme(colors.brand.text)] dark:[-webkit-text-stroke:2px_theme(colors.brand.text-dark)]">
            {headlineAccent}
          </em>
        )}
        {headlineAfter}
      </h1>

      <div class="mt-8">
        <HeroStats stats={heroStats} />
      </div>

      {isDateDriven ? (
        <div class="relative max-w-[540px]">
          <svg
            class="pointer-events-none absolute left-[1.1rem] top-1/2 h-5 w-5 -translate-y-1/2 text-brand-faint dark:text-brand-faint-dark"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <input
            type="text"
            id="race-search-input"
            class="w-full rounded-lg border-[1.5px] border-brand-border bg-brand-surface py-4 pl-[3.1rem] pr-5 text-base shadow-sm transition-shadow duration-200 ease-interactive placeholder:text-brand-faint focus:border-brand-primary focus:shadow-[0_0_0_4px_theme(colors.brand.primary-highlight)] focus:outline-none dark:border-brand-border-dark dark:bg-brand-surface-dark dark:placeholder:text-brand-faint-dark dark:focus:shadow-[0_0_0_4px_theme(colors.brand.primary-highlight-dark)]"
            placeholder={`Search by ${siteConfig.entityLabelSingular} name or city...`}
            aria-label={`Search by ${siteConfig.entityLabelSingular} name or city...`}
          />
        </div>
      ) : (
        <SearchBox targetSelector="#featured-grid [data-filterable]" placeholder={`Search by ${siteConfig.entityLabelSingular} name...`} />
      )}
    </section>

    {isDateDriven ? (
      <section class="mt-10" id="race-calendar">
        <div
          id="race-filters"
          class="mb-6 flex flex-wrap items-center gap-2 border-b border-brand-divider pb-6 dark:border-brand-divider-dark"
        >
          <select
            id="filter-country"
            aria-label={`All ${(siteConfig.regionLabelPlural ?? siteConfig.regionLabel + 's').toLowerCase()}`}
            class="filter-select rounded-full border border-brand-border bg-brand-surface px-3.5 py-2 text-sm font-semibold dark:border-brand-border-dark dark:bg-brand-surface-dark"
          >
            <option value="">All {(siteConfig.regionLabelPlural ?? siteConfig.regionLabel + 's').toLowerCase()}</option>
            {countryOptions.map((c) => <option value={c.region_id}>{c.label}</option>)}
          </select>

          <select
            id="filter-month"
            aria-label="All upcoming months"
            class="filter-select rounded-full border border-brand-border bg-brand-surface px-3.5 py-2 text-sm font-semibold dark:border-brand-border-dark dark:bg-brand-surface-dark"
          >
            <option value="">All upcoming months</option>
            {monthOptions.map((m) => <option value={m.value}>{m.label}</option>)}
          </select>

          <div class="inline-flex flex-wrap gap-0.5 rounded-full bg-brand-surface-offset p-[3px] dark:bg-brand-surface-offset-dark">
            <button type="button" data-distance-value="" class="distance-chip is-active rounded-full px-3.5 py-2 text-sm font-semibold text-brand-muted transition-colors dark:text-brand-muted-dark">
              All distances
            </button>
            {quickDistanceCategories.map((c) => (
              <button type="button" data-distance-value={c.category_id} class="distance-chip rounded-full px-3.5 py-2 text-sm font-semibold text-brand-muted transition-colors dark:text-brand-muted-dark">
                {c.label}
              </button>
            ))}
          </div>

          <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-brand-border px-3.5 py-2 text-sm font-semibold dark:border-brand-border-dark">
            <input type="checkbox" id="filter-open-only" class="h-4 w-4 rounded border-brand-border accent-brand-primary dark:border-brand-border-dark" />
            Open for registration
          </label>

          <button type="button" id="filter-reset" class="ml-auto text-sm font-bold underline-offset-2 hover:underline">
            Reset
          </button>
        </div>

        <p id="race-count" class="mb-6 text-sm text-brand-muted dark:text-brand-muted-dark">
          {entities.length} {siteConfig.entityLabelPlural} found
        </p>

        {monthGroups.map((group) => (
          <div class="month-group mb-10" data-month-group={group.key}>
            <h2 class="mb-4 border-b border-brand-divider pb-3 text-lg font-bold dark:border-brand-divider-dark">{group.label}</h2>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.entities.map((entity) => {
                const matchedCategoryIds = [
                  ...new Set(
                    [
                      entity.category_id,
                      ...(entity.core_facts.distance_km ?? [])
                        .map((km) => matchCategoryByValue(km, categories)?.category_id)
                        .filter(Boolean),
                    ]
                  ),
                ];
                const countryId = topLevelCountryId(entity.region_id);
                const regOpen = isLikelyRegistrationOpen(entity.core_facts.registration_status);
                const locationLine = [entity.core_facts.city, entity.core_facts.country].filter(Boolean).join(', ');
                const searchText = `${entity.name} ${locationLine}`.toLowerCase();

                return (
                  <div
                    data-filterable
                    data-search={searchText}
                    data-country={countryId}
                    data-month={group.key}
                    data-distances={matchedCategoryIds.join(',')}
                    data-reg-open={String(regOpen)}
                    class="flex gap-4 rounded-lg border border-brand-border bg-brand-surface p-4 shadow-sm dark:border-brand-border-dark dark:bg-brand-surface-dark"
                  >
                    <DateBadge date={entity.core_facts.date} />
                    <div class="min-w-0 flex-1">
                      <div class="flex items-start justify-between gap-2">
                        <a href={urls.entity(entity.slug)} class="font-semibold hover:underline">{entity.name}</a>
                      </div>
                      {locationLine && <p class="mt-0.5 text-sm text-brand-muted dark:text-brand-muted-dark">{locationLine}</p>}

                      <ValuePills
                        class="mt-3"
                        values={entity.core_facts.distance_km ?? []}
                        categories={categories}
                        unit="km"
                      />

                      <div class="mt-3 flex items-center justify-between gap-3">
                        {entity.core_facts.registration_status && (
                          <span class="text-xs text-brand-muted dark:text-brand-muted-dark">
                            &bull; {humanizeStatus(entity.core_facts.registration_status)}
                          </span>
                        )}
                        <a href={urls.entity(entity.slug)} class="ml-auto shrink-0 text-sm font-bold link-accent">Details &rarr;</a>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}

        <p id="race-empty-state" class="hidden py-10 text-center text-brand-muted dark:text-brand-muted-dark">
          No {siteConfig.entityLabelPlural} match these filters. Try clearing a filter or two.
        </p>
      </section>
    ) : (
      featured.length > 0 && (
        <section class="mt-10">
          <h2 class="mb-4 text-xl font-semibold">Highest-verified {siteConfig.entityLabelPlural}</h2>
          <div id="featured-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {featured.map((entity) => <EntityCard entity={entity} />)}
          </div>
        </section>
      )
    )}

    <section class="mt-14">
      <StatsSummary stats={stats} />
    </section>

    {topLevelRegions.length > 0 && (
      <section class="mt-14">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-xl font-semibold">Browse by {siteConfig.regionLabel.toLowerCase()}</h2>
          <a href={urls.regionsIndex()} class="text-sm link-accent">View all</a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {topLevelRegions.map((region) => (
            <HubCard
              href={urls.region(region.slug)}
              label={region.label}
              description={region.short_description}
              count={entities.filter((e) => e.region_id === region.region_id).length}
            />
          ))}
        </div>
      </section>
    )}

    {categories.length > 0 && (
      <section class="mt-14">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-xl font-semibold">Browse by {siteConfig.categoryLabel.toLowerCase()}</h2>
          <a href={urls.categoriesIndex()} class="text-sm link-accent">View all</a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {categories.map((category) => (
            <HubCard
              href={urls.category(category.slug)}
              label={category.label}
              description={category.short_description}
              count={entities.filter((e) => e.category_id === category.category_id).length}
            />
          ))}
        </div>
      </section>
    )}

    {siteConfig.enabledFeatures?.listicles && listicles.length > 0 && (
      <section class="mt-14">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-xl font-semibold">Best Of guides</h2>
          <a href={urls.listiclesIndex()} class="text-sm link-accent">View all</a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {listicles.map((listicle) => (
            <HubCard href={urls.listicle(listicle.slug)} label={listicle.title} description={listicle.intro} />
          ))}
        </div>
      </section>
    )}

    <section class="mt-16">
      <FAQSection faqs={faqs} />
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var root = document.getElementById('race-calendar');
    if (!root) return;

    var searchInput = document.getElementById('race-search-input');
    var countrySelect = document.getElementById('filter-country');
    var monthSelect = document.getElementById('filter-month');
    var openOnlyCheckbox = document.getElementById('filter-open-only');
    var resetButton = document.getElementById('filter-reset');
    var countEl = document.getElementById('race-count');
    var emptyStateEl = document.getElementById('race-empty-state');
    var distanceChips = root.querySelectorAll('.distance-chip');
    var activeDistance = '';

    function apply() {
      var query = (searchInput && searchInput.value.trim().toLowerCase()) || '';
      var country = (countrySelect && countrySelect.value) || '';
      var month = (monthSelect && monthSelect.value) || '';
      var openOnly = !!(openOnlyCheckbox && openOnlyCheckbox.checked);

      var visibleCount = 0;
      var cards = root.querySelectorAll('[data-filterable]');
      cards.forEach(function (card) {
        var matchesSearch = !query || (card.dataset.search || '').indexOf(query) !== -1;
        var matchesCountry = !country || card.dataset.country === country;
        var matchesMonth = !month || card.dataset.month === month;
        var matchesDistance = !activeDistance || (card.dataset.distances || '').split(',').indexOf(activeDistance) !== -1;
        var matchesOpen = !openOnly || card.dataset.regOpen === 'true';
        var show = matchesSearch && matchesCountry && matchesMonth && matchesDistance && matchesOpen;
        card.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      root.querySelectorAll('.month-group').forEach(function (group) {
        var anyVisible = Array.prototype.some.call(group.querySelectorAll('[data-filterable]'), function (c) {
          return c.style.display !== 'none';
        });
        group.style.display = anyVisible ? '' : 'none';
      });

      if (countEl) {
        // .trim() first: Astro's JSX-style {expr} interpolation preserves
        // the source's surrounding whitespace/newlines as literal text
        // nodes, so textContent can start with "\n  " before the digits --
        // an untrimmed ^[\d,]+ regex would silently fail to match that and
        // leave the old number in place, prepending instead of replacing.
        var label = countEl.textContent.trim().replace(/^[\d,]+/, '').trim();
        countEl.textContent = visibleCount + ' ' + label;
      }
      if (emptyStateEl) emptyStateEl.classList.toggle('hidden', visibleCount !== 0);
    }

    if (searchInput) searchInput.addEventListener('input', apply);
    if (countrySelect) countrySelect.addEventListener('change', apply);
    if (monthSelect) monthSelect.addEventListener('change', apply);
    if (openOnlyCheckbox) openOnlyCheckbox.addEventListener('change', apply);

    distanceChips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        activeDistance = chip.dataset.distanceValue || '';
        distanceChips.forEach(function (c) {
          c.classList.toggle('is-active', c === chip);
        });
        apply();
      });
    });

    if (resetButton) {
      resetButton.addEventListener('click', function () {
        if (searchInput) searchInput.value = '';
        if (countrySelect) countrySelect.value = '';
        if (monthSelect) monthSelect.value = '';
        if (openOnlyCheckbox) openOnlyCheckbox.checked = false;
        activeDistance = '';
        distanceChips.forEach(function (c, i) {
          c.classList.toggle('is-active', i === 0);
        });
        apply();
      });
    }
  })();
</script>
