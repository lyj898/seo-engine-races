---
import siteConfig from '../lib/config.js';
import { urls } from '../lib/urls.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { buildBreadcrumbListSchema } from '../lib/schema-jsonld.js';

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Privacy Policy', href: urls.privacy() },
];

const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)].filter(Boolean);
---

<BaseLayout
  title="Privacy Policy"
  description={`Privacy policy for ${siteConfig.siteName}.`}
  canonicalPath={urls.privacy()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Privacy Policy</h1>

    <div class="prose-content mt-8 space-y-4">
      <p class="rounded-lg border border-brand-border bg-brand-surface p-4 text-sm dark:border-brand-border-dark dark:bg-brand-surface-dark">
        This is a starting-point template, not legal advice. Have this reviewed by a qualified professional for your
        jurisdiction and business before relying on it, and update the placeholders below with your actual practices.
      </p>

      <h2 class="text-xl font-semibold">What we collect</h2>
      <p>
        {siteConfig.siteName} is a static site. We do not require accounts, logins, or personal information to browse
        listings. If you contact us at {siteConfig.contactEmail}, we retain your message and email address only to
        respond to you.
      </p>

      <h2 class="text-xl font-semibold">Analytics and cookies</h2>
      <p>
        {siteConfig.googleAnalyticsId ? (
          <>
            We use Google Analytics to understand aggregate traffic patterns (e.g. which pages are visited and how
            often). Google Analytics may set cookies and collect information such as your IP address, browser, and
            device type; this is aggregate usage data, not used to personally identify you. You can opt out using the
            {' '}<a href="https://tools.google.com/dlpage/gaoptout" class="link-accent">Google Analytics Opt-out Browser Add-on</a>{' '}
            or by adjusting your browser's cookie settings. See Google's own{' '}
            <a href="https://policies.google.com/privacy" class="link-accent">privacy policy</a> for how it handles this data.
          </>
        ) : (
          <>
            We may use privacy-conscious analytics to understand aggregate traffic patterns (e.g. which pages are
            visited). If analytics or advertising cookies are added in the future, this section should be updated to
            name the specific service(s) used and how visitors can opt out.
          </>
        )}
      </p>

      <h2 class="text-xl font-semibold">External links</h2>
      <p>
        Listings link out to official websites, registration or booking platforms, and other third-party sources.
        Once you leave {siteConfig.siteName}, that site's own privacy policy applies -- we don't control and aren't
        responsible for third-party sites' practices.
      </p>

      <h2 class="text-xl font-semibold">Contact</h2>
      <p>
        Questions about this policy can be sent to <a href={`mailto:${siteConfig.contactEmail}`} class="link-accent">{siteConfig.contactEmail}</a>.
      </p>
    </div>
  </div>
</BaseLayout>
