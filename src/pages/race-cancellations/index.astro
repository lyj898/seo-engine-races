---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadEntities, stripMeta, isReviewableEntity } from '../../lib/data.js';
import { formatLongDate, formatMonthLabel } from '../../lib/text.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import { buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

// Every race whose record says it was called off (core_facts.event_status),
// newest first. Built straight from the race data, so marking a race
// cancelled or postponed adds it here on the next deploy -- nothing to keep
// in sync by hand. The cause is read from the organiser's reason as stored
// in event_status_note; anything that doesn't name haze or a flood is shown
// as the reason the organiser gave, never guessed.
const enabled = Boolean(siteConfig.enabledFeatures?.cancellations);
const halted = enabled
  ? loadEntities()
      .map(stripMeta)
      .filter(isReviewableEntity)
      .filter((e) => e.core_facts?.event_status && /^\d{4}-\d{2}-\d{2}$/.test(e.core_facts?.date ?? ''))
      .sort((a, b) => b.core_facts.date.localeCompare(a.core_facts.date))
  : [];

const causeOf = (note = '') =>
  /haze|air quality|air pollutant|jerebu/i.test(note) ? 'Haze or poor air quality' : /flood/i.test(note) ? 'Flood' : 'Other or not stated';
// The best citation a record holds: its first non-aggregator source (news
// report, organiser site or entry page), else the race's official link.
const sourceOf = (e) => {
  const s = (e.source_mix ?? []).find((x) => x.type !== 'aggregator' && x.url);
  return s?.url ?? e.cta_links?.[0]?.url ?? null;
};

const rows = halted.map((e) => ({
  slug: e.slug,
  name: e.name,
  date: e.core_facts.date,
  dateLabel: formatLongDate(e.core_facts.date),
  place: [e.core_facts.city, e.core_facts.country].filter(Boolean).join(', '),
  country: e.core_facts.country,
  status: e.core_facts.event_status === 'postponed' ? 'Postponed' : 'Cancelled',
  cause: causeOf(e.core_facts.event_status_note),
  virtual: /virtual run/i.test(e.core_facts.event_status_note ?? ''),
  note: e.core_facts.event_status_note ?? '',
  source: sourceOf(e),
  updated: e.last_updated,
}));

const byCause = rows.reduce((m, r) => ((m[r.cause] = (m[r.cause] ?? 0) + 1), m), {});
const byCountry = Object.entries(rows.reduce((m, r) => ((m[r.country] = (m[r.country] ?? 0) + 1), m), {})).sort((a, b) => b[1] - a[1]);
const months = [...new Set(rows.map((r) => r.date.slice(0, 7)))];
const lastUpdated = rows.map((r) => r.updated).filter(Boolean).sort().at(-1);
const year = rows[0]?.date.slice(0, 4) ?? '';

const title = `Races cancelled or postponed in Southeast Asia, ${year}`;
const description = `${rows.length} half and full marathons in Southeast Asia called off in ${year}, ${byCause['Haze or poor air quality'] ?? 0} of them because of haze or poor air quality, with each organiser's reason and a source.`;
const breadcrumbItems = [{ label: siteConfig.siteName, href: urls.home() }, { label: 'Race cancellations' }];
const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)].filter(Boolean);
const pill = 'rounded-full px-2.5 py-0.5 text-xs font-semibold';
---

<BaseLayout title={title} description={description} canonicalPath={urls.cancellations()} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">{title}</h1>
    <p class="mt-4 max-w-2xl">
      Every half and full marathon on our calendar that was called off this year, with the organiser's reason and a
      source for each. Haze from regional fires caused most of them. The list updates whenever we learn a race won't run.
    </p>
    <div class="mt-3"><LastUpdated date={lastUpdated} label="Last updated" /></div>

    {rows.length > 0 && (
      <dl class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-lg border border-brand-border bg-brand-surface p-4 dark:border-brand-border-dark dark:bg-brand-surface-dark">
          <dt class="text-xs font-semibold uppercase tracking-wide text-brand-muted dark:text-brand-muted-dark">Races called off</dt>
          <dd class="mt-1 font-serif text-3xl font-black">{rows.length}</dd>
        </div>
        <div class="rounded-lg border border-brand-border bg-brand-surface p-4 dark:border-brand-border-dark dark:bg-brand-surface-dark">
          <dt class="text-xs font-semibold uppercase tracking-wide text-brand-muted dark:text-brand-muted-dark">Haze or air quality</dt>
          <dd class="mt-1 font-serif text-3xl font-black">{byCause['Haze or poor air quality'] ?? 0}</dd>
        </div>
        <div class="rounded-lg border border-brand-border bg-brand-surface p-4 dark:border-brand-border-dark dark:bg-brand-surface-dark">
          <dt class="text-xs font-semibold uppercase tracking-wide text-brand-muted dark:text-brand-muted-dark">Became virtual runs</dt>
          <dd class="mt-1 font-serif text-3xl font-black">{rows.filter((r) => r.virtual).length}</dd>
        </div>
        <div class="rounded-lg border border-brand-border bg-brand-surface p-4 dark:border-brand-border-dark dark:bg-brand-surface-dark">
          <dt class="text-xs font-semibold uppercase tracking-wide text-brand-muted dark:text-brand-muted-dark">Postponed</dt>
          <dd class="mt-1 font-serif text-3xl font-black">{rows.filter((r) => r.status === 'Postponed').length}</dd>
        </div>
      </dl>
    )}

    {byCountry.length > 0 && (
      <p class="mt-4 text-sm text-brand-muted dark:text-brand-muted-dark">
        By country: {byCountry.map(([c, n]) => `${c} ${n}`).join(' · ')}
      </p>
    )}

    {months.map((m) => (
      <section class="mt-10">
        <h2 class="border-b border-brand-divider pb-2 text-lg font-bold dark:border-brand-divider-dark">{formatMonthLabel(`${m}-01`)}</h2>
        <ul class="mt-4 space-y-4">
          {rows.filter((r) => r.date.startsWith(m)).map((r) => (
            <li class="rounded-lg border border-brand-border bg-brand-surface p-5 dark:border-brand-border-dark dark:bg-brand-surface-dark">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="font-semibold"><a href={urls.entity(r.slug)} class="link-accent">{r.name}</a></h3>
                <span class="text-sm text-brand-muted dark:text-brand-muted-dark">{r.dateLabel}</span>
              </div>
              <p class="mt-1 text-sm text-brand-muted dark:text-brand-muted-dark">{r.place}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                <span class={`${pill} ${r.status === 'Postponed' ? 'bg-brand-warning-highlight text-brand-warning dark:bg-brand-warning-highlight-dark dark:text-brand-warning-dark' : 'bg-brand-surface-offset text-brand-text dark:bg-brand-surface-offset-dark dark:text-brand-text-dark'}`}>{r.status}</span>
                <span class={`${pill} bg-brand-surface-offset text-brand-muted dark:bg-brand-surface-offset-dark dark:text-brand-muted-dark`}>{r.cause}</span>
                {r.virtual && <span class={`${pill} bg-brand-primary-highlight text-brand-text dark:bg-brand-primary-highlight-dark dark:text-brand-text-dark`}>Now a virtual run</span>}
              </div>
              <p class="mt-3 text-sm">{r.note}</p>
              {r.source && (
                <p class="mt-2 text-sm"><a href={r.source} rel="noopener" target="_blank" class="link-accent inline-block py-1">Source ↗</a></p>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}

    {rows.length === 0 && <p class="mt-8 text-brand-muted dark:text-brand-muted-dark">No cancellations recorded.</p>}

    <p class="mt-12 rounded-lg border border-brand-border bg-brand-surface-offset p-4 text-sm text-brand-muted dark:border-brand-border-dark dark:bg-brand-surface-offset-dark dark:text-brand-muted-dark">
      Journalists are welcome to use these figures; please credit {siteConfig.siteName} and link to this page.
      Know of a race we've missed? <a href={urls.contact()} class="link-accent">Tell us</a>.
    </p>
  </div>
</BaseLayout>
