---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import {
  loadEntities,
  loadRegions,
  stripMeta,
  isPublished,
  buildRegionEntityCounts,
  regionHasEntities,
} from '../../lib/data.js';
import { isLapsed } from '../../lib/succession.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubCard from '../../components/HubCard.astro';
import { buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

const regions = loadRegions().map(stripMeta).filter(isPublished);
// Lapse-filtered like every other listing surface (homepage, region hubs):
// refresh-entities.js only archives a finished race weekly, so between runs
// isPublished still admits races that have already been run. Left unfiltered,
// this hub presents them in the grid under an upcoming-looking date badge.
// Their own pages stay live; the region hubs list them under Past races.
const entities = loadEntities().map(stripMeta).filter(isPublished).filter((e) => !isLapsed(e));
const regionCounts = buildRegionEntityCounts(regions, entities);

// Only top-level regions here -- child regions are reached by drilling down
// from their parent's hub page, keeping this index page uncluttered -- and
// only ones with something to list (regionHasEntities, src/lib/data.js).
const topLevelRegions = regions.filter((r) => !r.parent_region_id && regionHasEntities(r, regionCounts));

const regionLabelPlural = siteConfig.regionLabelPlural ?? `${siteConfig.regionLabel}s`;

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: `All ${regionLabelPlural}`, href: urls.regionsIndex() },
];

const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)].filter(Boolean);
---

<BaseLayout
  title={`All ${regionLabelPlural}`}
  description={`Every ${siteConfig.regionLabel.toLowerCase()} covered by ${siteConfig.siteName}.`}
  canonicalPath={urls.regionsIndex()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">All {regionLabelPlural}</h1>
    <p class="mt-3 max-w-2xl text-brand-muted dark:text-brand-muted-dark">
      Browse every {siteConfig.entityLabelSingular} on {siteConfig.siteName} grouped by {siteConfig.regionLabel.toLowerCase()}.
    </p>

    {topLevelRegions.length > 0 ? (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {topLevelRegions.map((region) => (
          <HubCard
            href={urls.region(region.slug)}
            label={region.label}
            description={region.short_description}
            count={regionCounts.get(region.region_id) ?? 0}
          />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-brand-muted dark:text-brand-muted-dark">No regions published yet.</p>
    )}
  </div>
</BaseLayout>
