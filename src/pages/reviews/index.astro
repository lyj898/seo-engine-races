---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadReviews, loadEntities, stripMeta, isPublished } from '../../lib/data.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

const entities = loadEntities().map(stripMeta).filter(isPublished);
const entityById = new Map(entities.map((e) => [e.entity_id, e]));

// Order strictly newest-first by publish timestamp (falling back to the
// date-only last_updated for older pre-timestamp reviews). An ISO datetime
// sorts after a bare same-day date, so freshly-stamped articles rise above
// same-date older ones -- which is exactly what we want.
const orderKey = (r) => String(r.published_at ?? r.last_updated ?? '');
const reviews = loadReviews()
  .map(stripMeta)
  .filter(isPublished)
  .filter((r) => entityById.has(r.entity_id))
  .sort((a, b) => orderKey(b).localeCompare(orderKey(a)));

// Flag the just-published articles so the two-a-day cadence is easy to spot.
// Only timestamped reviews within the last 26h qualify (comfortably spans the
// two 12h-apart runs of a day; older/pre-timestamp reviews never show "New").
const now = Date.now();
const isNew = (r) => {
  const t = Date.parse(r.published_at ?? '');
  return Number.isFinite(t) && now - t < 26 * 60 * 60 * 1000;
};
const fmtDate = (r) => {
  const t = Date.parse(r.published_at ?? r.last_updated ?? '');
  return Number.isFinite(t)
    ? new Date(t).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
    : null;
};

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Reviews', href: urls.reviewsIndex() },
];

const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)];
---

<BaseLayout
  title="Race reviews"
  description={`In-depth, independent reviews of ${siteConfig.entityLabelPlural} drawn from real participant reports.`}
  canonicalPath={urls.reviewsIndex()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Race reviews</h1>
    <p class="mt-3 text-lg text-brand-muted dark:text-brand-muted-dark">
      In-depth reviews built from real participant race reports and coverage — what a race is actually like to run,
      with every claim linked back to its source.
    </p>

    {reviews.length === 0 ? (
      <p class="mt-10 text-brand-muted dark:text-brand-muted-dark">No reviews published yet — check back soon.</p>
    ) : (
      <ul class="mt-8 divide-y divide-brand-border dark:divide-brand-border-dark">
        {reviews.map((review) => {
          const entity = entityById.get(review.entity_id);
          const facts = entity.core_facts ?? {};
          const loc = [facts.city, facts.country].filter(Boolean).join(', ');
          return (
            <li class="py-5">
              <a href={urls.review(review.slug)} class="group block">
                <div class="flex items-center gap-2">
                  {isNew(review) && (
                    <span class="rounded-full bg-brand-primary px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-wide text-brand-primary-ink dark:text-brand-primary-ink-dark">
                      New
                    </span>
                  )}
                  {fmtDate(review) && (
                    <span class="text-xs text-brand-muted dark:text-brand-muted-dark">{fmtDate(review)}</span>
                  )}
                </div>
                <h2 class="mt-1 text-xl font-semibold group-hover:text-brand-primary">{review.title}</h2>
                <p class="mt-1.5 text-sm text-brand-muted dark:text-brand-muted-dark">{review.dek}</p>
                {loc && <p class="mt-1.5 text-xs text-brand-muted dark:text-brand-muted-dark">{loc}</p>}
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</BaseLayout>
