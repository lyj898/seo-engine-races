---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import {
  loadReviews,
  loadEntities,
  loadRegions,
  stripMeta,
  isPublished,
  isReviewableEntity,
  buildRegionAncestryMap,
} from '../../lib/data.js';
import { isLapsed } from '../../lib/succession.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

const entities = loadEntities().map(stripMeta).filter(isReviewableEntity);
const entityById = new Map(entities.map((e) => [e.entity_id, e]));

const orderKey = (r) => String(r.published_at ?? r.last_updated ?? '');
const reviews = loadReviews()
  .map(stripMeta)
  .filter(isPublished)
  .filter((r) => entityById.has(r.entity_id))
  .sort((a, b) => orderKey(b).localeCompare(orderKey(a)));

const now = Date.now();
const isNew = (r) => {
  const t = Date.parse(r.published_at ?? '');
  return Number.isFinite(t) && now - t < 26 * 60 * 60 * 1000;
};
const fmtDate = (r) => {
  const t = Date.parse(r.published_at ?? r.last_updated ?? '');
  return Number.isFinite(t)
    ? new Date(t).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
    : null;
};

// Country filter. An entity's region_id can be a sub-region (e.g. "Nong
// Khai" under "Thailand"), so walk each entity's ancestry chain to find its
// country-granularity ancestor rather than assuming region_id already is
// one -- otherwise a sub-region entity would show a chip for its country
// (via the ancestry match below) that its own data-country attribute could
// never actually match, silently hiding it under every filter.
const regions = loadRegions().map(stripMeta);
const regionById = new Map(regions.map((r) => [r.region_id, r]));
const ancestryMap = buildRegionAncestryMap(regions);
const countryIdForEntity = (entity) => {
  const chain = ancestryMap.get(entity.region_id) ?? [entity.region_id];
  return chain.find((id) => regionById.get(id)?.granularity === 'country') ?? null;
};

const countryRegions = regions
  .filter((r) => r.granularity === 'country')
  .filter((r) => reviews.some((rv) => countryIdForEntity(entityById.get(rv.entity_id)) === r.region_id))
  .sort((a, b) => a.label.localeCompare(b.label))
  .map((r) => ({ label: r.label, value: r.region_id }));

// With mergedReviews on, a review's body lives on its entity page and
// /reviews/<slug>/ is only a redirect -- so this index links straight to the
// real page rather than bouncing every reader (and crawler) through a hop.
const reviewHref = (review, entity) =>
  siteConfig.enabledFeatures?.mergedReviews ? urls.entity(entity.slug) : urls.review(review.slug);

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Reviews', href: urls.reviewsIndex() },
];

const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)];
---

<BaseLayout
  title="Race reviews"
  description={`In-depth, independent reviews of ${siteConfig.entityLabelPlural} drawn from real participant reports.`}
  canonicalPath={urls.reviewsIndex()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Race reviews</h1>
    <p class="mt-3 text-lg text-brand-muted dark:text-brand-muted-dark">
      In-depth reviews built from real participant race reports and coverage — what a race is actually like to run,
      with every claim linked back to its source.
    </p>

    {reviews.length === 0 ? (
      <p class="mt-10 text-brand-muted dark:text-brand-muted-dark">No reviews published yet — check back soon.</p>
    ) : (
      <div id="reviews-app" class="mt-8">
        <div class="flex flex-col gap-3">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="relative max-w-[420px] flex-1">
              <svg
                class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-brand-faint dark:text-brand-faint-dark"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7" />
                <path d="m21 21-4.35-4.35" />
              </svg>
              <input
                id="reviews-search"
                type="text"
                class="w-full rounded-lg border-[1.5px] border-brand-border bg-brand-surface py-2.5 pl-10 pr-4 text-sm shadow-sm transition-shadow duration-200 ease-interactive placeholder:text-brand-faint focus:border-brand-primary focus:shadow-[0_0_0_4px_theme(colors.brand.primary-highlight)] focus:outline-none dark:border-brand-border-dark dark:bg-brand-surface-dark dark:placeholder:text-brand-faint-dark dark:focus:shadow-[0_0_0_4px_theme(colors.brand.primary-highlight-dark)]"
                placeholder="Search reviews..."
                aria-label="Search reviews"
              />
            </div>
            <div class="flex flex-wrap items-center gap-3">
              {countryRegions.length > 0 && (
                <div class="flex items-center gap-2">
                  <label for="reviews-country" class="text-sm text-brand-muted dark:text-brand-muted-dark">Country</label>
                  <select
                    id="reviews-country"
                    class="rounded-lg border-[1.5px] border-brand-border bg-brand-surface px-3 py-2.5 text-sm shadow-sm transition-shadow duration-200 ease-interactive focus:border-brand-primary focus:shadow-[0_0_0_4px_theme(colors.brand.primary-highlight)] focus:outline-none dark:border-brand-border-dark dark:bg-brand-surface-dark"
                  >
                    <option value="">All countries</option>
                    {countryRegions.map((r) => (
                      <option value={r.value}>{r.label}</option>
                    ))}
                  </select>
                </div>
              )}
              <div class="flex items-center gap-2">
                <label for="reviews-sort" class="text-sm text-brand-muted dark:text-brand-muted-dark">Sort by</label>
                <select
                  id="reviews-sort"
                  class="rounded-lg border-[1.5px] border-brand-border bg-brand-surface px-3 py-2.5 text-sm shadow-sm transition-shadow duration-200 ease-interactive focus:border-brand-primary focus:shadow-[0_0_0_4px_theme(colors.brand.primary-highlight)] focus:outline-none dark:border-brand-border-dark dark:bg-brand-surface-dark"
                >
                  <option value="newest">Newest first</option>
                  <option value="rating-desc">Highest rated</option>
                  <option value="rating-asc">Lowest rated</option>
                </select>
              </div>
            </div>
          </div>

          <p id="reviews-count" class="text-sm text-brand-muted dark:text-brand-muted-dark" aria-live="polite"></p>
        </div>

        <ul id="reviews-list" class="mt-4 divide-y divide-brand-border dark:divide-brand-border-dark">
          {reviews.map((review) => {
            const entity = entityById.get(review.entity_id);
            const facts = entity.core_facts ?? {};
            const loc = [facts.city, facts.country].filter(Boolean).join(', ');
            const concluded = isLapsed(entity);
            const ratingOverall = review.rating?.overall ?? 0;
            const searchHaystack = [review.title, review.dek, loc].filter(Boolean).join(' ').toLowerCase();
            return (
              <li
                data-review-item
                data-country={countryIdForEntity(entity) ?? ''}
                data-rating={ratingOverall}
                data-lapsed={concluded ? 'true' : 'false'}
                data-search={searchHaystack}
                class="py-5"
              >
                <a href={reviewHref(review, entity)} class="group block">
                  <div class="flex flex-wrap items-center gap-2">
                    {isNew(review) && (
                      <span class="rounded-full bg-brand-primary px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-wide text-brand-primary-ink dark:text-brand-primary-ink-dark">
                        New
                      </span>
                    )}
                    {concluded && (
                      <span class="rounded-full bg-brand-surface-offset px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-wide text-brand-muted dark:bg-brand-surface-offset-dark dark:text-brand-muted-dark">
                        Concluded
                      </span>
                    )}
                    {ratingOverall > 0 && (
                      <span class="rounded-full bg-brand-primary/10 px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-wide text-brand-primary dark:text-brand-primary-dark">{ratingOverall}/100</span>
                    )}
                    {fmtDate(review) && (
                      <span class="text-xs text-brand-muted dark:text-brand-muted-dark">{fmtDate(review)}</span>
                    )}
                  </div>
                  <h2 class="mt-1 text-xl font-semibold group-hover:text-brand-primary">{review.title}</h2>
                  <p class="mt-1.5 text-sm text-brand-muted dark:text-brand-muted-dark">{review.dek}</p>
                  {loc && <p class="mt-1.5 text-xs text-brand-muted dark:text-brand-muted-dark">{loc}</p>}
                </a>
              </li>
            );
          })}
        </ul>

        <p id="reviews-empty" class="mt-8 hidden text-brand-muted dark:text-brand-muted-dark">
          No reviews match your filters.
        </p>

        <nav id="reviews-pagination" class="mt-8 hidden items-center justify-center gap-1.5" aria-label="Reviews pagination"></nav>
      </div>
    )}
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var app = document.getElementById('reviews-app');
    if (!app) return;

    var items = Array.prototype.slice.call(app.querySelectorAll('[data-review-item]'));
    var countrySelect = document.getElementById('reviews-country');
    var searchInput = document.getElementById('reviews-search');
    var sortSelect = document.getElementById('reviews-sort');
    var countEl = document.getElementById('reviews-count');
    var emptyEl = document.getElementById('reviews-empty');
    var listEl = document.getElementById('reviews-list');
    var paginationEl = document.getElementById('reviews-pagination');

    var PAGE_SIZE = 24;
    var state = { country: '', query: '', sort: 'newest', page: 1 };

    function load(key, fallback) {
      try {
        var v = localStorage.getItem(key);
        return v === null ? fallback : v;
      } catch (e) {
        return fallback;
      }
    }
    function save(key, value) {
      try {
        localStorage.setItem(key, value);
      } catch (e) {
        /* ignore */
      }
    }

    function matches(item) {
      if (state.country && item.dataset.country !== state.country) return false;
      if (state.query && item.dataset.search.indexOf(state.query) === -1) return false;
      return true;
    }

    function sortItems(list) {
      if (state.sort === 'rating-desc') {
        return list.sort(function (a, b) { return (parseInt(b.dataset.rating) || 0) - (parseInt(a.dataset.rating) || 0); });
      }
      if (state.sort === 'rating-asc') {
        return list.sort(function (a, b) { return (parseInt(a.dataset.rating) || 0) - (parseInt(b.dataset.rating) || 0); });
      }
      // 'newest' — preserve original order (already sorted server-side)
      return list;
    }

    function pageButtons(current, total) {
      var pages = [];
      if (total <= 7) {
        for (var i = 1; i <= total; i++) pages.push(i);
        return pages;
      }
      pages.push(1);
      if (current > 3) pages.push('...');
      for (var p = Math.max(2, current - 1); p <= Math.min(total - 1, current + 1); p++) pages.push(p);
      if (current < total - 2) pages.push('...');
      pages.push(total);
      return pages;
    }

    function renderPagination(total) {
      paginationEl.innerHTML = '';
      if (total <= 1) {
        paginationEl.classList.add('hidden');
        return;
      }
      paginationEl.classList.remove('hidden');
      paginationEl.classList.add('flex');

      function makeBtn(label, page, opts) {
        opts = opts || {};
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = label;
        var base = 'min-w-[2.25rem] rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors';
        if (opts.active) {
          btn.className = base + ' bg-brand-primary text-brand-primary-ink dark:text-brand-primary-ink-dark';
        } else if (opts.disabled) {
          btn.className = base + ' text-brand-faint dark:text-brand-faint-dark cursor-not-allowed';
          btn.disabled = true;
        } else {
          btn.className = base + ' text-brand-muted hover:bg-brand-surface-offset dark:text-brand-muted-dark dark:hover:bg-brand-surface-offset-dark';
          btn.addEventListener('click', function () {
            state.page = page;
            render();
            listEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        }
        return btn;
      }

      paginationEl.appendChild(makeBtn('Prev', state.page - 1, { disabled: state.page <= 1 }));
      pageButtons(state.page, total).forEach(function (p) {
        if (p === '...') {
          var span = document.createElement('span');
          span.textContent = '...';
          span.className = 'px-1.5 text-sm text-brand-faint dark:text-brand-faint-dark';
          paginationEl.appendChild(span);
        } else {
          paginationEl.appendChild(makeBtn(String(p), p, { active: p === state.page }));
        }
      });
      paginationEl.appendChild(makeBtn('Next', state.page + 1, { disabled: state.page >= total }));
    }

    function render() {
      var matched = items.filter(matches);
      matched = sortItems(matched);
      var total = matched.length;
      var totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
      if (state.page > totalPages) state.page = totalPages;
      if (state.page < 1) state.page = 1;

      var start = (state.page - 1) * PAGE_SIZE;
      var end = start + PAGE_SIZE;
      var visibleSet = matched.slice(start, end);

      items.forEach(function (item) {
        item.style.display = visibleSet.indexOf(item) !== -1 ? '' : 'none';
      });

      emptyEl.classList.toggle('hidden', total !== 0);
      countEl.textContent = total === 0
        ? ''
        : total <= PAGE_SIZE
        ? total + (total === 1 ? ' review' : ' reviews')
        : 'Showing ' + (start + 1) + '-' + Math.min(end, total) + ' of ' + total + ' reviews';

      renderPagination(totalPages);
    }

    if (countrySelect) {
      countrySelect.addEventListener('change', function () {
        state.country = countrySelect.value;
        state.page = 1;
        save('reviews-country-filter', state.country);
        render();
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        state.query = searchInput.value.trim().toLowerCase();
        state.page = 1;
        render();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        state.sort = sortSelect.value;
        state.page = 1;
        save('reviews-sort', state.sort);
        render();
      });
    }

    // Restore persisted preferences before first render.
    var savedCountry = load('reviews-country-filter', '');
    if (savedCountry && countrySelect) {
      state.country = savedCountry;
      countrySelect.value = savedCountry;
    }
    var savedSort = load('reviews-sort', 'newest');
    if (savedSort && sortSelect) {
      state.sort = savedSort;
      sortSelect.value = savedSort;
    }

    render();
  })();
</script>
