---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RankTool from '../../components/lab/RankTool.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import { buildBreadcrumbListSchema, buildItemListSchema } from '../../lib/schema-jsonld.js';
import { TOOLS } from '../../lib/tools.js';
import { loadFinishTimes, DISTANCE_LABEL } from '../../lib/finishTimes.js';
import { DISTANCE_SLUG } from '../../lib/labTiers.js';

// Lab: the finish-time ranking tool is the headline ("how do you stack up?"),
// followed by insights computed from every finish we hold and, smaller, the
// other calculators (each still on its own page under /tools/<slug>/).
// Every number below comes from src/lib/finishTimes.js at build time.
const ft = loadFinishTimes();
const ins = ft.insights;
const hasLab = Boolean(siteConfig.enabledFeatures?.finishTimes && ins.Half);

const hm = (s) => (s == null ? '–' : `${Math.floor(s / 3600)}:${String(Math.floor(s / 60) % 60).padStart(2, '0')}`);
const hms = (s) => (s == null ? '–' : s >= 3600 ? `${hm(s)}:${String(s % 60).padStart(2, '0')}` : `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`);
const n = (x) => x.toLocaleString('en-US');
const pct = (x) => `${Math.round(x * 100)}%`;
const place = (c) => (c === 'Philippines' ? 'the Philippines' : c);
const countriesText = ft.allCountries.length > 1 ? `${ft.allCountries.slice(0, -1).map(place).join(', ')} and ${place(ft.allCountries.at(-1))}` : place(ft.allCountries[0] ?? '');

// One insights panel per distance (tabs: half, marathon, 10K), each built the
// same way from ft.insights[k].
const milestoneLabel = { Half: 'two hours', Full: 'four hours', '10K': 'an hour' };
const plural = { Half: 'halves', Full: 'marathons', '10K': '10Ks' };
const decade = (b) => (b === 'U20' ? 'teens' : `${b.slice(0, 2)}s`);
const listWords = (xs) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}` : xs[0] ?? '');
const views = ['Half', 'Full', '10K'].filter((k) => ins[k]).map((k) => {
  const d = ins[k];
  // Clock: h:mm for the half and full, m:ss for the 10K.
  const t = (s) => (s == null ? '–' : k === '10K' ? hms(Math.round(s)) : hm(s));
  const peak = d.bins.reduce((m, b) => (b.n > m.n ? b : m), d.bins[0]);
  const step = d.bins[1].lo - d.bins[0].lo;
  const max = Math.max(...d.bins.map((b) => b.n));
  const under = d.underMilestone;
  const headline = under < 0.5 ? `Only ${pct(under)} break ${milestoneLabel[k]}` : `${pct(under)} finish under ${milestoneLabel[k]}`;
  const ages = d.ages ?? [];
  const vals = ages.flatMap((a) => [a.men, a.women]).filter(Boolean);
  const pad = k === '10K' ? 120 : 300;
  const lo = Math.floor((Math.min(...vals) - pad) / pad) * pad;
  const hi = Math.ceil((Math.max(...vals) + pad) / pad) * pad;
  const fastest = ages.filter((a) => a.men).reduce((m, a) => (a.men < m.men ? a : m), ages.find((a) => a.men) ?? {});
  const fastBands = ages.filter((a) => a.men && a.men - fastest.men <= (k === '10K' ? 30 : 60)).map((a) => decade(a.band));
  const gap = d.women.median - d.men.median;
  return {
    k, d, t, peak, step, max, headline, ages,
    xPos: (s) => `${(((s - lo) / (hi - lo)) * 100).toFixed(1)}%`,
    axis: [t(lo), t(hi)],
    ageHeadline: fastBands.length ? `Runners in their ${listWords(fastBands)} run the fastest ${plural[k]}` : `${DISTANCE_LABEL[k]} times by age`,
    gapText: `${Math.round(Math.abs(gap) / 60)} min`,
    womenFaster: gap < 0,
    label: DISTANCE_LABEL[k],
    lower: k === '10K' ? '10K' : DISTANCE_LABEL[k].toLowerCase(),
  };
});
const totalInsightFinishes = views.reduce((s, v) => s + v.d.finishes, 0);

const breadcrumbItems = [{ label: siteConfig.siteName, href: urls.home() }, { label: 'Lab' }];
const title = hasLab ? 'How do you stack up? Race finish times in Southeast Asia | Lab' : 'Lab -- Free Running Calculators';
const description = hasLab
  ? `Where does your half marathon, marathon or 10K time rank? Compare it with ${n(ft.totalFinishes)} finishes at ${ft.raceCount} races in ${countriesText}, by gender and age. Plus free running calculators.`
  : `Free running calculators from ${siteConfig.siteName}: pace, race time predictor, split charts, race countdown, and calories burned. No sign-up, nothing saved.`;
const jsonLd = [
  buildBreadcrumbListSchema(breadcrumbItems, Astro.site),
  buildItemListSchema(TOOLS, Astro.site, (t) => urls.tool(t.slug), (t) => t.navLabel),
  hasLab && {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Race finish times in Southeast Asia',
    description,
    url: new URL(urls.toolsIndex(), Astro.site).toString(),
    creator: { '@type': 'Organization', name: siteConfig.siteName, url: Astro.site?.toString() },
    spatialCoverage: ft.allCountries.join(', '),
    variableMeasured: 'Finish time (chip time where published), by distance, gender and age group',
    isAccessibleForFree: true,
  },
].filter(Boolean);

const eyebrow = 'text-xs font-extrabold uppercase tracking-[0.08em] text-brand-muted dark:text-brand-muted-dark';
const card = 'rounded-2xl border border-brand-border bg-brand-surface p-5 sm:p-6 dark:border-brand-border-dark dark:bg-brand-surface-dark';
---

<BaseLayout title={title} description={description} canonicalPath={urls.toolsIndex()} jsonLd={jsonLd} ogImage={hasLab ? '/og/lab/lab.png' : null}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />

    {hasLab && (
      <>
        <div class="mt-4 flex flex-wrap items-start gap-8">
          <div class="min-w-0 flex-[1_1_320px]">
            <p class={eyebrow}>Run SEA Lab</p>
            <h1 class="mt-2 font-serif text-4xl font-black leading-[1.05] sm:text-5xl">How do you stack up?</h1>
            <p class="mt-4 text-lg">
              Your race time against {n(ft.totalFinishes)} finishes at {ft.raceCount} races in {countriesText}: across the
              whole region, and against runners of your gender and age.
            </p>
            <p class="mt-3 text-sm text-brand-muted dark:text-brand-muted-dark">Built from each race's official results. We keep finish times only, never names.</p>
            <div class="mt-2"><LastUpdated date={ft.dataUpdated} label="Results data updated" /></div>
          </div>
          <div class="min-w-0 flex-[1.4_1_440px]"><RankTool /></div>
        </div>

        <section class="mt-16" id="insights">
          <p class={eyebrow}>Insights</p>
          <h2 class="mt-1 font-serif text-3xl font-black">What {n(totalInsightFinishes)} race finishes tell us</h2>
          <p class="mt-1 text-brand-muted dark:text-brand-muted-dark">From the latest edition of each race we hold across Southeast Asia. Pick a distance.</p>

          <div class="mt-5 flex flex-wrap gap-2" role="tablist" aria-label="Distance">
            {views.map((v, i) => (
              <button type="button" role="tab" id={`ins-tab-${v.k}`} aria-controls={`ins-${v.k}`} aria-selected={i === 0 ? 'true' : 'false'} data-ins-tab={v.k}
                class="inline-flex min-h-[44px] items-center rounded-full border border-brand-border px-5 text-sm font-bold transition-colors aria-selected:border-brand-text aria-selected:bg-brand-text aria-selected:text-brand-bg dark:border-brand-border-dark dark:aria-selected:border-brand-text-dark dark:aria-selected:bg-brand-text-dark dark:aria-selected:text-brand-bg-dark">
                {v.label}
              </button>
            ))}
          </div>

          {views.map((v, i) => (
            <div id={`ins-${v.k}`} role="tabpanel" aria-labelledby={`ins-tab-${v.k}`} data-ins-panel={v.k} class={i === 0 ? '' : 'hidden'}>
              <p class="mt-5 text-sm text-brand-muted dark:text-brand-muted-dark">{n(v.d.finishes)} {v.lower} finishes at {v.d.races} races.</p>
              <div class="mt-3 flex flex-wrap gap-4">
                <figure class={`min-w-0 flex-[1.6_1_520px] ${card}`}>
                  <p class="font-serif text-xl font-extrabold">{v.headline}</p>
                  <p class="mt-1 text-sm text-brand-muted dark:text-brand-muted-dark">
                    {v.label} finishes by time, in {v.step / 60}-minute bands. The busiest band is {v.t(v.peak.lo)} to {v.t(v.peak.lo + v.step)}.
                  </p>
                  <div class="mt-5 flex h-44 items-end gap-[3px]" role="img" aria-label={`Histogram of ${n(v.d.finishes)} ${v.lower} finish times. ${v.headline}.`}>
                    {v.d.bins.map((b) => (
                      <div class="flex min-w-0 flex-1 flex-col justify-end">
                        <div class={`w-full rounded-t ${b.lo < v.d.milestone ? 'bg-brand-primary' : 'bg-brand-text dark:bg-brand-text-dark'}`} style={`height:${Math.max(2, Math.round((b.n / v.max) * 160))}px`} title={`${v.t(b.lo)}${b.open ? '+' : ''}: ${n(b.n)}`}></div>
                      </div>
                    ))}
                  </div>
                  <div class="mt-1 flex justify-between text-[11px] text-brand-muted dark:text-brand-muted-dark"><span>{v.t(v.d.bins[0].lo)}</span><span>{v.t(v.d.milestone)}</span><span>{v.t(v.d.bins.at(-1).lo)}+</span></div>
                  <p class="mt-3 text-xs text-brand-muted dark:text-brand-muted-dark"><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm bg-brand-primary align-[-1px]"></span>Under {v.k === '10K' ? 'an hour' : milestoneLabel[v.k]}</p>
                </figure>

                <div class="min-w-0 flex-[1_1_300px] rounded-2xl bg-brand-text p-5 text-brand-bg sm:p-6 dark:bg-brand-surface-offset-dark dark:text-brand-text-dark">
                  <p class="font-serif text-xl font-extrabold">What it takes</p>
                  <p class="mt-1 text-sm opacity-80">The {v.lower} time you'd need to finish in the fastest tenth, or the fastest 1 in 100.</p>
                  <table class="mt-4 w-full text-sm tabular-nums">
                    <thead><tr class="text-left text-xs uppercase tracking-wide opacity-70"><th class="py-1 font-semibold"></th><th class="py-1 font-semibold">Men</th><th class="py-1 font-semibold">Women</th></tr></thead>
                    <tbody>
                      <tr class="border-t border-white/15"><td class="py-2">Top 1%</td><td class="py-2 font-bold text-brand-primary">{v.t(v.d.men.top1)}</td><td class="py-2 font-bold text-brand-primary">{v.t(v.d.women.top1)}</td></tr>
                      <tr class="border-t border-white/15"><td class="py-2">Top 10%</td><td class="py-2 font-bold">{v.t(v.d.men.top10)}</td><td class="py-2 font-bold">{v.t(v.d.women.top10)}</td></tr>
                      <tr class="border-t border-white/15"><td class="py-2">Typical</td><td class="py-2">{v.t(v.d.men.median)}</td><td class="py-2">{v.t(v.d.women.median)}</td></tr>
                    </tbody>
                  </table>
                  <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-white/15 pt-4">
                    <div><dt class="text-xs opacity-70">Women in the field</dt><dd class="font-serif text-2xl font-black">{pct(v.d.womenShare)}</dd></div>
                    <div><dt class="text-xs opacity-70">Typical gap, {v.womenFaster ? 'women faster' : 'men faster'}</dt><dd class="font-serif text-2xl font-black">{v.gapText}</dd></div>
                  </dl>
                </div>
              </div>

              {v.ages.length > 0 && (
                <figure class={`mt-4 ${card}`}>
                  <p class="font-serif text-xl font-extrabold">{v.ageHeadline}</p>
                  <p class="mt-1 text-sm text-brand-muted dark:text-brand-muted-dark">
                    Typical {v.lower} time by age. Older runners who still race tend to be the committed ones; younger fields include more first-timers.
                  </p>
                  <div class="mt-4 flex flex-wrap gap-4 text-xs">
                    <span><span class="mr-1.5 inline-block h-3 w-3 rounded-full bg-brand-text align-[-2px] dark:bg-brand-text-dark"></span>Men</span>
                    <span><span class="mr-1.5 inline-block h-3 w-3 rounded-sm bg-brand-success align-[-2px] dark:bg-brand-success-dark"></span>Women</span>
                    <span class="text-brand-muted dark:text-brand-muted-dark">Further left is faster · axis {v.axis[0]} to {v.axis[1]}</span>
                  </div>
                  <div class="mt-4 space-y-2.5" role="img" aria-label={`Typical ${v.lower} time by age group for men and women.`}>
                    {v.ages.map((a) => (
                      <div class="flex items-center gap-3">
                        <span class="w-16 shrink-0 text-sm font-semibold">{a.band === 'U20' ? 'Under 20' : a.band}</span>
                        <div class="relative h-7 min-w-0 flex-1 border-b border-brand-divider dark:border-brand-divider-dark">
                          {a.men && <span class="absolute top-1.5 h-4 w-4 -translate-x-1/2 rounded-full bg-brand-text dark:bg-brand-text-dark" style={`left:${v.xPos(a.men)}`} title={`Men ${v.t(a.men)}`}></span>}
                          {a.women && <span class="absolute top-1.5 h-4 w-4 -translate-x-1/2 rounded bg-brand-success dark:bg-brand-success-dark" style={`left:${v.xPos(a.women)}`} title={`Women ${v.t(a.women)}`}></span>}
                        </div>
                        <span class="w-28 shrink-0 text-right text-xs tabular-nums sm:text-sm">M {v.t(a.men)} · W {v.t(a.women)}</span>
                      </div>
                    ))}
                  </div>
                </figure>
              )}

              <p class="mt-4 text-sm">
                What counts as good?
                {' '}<a href={urls.labRank(DISTANCE_SLUG[v.k], 'strong')} class="link-accent font-semibold">See every {v.lower} tier by age →</a>
              </p>
            </div>
          ))}
        </section>
        <script is:inline>
          // Distance tabs for the insights: every panel is in the page (and
          // indexable); this only toggles which one shows. Plain JS: a script
          // inside an expression is emitted as-is, not compiled.
          (function () {
            var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-ins-tab]'));
            tabs.forEach(function (tab) {
              tab.addEventListener('click', function () {
                tabs.forEach(function (x) { x.setAttribute('aria-selected', String(x === tab)); });
                document.querySelectorAll('[data-ins-panel]').forEach(function (p) {
                  p.classList.toggle('hidden', p.getAttribute('data-ins-panel') !== tab.getAttribute('data-ins-tab'));
                });
              });
            });
          })();
        </script>
      </>
    )}

    {!hasLab && <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Lab</h1>}

    <section class={hasLab ? 'mt-16 border-t border-brand-divider pt-8 dark:border-brand-divider-dark' : 'mt-6'}>
      <h2 class={hasLab ? 'text-base font-bold text-brand-muted dark:text-brand-muted-dark' : 'sr-only'}>More running tools</h2>
      <div class="mt-3 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-4">
        {TOOLS.map((tool) => (
          <a href={urls.tool(tool.slug)} class="flex min-h-[44px] items-center rounded-lg border border-brand-border bg-brand-surface px-4 py-3 text-sm font-semibold hover:border-brand-primary dark:border-brand-border-dark dark:bg-brand-surface-dark">{tool.navLabel}</a>
        ))}
      </div>
    </section>

    {hasLab && (
      <section class="mt-12 max-w-3xl">
        <h2 class="text-lg font-bold">How we measure it</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">
          <li>Times come from each race's official results page, published by the timing company or organiser. We keep only the finish time, distance, gender and age group; we never store names or bib numbers.</li>
          <li>Chip time where the results publish it, otherwise gun time. Standard distances only (10K, half marathon, marathon), and only where at least {ft.rules.MIN_FINISHERS} runners finished that distance at that race.</li>
          <li>The latest edition of each race, as long as it ran in the last two years, so no race counts twice. Events with an entry standard, such as qualifier finals, are left out; open races in the same series stay in. We count finishes, not runners.</li>
          <li>Every race counts towards the region-wide figures. Country-by-country comparisons will follow once we hold at least {ft.rules.MIN_COUNTRY_RACES} races from every country.</li>
          <li>The age-graded score is an approximate estimate from our <a href={urls.tool('age-graded-calculator')} class="link-accent">age-graded calculator</a>, not the official World Masters Athletics tables.</li>
        </ul>
        <p class="mt-4 text-sm text-brand-muted dark:text-brand-muted-dark">
          Journalists and bloggers are welcome to use these figures; please credit {siteConfig.siteName} and link to this page.
          Run a timing company or race and want your results included? <a href={urls.contact()} class="link-accent">Get in touch</a>.
        </p>
      </section>
    )}
  </div>
</BaseLayout>

<script
  is:inline
  define:vars={{
    tools: TOOLS.map((t) => ({ slug: t.slug, legacyHash: t.legacyHash })),
    toolsBase: urls.toolsIndex(),
  }}
>
  // Every tool briefly lived on one JS-tabbed /tools/#hash page before this
  // hub existed -- send anyone arriving with an old #hash straight to that
  // tool's real URL instead of leaving them on the hub.
  (function () {
    var hash = (location.hash || '').replace('#', '');
    if (!hash) return;
    var match = tools.find(function (t) { return t.legacyHash === hash; });
    if (match) location.replace(toolsBase + match.slug + '/');
  })();
</script>
