---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubCard from '../../components/HubCard.astro';
import { buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

// First entry in what's meant to grow into a small set of runner tools.
// Each tool is its own static page under /tools/<slug>/ -- add a card here
// and a page there to add the next one.
const tools = [
  {
    slug: 'pace-calculator',
    label: 'Pace & Finish Time Calculator',
    description: 'Enter any two of distance, time and pace to solve for the third -- plan a goal pace or check a finish time.',
  },
];

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Pace Lab', href: urls.toolsIndex() },
];

const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)].filter(Boolean);
---

<BaseLayout
  title="Pace Lab"
  description={`Free running calculators from ${siteConfig.siteName} -- work out pace, finish time, and more.`}
  canonicalPath={urls.toolsIndex()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Pace Lab</h1>
    <p class="mt-3 max-w-2xl text-brand-muted dark:text-brand-muted-dark">
      Small, fast calculators for race day math -- no sign-up, nothing saved. Starting with pace, growing from here.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => (
        <HubCard href={urls.tool(tool.slug)} label={tool.label} description={tool.description} />
      ))}
    </div>
  </div>
</BaseLayout>
