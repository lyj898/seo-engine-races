---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubCard from '../../components/HubCard.astro';
import { buildBreadcrumbListSchema, buildItemListSchema } from '../../lib/schema-jsonld.js';
import { TOOLS } from '../../lib/tools.js';

// Each calculator now lives on its own real, indexable page (see
// src/pages/tools/*-calculator.astro etc.) instead of one JS-tabbed panel
// set -- this page is the hub that links out to all of them, so it needs
// unique content of its own (this intro copy) rather than just being a
// bare directory listing.
const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Lab' },
];

const jsonLd = [
  buildBreadcrumbListSchema(breadcrumbItems, Astro.site),
  buildItemListSchema(TOOLS, Astro.site, (t) => urls.tool(t.slug), (t) => t.navLabel),
].filter(Boolean);
---

<BaseLayout
  title="Lab -- Free Running Calculators"
  description={`Free running calculators from ${siteConfig.siteName}: pace, race time predictor, split charts, race countdown, and calories burned. No sign-up, nothing saved.`}
  canonicalPath={urls.toolsIndex()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Lab</h1>
    <p class="mt-3 max-w-2xl text-brand-muted dark:text-brand-muted-dark">
      Small, fast running calculators -- no sign-up, nothing saved. Pick a tool below.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {TOOLS.map((tool) => (
        <HubCard href={urls.tool(tool.slug)} label={tool.navLabel} description={tool.hubDescription} />
      ))}
    </div>
  </div>
</BaseLayout>

<script
  is:inline
  define:vars={{
    tools: TOOLS.map((t) => ({ slug: t.slug, legacyHash: t.legacyHash })),
    toolsBase: urls.toolsIndex(),
  }}
>
  // Every tool briefly lived on one JS-tabbed /tools/#hash page before this
  // hub existed -- send anyone arriving with an old #hash straight to that
  // tool's real URL instead of leaving them on the hub.
  (function () {
    var hash = (location.hash || '').replace('#', '');
    if (!hash) return;
    var match = tools.find(function (t) { return t.legacyHash === hash; });
    if (match) location.replace(toolsBase + match.slug + '/');
  })();
</script>
