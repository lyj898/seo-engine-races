---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Pace Lab', href: urls.toolsIndex() },
  { label: 'Pace & Finish Time Calculator', href: urls.tool('pace-calculator') },
];

const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)].filter(Boolean);

const fieldClass =
  'w-full rounded-lg border-[1.5px] border-brand-border bg-brand-bg px-3 py-2.5 text-center text-sm tabular-nums focus:border-brand-primary focus:outline-none disabled:cursor-not-allowed disabled:border-brand-primary disabled:bg-brand-primary-highlight disabled:font-bold disabled:text-brand-primary-ink dark:border-brand-border-dark dark:bg-brand-bg-dark dark:disabled:border-brand-primary-hover dark:disabled:bg-brand-primary-highlight-dark dark:disabled:text-brand-primary-ink-dark';
---

<BaseLayout
  title="Pace & Finish Time Calculator"
  description="Enter any two of distance, time and pace to solve for the third. Free running calculator, no sign-up."
  canonicalPath={urls.tool('pace-calculator')}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-2xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Pace &amp; Finish Time Calculator</h1>
    <p class="mt-3 text-brand-muted dark:text-brand-muted-dark">
      Fill in the two fields you know. The highlighted field fills itself in.
    </p>

    <div id="pace-calc" class="mt-8 rounded-xl border border-brand-border bg-brand-surface p-5 sm:p-6 dark:border-brand-border-dark dark:bg-brand-surface-dark">
      <!-- Solve-for switch -->
      <div class="mb-6">
        <p class="mb-2 text-sm font-semibold">Solve for</p>
        <div class="inline-flex flex-wrap gap-0.5 rounded-full bg-brand-surface-offset p-[3px] dark:bg-brand-surface-offset-dark">
          <button type="button" data-mode="pace" class="mode-chip filter-chip is-active rounded-full px-4 py-2 text-sm font-semibold text-brand-muted transition-colors dark:text-brand-muted-dark">Pace</button>
          <button type="button" data-mode="time" class="mode-chip filter-chip rounded-full px-4 py-2 text-sm font-semibold text-brand-muted transition-colors dark:text-brand-muted-dark">Finish time</button>
          <button type="button" data-mode="distance" class="mode-chip filter-chip rounded-full px-4 py-2 text-sm font-semibold text-brand-muted transition-colors dark:text-brand-muted-dark">Distance</button>
        </div>
      </div>

      <!-- Quick distances -->
      <div class="mb-6 flex flex-wrap gap-2">
        {[
          { label: '5K', km: 5 },
          { label: '10K', km: 10 },
          { label: 'Half', km: 21.0975 },
          { label: 'Full', km: 42.195 },
        ].map((preset) => (
          <button
            type="button"
            class="preset-btn rounded-full border border-brand-border px-3 py-1 text-xs font-semibold text-brand-muted transition-colors hover:border-brand-faint hover:text-brand-text dark:border-brand-border-dark dark:text-brand-muted-dark dark:hover:text-brand-text-dark"
            data-km={preset.km}
          >
            {preset.label}
          </button>
        ))}
      </div>

      <div class="space-y-5">
        <!-- Distance -->
        <div id="group-distance">
          <label class="mb-1.5 block text-sm font-semibold" for="dist-value">Distance</label>
          <div class="flex gap-2">
            <input id="dist-value" type="number" min="0" step="0.001" inputmode="decimal" placeholder="10" class={fieldClass} />
            <select id="dist-unit" class="w-24 shrink-0 rounded-lg border-[1.5px] border-brand-border bg-brand-bg px-2 py-2.5 text-sm focus:border-brand-primary focus:outline-none dark:border-brand-border-dark dark:bg-brand-bg-dark">
              <option value="km">km</option>
              <option value="mi">mi</option>
            </select>
          </div>
        </div>

        <!-- Time -->
        <div id="group-time">
          <label class="mb-1.5 block text-sm font-semibold">Finish time</label>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <input id="time-h" type="number" min="0" inputmode="numeric" placeholder="0" class={fieldClass} />
              <p class="mt-1 text-center text-[11px] text-brand-muted dark:text-brand-muted-dark">hours</p>
            </div>
            <div>
              <input id="time-m" type="number" min="0" max="59" inputmode="numeric" placeholder="50" class={fieldClass} />
              <p class="mt-1 text-center text-[11px] text-brand-muted dark:text-brand-muted-dark">min</p>
            </div>
            <div>
              <input id="time-s" type="number" min="0" max="59" inputmode="numeric" placeholder="00" class={fieldClass} />
              <p class="mt-1 text-center text-[11px] text-brand-muted dark:text-brand-muted-dark">sec</p>
            </div>
          </div>
        </div>

        <!-- Pace -->
        <div id="group-pace">
          <label class="mb-1.5 block text-sm font-semibold">Pace <span id="pace-unit-label" class="font-normal text-brand-muted dark:text-brand-muted-dark">(per km)</span></label>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <input id="pace-m" type="number" min="0" inputmode="numeric" placeholder="5" class={fieldClass} />
              <p class="mt-1 text-center text-[11px] text-brand-muted dark:text-brand-muted-dark">min</p>
            </div>
            <div>
              <input id="pace-s" type="number" min="0" max="59" inputmode="numeric" placeholder="00" class={fieldClass} />
              <p class="mt-1 text-center text-[11px] text-brand-muted dark:text-brand-muted-dark">sec</p>
            </div>
          </div>
        </div>
      </div>

      <p id="pace-calc-hint" class="mt-5 text-sm text-brand-muted dark:text-brand-muted-dark">
        Enter a distance and finish time to see your pace.
      </p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var root = document.getElementById('pace-calc');
    if (!root) return;

    var modeChips = root.querySelectorAll('.mode-chip');
    var distValue = document.getElementById('dist-value');
    var distUnit = document.getElementById('dist-unit');
    var timeH = document.getElementById('time-h');
    var timeM = document.getElementById('time-m');
    var timeS = document.getElementById('time-s');
    var paceM = document.getElementById('pace-m');
    var paceS = document.getElementById('pace-s');
    var paceUnitLabel = document.getElementById('pace-unit-label');
    var hint = document.getElementById('pace-calc-hint');
    var presetBtns = root.querySelectorAll('.preset-btn');

    var groups = {
      distance: [distValue],
      time: [timeH, timeM, timeS],
      pace: [paceM, paceS],
    };

    var mode = 'pace'; // which field group we're solving for

    function num(el) {
      var v = parseFloat(el.value);
      return isNaN(v) || v < 0 ? 0 : v;
    }

    function setGroupDisabled(name, disabled) {
      groups[name].forEach(function (el) {
        el.disabled = disabled;
      });
    }

    function applyMode() {
      modeChips.forEach(function (chip) {
        chip.classList.toggle('is-active', chip.dataset.mode === mode);
      });
      Object.keys(groups).forEach(function (name) {
        setGroupDisabled(name, name === mode);
      });
      recompute();
    }

    function formatPace(totalSeconds) {
      if (!isFinite(totalSeconds) || totalSeconds <= 0) return null;
      var m = Math.floor(totalSeconds / 60);
      var s = Math.round(totalSeconds % 60);
      if (s === 60) { m += 1; s = 0; }
      return { m: m, s: s };
    }

    function formatTime(totalSeconds) {
      if (!isFinite(totalSeconds) || totalSeconds <= 0) return null;
      var h = Math.floor(totalSeconds / 3600);
      var m = Math.floor((totalSeconds % 3600) / 60);
      var s = Math.round(totalSeconds % 60);
      if (s === 60) { s = 0; m += 1; }
      if (m === 60) { m = 0; h += 1; }
      return { h: h, m: m, s: s };
    }

    function recompute() {
      paceUnitLabel.textContent = '(per ' + distUnit.value + ')';

      var distanceVal = num(distValue);
      var timeSeconds = num(timeH) * 3600 + num(timeM) * 60 + num(timeS);
      var paceSeconds = num(paceM) * 60 + num(paceS);

      if (mode === 'pace') {
        if (distanceVal > 0 && timeSeconds > 0) {
          var p = formatPace(timeSeconds / distanceVal);
          if (p) {
            paceM.value = p.m;
            paceS.value = String(p.s).padStart(2, '0');
            hint.textContent = 'That’s a pace of ' + p.m + ':' + String(p.s).padStart(2, '0') + ' per ' + distUnit.value + '.';
            return;
          }
        }
        paceM.value = '';
        paceS.value = '';
        hint.textContent = 'Enter a distance and finish time to see your pace.';
      } else if (mode === 'time') {
        if (distanceVal > 0 && paceSeconds > 0) {
          var t = formatTime(paceSeconds * distanceVal);
          if (t) {
            timeH.value = t.h;
            timeM.value = String(t.m).padStart(2, '0');
            timeS.value = String(t.s).padStart(2, '0');
            hint.textContent = 'Estimated finish time: ' + t.h + ':' + String(t.m).padStart(2, '0') + ':' + String(t.s).padStart(2, '0') + '.';
            return;
          }
        }
        timeH.value = '';
        timeM.value = '';
        timeS.value = '';
        hint.textContent = 'Enter a distance and pace to see your finish time.';
      } else if (mode === 'distance') {
        if (timeSeconds > 0 && paceSeconds > 0) {
          var d = timeSeconds / paceSeconds;
          distValue.value = Math.round(d * 1000) / 1000;
          hint.textContent = 'That covers ' + distValue.value + ' ' + distUnit.value + '.';
          return;
        }
        distValue.value = '';
        hint.textContent = 'Enter a finish time and pace to see the distance.';
      }
    }

    modeChips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        mode = chip.dataset.mode;
        applyMode();
      });
    });

    presetBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        distUnit.value = 'km';
        distValue.value = btn.dataset.km;
        if (mode === 'distance') {
          // A solved-for field shouldn't also be a preset target -- fall
          // back to solving for pace so the preset takes visible effect.
          mode = 'pace';
          applyMode();
        } else {
          recompute();
        }
      });
    });

    root.addEventListener('input', recompute);
    distUnit.addEventListener('change', recompute);

    applyMode();
  })();
</script>
