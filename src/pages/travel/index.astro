---
import { urls } from '../../lib/urls.js';

// /travel/ was the race-travel agency directory. Since Nov 2026 the listings
// render under the article below (its `embed: "travel-agencies"`), so this
// URL redirects there rather than 404ing for links and crawlers that know it.
// Same hand-rolled form as reviews/[slug].astro: a 0-second meta refresh plus
// a canonical and no robots directive, which Google reads as a permanent
// redirect on a static host (Astro.redirect's stub adds a noindex beside the
// canonical, which is what that file explains we avoid).
const ARTICLE_SLUG = 'using-a-race-travel-agency-when-a-package-is-worth-it';
const target = new URL(`${urls.article(ARTICLE_SLUG)}#agencies`, Astro.site).toString();
const canonical = new URL(urls.article(ARTICLE_SLUG), Astro.site).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonical} />
    <title>Redirecting to Using a Race-Travel Agency</title>
  </head>
  <body>
    <p>The race-travel agency listings now live in the article <a href={target}>Using a Race-Travel Agency</a>.</p>
  </body>
</html>
